;;; gui-disk-changes-smoke.el --- External change review in the real layout -*- lexical-binding: t; -*-
;; Run: EMACS_TEST_HOME=$(mktemp -d) Emacs -Q -l tests/gui-disk-changes-smoke.el
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(defvar my-test-notifications 0)
(advice-add 'my-disk-notify :after (lambda (&rest _) (cl-incf my-test-notifications)))

(defun my-test-settle ()
  (dotimes (_ 5) (redisplay t) (accept-process-output nil 0.1)))

(defun my-test-shot (name)
  (my-test-settle)
  (pcase-let ((`(,left ,top ,right ,bottom) (frame-edges nil 'outer-edges)))
    (call-process "screencapture" nil nil nil "-x"
                  (format "-R%d,%d,%d,%d" left top (- right left) (- bottom top))
                  (expand-file-name (concat name ".png") user-emacs-directory))))

(defun my-test-write (file text)
  (with-temp-file file (insert text))
  (set-file-times file (time-add nil (random 1000))))

(defun my-test-layout ()
  (mapcar (lambda (w) (list (buffer-name (window-buffer w)) (window-parameter w 'window-side)))
          (window-list nil 'nomini)))

(defun my-test-header (buffer)
  (with-current-buffer buffer
    (and header-line-format (format-mode-line header-line-format nil nil buffer))))

(defun my-test-notice (buffer modified)
  "Assert BUFFER's rendered notice fits its window and offers every action."
  (let* ((window (get-buffer-window buffer))
         (header (format-mode-line (buffer-local-value 'header-line-format buffer) nil window buffer))
         actions)
    (dotimes (i (length header))
      (when-let* ((action (get-text-property i 'my-disk-action header))) (cl-pushnew action actions)))
    (with-temp-file (expand-file-name "headers" user-emacs-directory) (insert-file-contents (expand-file-name "headers" user-emacs-directory)) (goto-char (point-max))
      (insert (format "%d |%s|\n" (window-width window) (substring-no-properties header))))
    (cl-assert (<= (string-width header) (window-width window)) nil "header %S wider than %d" header (window-width window))
    (cl-assert (<= 80 (window-width window) 110) nil "editor width %d" (window-width window))
    (cl-assert (cl-subsetp '(my-disk-compare my-disk-reload my-disk-keep my-disk-later) actions) nil "actions %S" actions)
    (cl-assert (eq (and modified t) (and (string-match-p "unsaved edits" header) t)))
    (cl-assert (eq (and modified t)
                   (and (string-match-p "Your editor has unsaved changes"
                                        (with-current-buffer buffer (my-disk-message)))
                        t)))))

(defun my-test-run ()
  (let* ((root (expand-file-name "proj/" user-emacs-directory))
         (retry (expand-file-name "retry_handler_with_a_long_descriptive_name.go" root))
         (other (expand-file-name "other.go" root)))
    (make-directory root t)
    (my-test-write retry "package main\n\nfunc retry() {}\n")
    (my-test-write other "package main\n\nfunc other() {}\n")
    (set-frame-size nil 200 50)
    (write-region "" nil (expand-file-name "headers" user-emacs-directory))
    (my-project-open root)
    (find-file other)
    (find-file retry)
    (let ((editor (selected-window)))
      (ignore-errors (treemacs-select-window) (select-window editor))
      (ignore-errors (my-shell-toggle) (select-window editor))
      (ignore-errors (my-pi-toggle) (select-window editor))
      (select-window editor)
      (my-test-settle)
      (let ((layout (my-test-layout))
            (retry-buffer (get-file-buffer retry))
            (other-buffer (get-file-buffer other)))
        (with-temp-file (expand-file-name "layout" user-emacs-directory) (prin1 layout (current-buffer)))
        (cl-assert (seq-find (lambda (l) (cadr l)) layout) nil "side panels open: %S" layout)
        ;; 1. Returning to Emacs detects a clean-buffer change without reloading it.
        (my-test-write retry "package main\n\nfunc retry() { /* agent */ }\n")
        (funcall after-focus-change-function)
        (my-test-settle)
        (my-test-notice retry-buffer nil)
        (cl-assert (string-match-p "func retry() {}" (with-current-buffer retry-buffer (buffer-string))))
        (cl-assert (equal layout (my-test-layout)) nil "layout changed: %S" (my-test-layout))
        (my-test-shot "1-clean-notification")
        ;; 2. Repeated focus and selection events do not notify again.
        (dotimes (_ 3) (funcall after-focus-change-function) (select-window editor) (my-test-settle))
        (cl-assert (= my-test-notifications 1) nil "notified %d times" my-test-notifications)
        ;; 3. Later collapses to the mode-line indicator.
        (my-disk-later)
        (my-test-settle)
        (cl-assert (not (my-test-header retry-buffer)))
        (cl-assert (string-match-p "Changed on disk" (format-mode-line mode-line-format nil editor)))
        (my-test-shot "2-later-indicator")
        ;; 4. Switching file tabs detects a background change in the other file.
        (my-test-write other "package main\n\nfunc other() { /* agent */ }\n")
        (switch-to-buffer other-buffer)
        (my-test-settle)
        (my-test-notice other-buffer nil)
        (switch-to-buffer retry-buffer)
        ;; 5. Project tab activation checks its visible files.
        (with-current-buffer retry-buffer (my-disk-keep))
        (let ((tab (alist-get 'name (tab-bar--current-tab))))
          (my-project-home)
          (my-test-settle)
          (my-test-write retry "package main\n\nfunc retry() { /* second */ }\n")
          (tab-bar-switch-to-tab tab)
          (my-test-settle))
        (setq editor (get-buffer-window retry-buffer))
        (select-window editor)
        (my-test-notice retry-buffer t)
        ;; The menu lists every action, for keyboard (C-c d m) as for mouse.
        (let (menu)
          (cl-letf (((symbol-function 'popup-menu) (lambda (m &rest _) (setq menu m))))
            (execute-kbd-macro (kbd "C-c d m")))
          (cl-assert (equal (mapcar (lambda (item) (aref item 0)) (cdr menu))
                            '("Compare" "Reload from Disk" "Keep Editor Version" "Later"))
                     nil "menu %S" menu))
        (my-test-shot "3-modified-notification")
        ;; 6. Compare shows snapshots; a write during it is noticed; quitting restores the layout.
        (setq layout (my-test-layout))
        (my-disk-compare)
        (my-test-settle)
        (my-test-shot "4-compare")
        (my-test-write retry "package main\n\nfunc retry() { /* third */ }\n")
        (funcall after-focus-change-function)
        (my-disk-check retry-buffer)
        (my-test-settle)
        (my-test-shot "5-compare-outdated")
        (cl-assert (string-match-p "Outdated" (my-test-header (get-buffer (concat "*Disk Version: " (file-name-nondirectory retry) "*")))))
        (with-current-buffer (plist-get (buffer-local-value 'my-disk-compare retry-buffer) :control)
          (ediff-really-quit nil))
        (my-test-settle)
        (cl-assert (equal layout (my-test-layout)) nil "layout after compare: %S vs %S" layout (my-test-layout))
        ;; 7. Reload with unsaved changes asks and keeps a recovery copy.
        (select-window (get-buffer-window retry-buffer))
        (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
          (my-disk-reload))
        (cl-assert (string-match-p "third" (with-current-buffer retry-buffer (buffer-string))))
        (cl-assert (directory-files my-disk-recovery-directory nil (regexp-quote (concat (file-name-nondirectory retry) "."))))
        (cl-assert (equal layout (my-test-layout)))
        (my-test-shot "6-reloaded")))))

(add-hook 'emacs-startup-hook
          (lambda ()
            (run-with-timer
             1 nil
             (lambda ()
               (let ((result (condition-case err (progn (my-test-run) "passed")
                               (error (format "failed: %S" err)))))
                 (with-temp-file (expand-file-name "result" user-emacs-directory) (insert result "\n"))
                 (kill-emacs (if (equal result "passed") 0 1)))))))
