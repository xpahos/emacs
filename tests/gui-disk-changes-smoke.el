;;; gui-disk-changes-smoke.el --- External change review in the real layout -*- lexical-binding: t; -*-
;; Run: EMACS_TEST_HOME=$(mktemp -d) Emacs -Q -l tests/gui-disk-changes-smoke.el
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(defvar my-test-notifications 0)
(advice-add 'my-disk-notify :after (lambda (&rest _) (cl-incf my-test-notifications)))

(defun my-test-settle ()
  (dotimes (_ 5) (redisplay t) (accept-process-output nil 0.1)))

(defun my-test-shot (name)
  (my-test-settle)
  (pcase-let ((`(,left ,top ,right ,bottom) (frame-edges nil 'outer-edges)))
    (call-process "screencapture" nil nil nil "-x"
                  (format "-R%d,%d,%d,%d" left top (- right left) (- bottom top))
                  (expand-file-name (concat name ".png") user-emacs-directory))))

(defun my-test-write (file text)
  (with-temp-file file (insert text))
  (set-file-times file (time-add nil (random 1000))))

(defun my-test-layout ()
  (mapcar (lambda (w) (list (buffer-name (window-buffer w)) (window-parameter w 'window-side)))
          (window-list nil 'nomini)))

(defun my-test-header (buffer)
  (with-current-buffer buffer
    (and header-line-format (format-mode-line header-line-format nil nil buffer))))

(defun my-test-notice (buffer modified)
  "Assert BUFFER's rendered notice fits its window and offers every action."
  (let* ((window (get-buffer-window buffer))
         (header (format-mode-line (buffer-local-value 'header-line-format buffer) nil window buffer))
         (layout (get-text-property 0 'my-disk-panel header))
         (actions (mapcar #'car (plist-get layout :buttons))))
    (cl-assert layout nil "No graphical notification panel")
    (with-temp-file (expand-file-name "headers" user-emacs-directory) (insert-file-contents (expand-file-name "headers" user-emacs-directory)) (goto-char (point-max))
      (insert (format "%d |%S|\n" (window-width window) layout)))
    (cl-assert (<= (plist-get layout :width) (window-pixel-width window)))
    (cl-assert (>= (window-header-line-height window) 120))
    (cl-assert (<= 80 (window-width window) 110) nil "editor width %d" (window-width window))
    (cl-assert (cl-subsetp '(my-disk-compare my-disk-reload my-disk-keep my-disk-later) actions) nil "actions %S" actions)
    (cl-assert (eq (and modified t) (and (string-match-p "Unsaved" (plist-get layout :description)) t)))
    (cl-assert (eq (and modified t)
                   (and (string-match-p "Your editor has unsaved changes"
                                        (with-current-buffer buffer (my-disk-message)))
                        t)))))

(defun my-test-panel-click (window command)
  "Click COMMAND's rendered button in the graphical notification."
  (let* ((header (format-mode-line (buffer-local-value 'header-line-format (window-buffer window))
                                   nil window (window-buffer window)))
         (layout (get-text-property 0 'my-disk-panel header)))
    (pcase-let* ((`(,_ ,_ ,x ,y ,w ,h) (assq command (plist-get layout :buttons)))
                 (posn (posn-at-x-y (+ x (/ w 2))
                                     (+ (window-tab-line-height window) y (/ h 2)) window t)))
      (cl-assert (eq (posn-area posn) 'header-line) nil "Button is not in header: %S" posn)
      (cl-assert (eq command (when-let* ((xy (posn-object-x-y posn)))
                              (my-disk-panel-target layout (car xy) (cdr xy))))
                 nil "Button coordinates: %S" posn)
      (my-disk-panel-click (list 'mouse-1 posn)))))

(defun my-test-run ()
  (let* ((root (expand-file-name "proj/" user-emacs-directory))
         (retry (expand-file-name "retry_handler_with_a_long_descriptive_name.go" root))
         (other (expand-file-name "other.go" root)))
    (make-directory root t)
    (my-test-write retry "package main\n\nfunc retry() {}\n")
    (my-test-write other "package main\n\nfunc other() {}\n")
    (set-frame-size nil 200 50)
    (write-region "" nil (expand-file-name "headers" user-emacs-directory))
    (my-project-open root)
    (find-file other)
    (find-file retry)
    (let ((editor (selected-window)))
      (ignore-errors (treemacs-select-window) (select-window editor))
      (ignore-errors (my-shell-toggle) (select-window editor))
      (ignore-errors (my-pi-toggle) (select-window editor))
      (select-window editor)
      (my-test-settle)
      (let ((layout (my-test-layout))
            (retry-buffer (get-file-buffer retry))
            (other-buffer (get-file-buffer other)))
        (with-temp-file (expand-file-name "layout" user-emacs-directory) (prin1 layout (current-buffer)))
        (cl-assert (seq-find (lambda (l) (cadr l)) layout) nil "side panels open: %S" layout)
        ;; 1. Returning to Emacs detects a clean-buffer change without reloading it.
        (my-test-write retry "package main\n\nfunc retry() { /* agent */ }\n")
        (funcall after-focus-change-function)
        (my-test-settle)
        (my-test-notice retry-buffer nil)
        (cl-assert (string-match-p "func retry() {}" (with-current-buffer retry-buffer (buffer-string))))
        (cl-assert (equal layout (my-test-layout)) nil "layout changed: %S" (my-test-layout))
        (my-test-shot "1-clean-notification")
        ;; 2. Repeated focus and selection events do not notify again.
        (dotimes (_ 3) (funcall after-focus-change-function) (select-window editor) (my-test-settle))
        (cl-assert (= my-test-notifications 1) nil "notified %d times" my-test-notifications)
        ;; 3. Later hides the notice without leaving a mode-line badge.
        (my-test-panel-click editor 'my-disk-later)
        (my-test-settle)
        (cl-assert (not (my-test-header retry-buffer)))
        (cl-assert (not (string-match-p "Changed on disk" (format-mode-line mode-line-format nil editor))))
        (my-test-shot "2-later-hidden")
        ;; 4. Switching file tabs detects a background change in the other file.
        (my-test-write other "package main\n\nfunc other() { /* agent */ }\n")
        (switch-to-buffer other-buffer)
        (my-test-settle)
        (my-test-notice other-buffer nil)
        (switch-to-buffer retry-buffer)
        ;; 5. Project tab activation checks its visible files.
        (with-current-buffer retry-buffer (my-disk-keep))
        (let ((tab (alist-get 'name (tab-bar--current-tab))))
          (my-project-home)
          (my-test-settle)
          (my-test-write retry "package main\n\nfunc retry() { /* second */ }\n")
          (tab-bar-switch-to-tab tab)
          (my-test-settle))
        (setq editor (get-buffer-window retry-buffer))
        (select-window editor)
        (my-test-notice retry-buffer t)
        ;; The menu lists every action, for keyboard (C-c d m) as for mouse.
        (let (menu)
          (cl-letf (((symbol-function 'popup-menu) (lambda (m &rest _) (setq menu m))))
            (execute-kbd-macro (kbd "C-c d m")))
          (cl-assert (equal (mapcar (lambda (item) (aref item 0)) (cdr menu))
                            '("Compare" "Reload from Disk" "Keep Editor Version" "Later"))
                     nil "menu %S" menu))
        (my-test-shot "3-modified-notification")
        ;; 6. Compare shows snapshots; a write during it is noticed; quitting restores the layout.
        (setq layout (my-test-layout))
        (my-test-panel-click editor 'my-disk-compare)
        (my-test-settle)
        (my-test-shot "4-compare")
        (my-test-write retry "package main\n\nfunc retry() { /* third */ }\n")
        (funcall after-focus-change-function)
        (my-disk-check retry-buffer)
        (my-test-settle)
        (my-test-shot "5-compare-outdated")
        (cl-assert (string-match-p "Outdated" (my-test-header (get-buffer (concat "*Disk Version: " (file-name-nondirectory retry) "*")))))
        (with-current-buffer (plist-get (buffer-local-value 'my-disk-compare retry-buffer) :control)
          (ediff-really-quit nil))
        (my-test-settle)
        (cl-assert (equal layout (my-test-layout)) nil "layout after compare: %S vs %S" layout (my-test-layout))
        ;; 7. Reload with unsaved changes asks and keeps a recovery copy.
        (select-window (get-buffer-window retry-buffer))
        (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
          (my-disk-reload))
        (cl-assert (string-match-p "third" (with-current-buffer retry-buffer (buffer-string))))
        (cl-assert (directory-files my-disk-recovery-directory nil (regexp-quote (concat (file-name-nondirectory retry) "."))))
        (cl-assert (equal layout (my-test-layout)))
        (my-test-shot "6-reloaded")
        (my-test-comparison root layout)))))

(defun my-test-lines (from to)
  (mapconcat (lambda (n) (format "\tcommon(%d)\n" n)) (number-sequence from to) ""))

(defun my-test-y (window text)
  "Pixel row of the visible line TEXT in WINDOW, or nil."
  (with-current-buffer (window-buffer window)
    (save-excursion
      (goto-char (point-min))
      (re-search-forward (concat "^" (regexp-quote text) "$"))
      (cadr (pos-visible-in-window-p (line-beginning-position) window t)))))

(defun my-test-aligned (a b)
  "Assert every common line visible in both panes is drawn at the same height."
  (let ((checked 0))
    (dolist (n (number-sequence 1 120))
      (let ((ya (my-test-y a (format "\tcommon(%d)" n))) (yb (my-test-y b (format "\tcommon(%d)" n))))
        (when (and ya yb)
          (cl-incf checked)
          (cl-assert (= ya yb) nil "common(%d) at %s vs %s" n ya yb))))
    (cl-assert (> checked 5) nil "only %d common lines visible" checked)
    (cl-assert (= (my-disk-top a) (my-disk-top b)) nil "tops %s %s" (my-disk-top a) (my-disk-top b))))

(defun my-test-header-click (window predicate)
  "Click the first header-line character of WINDOW satisfying PREDICATE."
  (let* ((header (format-mode-line header-line-format nil window))
         (column (cl-position-if (lambda (i) (funcall predicate header i)) (number-sequence 0 (1- (length header)))))
         (x (* column (frame-char-width)))
         (posn (posn-at-x-y (+ x 2) 2 window t)))
    (cl-assert (eq (posn-area posn) 'header-line) nil "posn %S" posn)
    (let ((command (lookup-key (get-text-property (cdr (posn-string posn)) 'local-map (car (posn-string posn)))
                               [header-line mouse-1])))
      (setq last-nonmenu-event (list 'mouse-1 posn))
      (funcall command (list 'mouse-1 posn)))))

(defun my-test-comparison (root layout)
  (let* ((file (expand-file-name "fixture.go" root))
         (long (concat "\tcommon_long := \"" (make-string 260 ?x) "\""))
         (editor (concat "editor_only_top()\n" (my-test-lines 1 20) "\told_middle()\n" (my-test-lines 21 50)
                         "\teditor_only_a()\n\teditor_only_b()\n" (my-test-lines 51 80) long "\n" (my-test-lines 81 120)))
         (disk (concat (my-test-lines 1 20) "\tnew_middle(1)\n\tnew_middle(2)\n\tnew_middle(3)\n" (my-test-lines 21 50)
                       (my-test-lines 51 65) "\tdisk_only()\n" (my-test-lines 66 80) long "\n" (my-test-lines 81 120)
                       "\tdisk_only_end(1)\n\tdisk_only_end(2)\n"))
         buffer)
    (my-test-write file editor)
    (select-window (get-buffer-window (get-file-buffer (expand-file-name "retry_handler_with_a_long_descriptive_name.go" root))))
    (find-file file)
    (setq buffer (current-buffer))
    (goto-char (point-max))
    (insert "// unsaved\n")
    (my-test-write file disk)
    (funcall after-focus-change-function)
    (my-test-settle)
    (my-test-notice buffer t)
    (my-test-shot "7-fixture-notification")
    (let ((text (buffer-string)) (mtime (file-attribute-modification-time (file-attributes file))))
      (setq layout (my-test-layout))
      (my-disk-compare)
      (my-test-settle)
      (let* ((control (plist-get (buffer-local-value 'my-disk-compare buffer) :control))
             (a (buffer-local-value 'ediff-window-A control))
             (b (buffer-local-value 'ediff-window-B control))
             (cw (buffer-local-value 'ediff-control-window control)))
        (my-test-aligned a b)
        (my-test-shot "8-compare-aligned")
        ;; Keyboard paging in the editor pane.
        (with-selected-window a (scroll-up 20))
        (my-test-settle)
        (my-test-aligned a b)
        (my-test-shot "9-scrolled-editor-pane")
        ;; Mouse wheel over the disk pane, the editor pane following.
        (let ((selected (selected-window)))
          (dotimes (_ 6)
            (mwheel-scroll (list 'wheel-down (posn-at-point (window-start b) b) 1)))
          (my-test-settle)
          (cl-assert (eq selected (selected-window)) nil "focus moved to %S" (selected-window))
          (my-test-aligned a b))
        ;; Moving point below the view: redisplay scrolls, the other pane follows.
        (with-selected-window b
          (goto-char (window-end b t)) (forward-line 3))
        (my-test-settle)
        (my-test-aligned a b)
        (my-test-shot "10-wheel-and-keyboard")
        ;; Next from the header button: counter, selection and alignment.
        (with-current-buffer control (ediff-jump-to-difference 1))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control)
              cw (buffer-local-value 'ediff-control-window control))
        (my-test-header-click cw (lambda (h i) (string-prefix-p "[Next" (substring h i))))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control)
              cw (buffer-local-value 'ediff-control-window control))
        (cl-assert (= 1 (buffer-local-value 'ediff-current-difference control)))
        (cl-assert (string-match-p "Change 2 of 5" (format-mode-line (buffer-local-value 'header-line-format control) nil cw)))
        (my-test-aligned a b)
        (cl-assert (my-test-y a "\told_middle()"))
        (cl-assert (my-test-y b "\tnew_middle(2)"))
        (my-test-shot "11-next-change-2-of-5")
        (my-test-header-click cw (lambda (h i) (string-prefix-p "[◀ Previous" (substring h i))))
        (my-test-settle)
        (cl-assert (= 0 (buffer-local-value 'ediff-current-difference control)) nil "after Previous: %S %S"
                   (buffer-local-value 'ediff-current-difference control)
                   (format-mode-line (buffer-local-value 'header-line-format control) nil (buffer-local-value 'ediff-control-window control)))
        ;; An overview marker selects its change in both panes.
        (setq cw (buffer-local-value 'ediff-control-window control))
        (my-test-header-click cw (lambda (h i) (eql 3 (cdr (get-text-property i 'my-disk-cell h)))))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control)
              cw (buffer-local-value 'ediff-control-window control))
        (cl-assert (= 3 (buffer-local-value 'ediff-current-difference control)))
        (cl-assert (my-test-y b "\tdisk_only()"))
        (my-test-aligned a b)
        (my-test-shot "12-overview-click-change-4")
        ;; Clicking a change in the editor pane selects it and its counterpart; focus stays there.
        (let ((posn (let ((pos (with-current-buffer (window-buffer a)
                                 (save-excursion (goto-char (point-min)) (search-forward "editor_only") (point)))))
                      (set-window-point a pos)
                      (with-selected-window a (recenter))
                      (my-test-settle)
                      (posn-at-point pos a))))
          (select-window a)
          (my-disk-select-click (list 'mouse-1 posn)))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control)
              cw (buffer-local-value 'ediff-control-window control))
        (cl-assert (= 0 (buffer-local-value 'ediff-current-difference control)))
        (cl-assert (eq (window-buffer (selected-window)) (window-buffer a)) nil "selected %S" (selected-window))
        (my-test-aligned a b)
        (my-test-shot "13-click-in-pane-change-1")
        ;; Resizing keeps the panes aligned and the controls inside the window.
        (set-frame-size nil 170 44)
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control)
              cw (buffer-local-value 'ediff-control-window control))
        (with-selected-window a (scroll-up 30))
        (my-test-settle)
        (my-test-aligned a b)
        (let ((header (format-mode-line (buffer-local-value 'header-line-format control) nil cw)))
          (cl-assert (<= (string-width header) (window-width cw)) nil "overview %d > %d" (string-width header) (window-width cw))
          (cl-assert (string-match-p "\\[Next ▶\\]" header)))
        (my-test-shot "14-resized")
        (set-frame-size nil 200 50)
        (my-test-settle)
        (with-current-buffer control (ediff-really-quit nil))
        (my-test-settle)
        (cl-assert (equal layout (my-test-layout)) nil "layout after compare: %S vs %S" layout (my-test-layout))
        (cl-assert (not (seq-some (lambda (b) (buffer-local-value 'my-disk-control b)) (buffer-list))))
        (cl-assert (not (get-buffer "*Disk Version: fixture.go*")))
        (cl-assert (equal text (with-current-buffer buffer (buffer-string))))
        (cl-assert (equal disk (with-temp-buffer (insert-file-contents file) (buffer-string))))
        (cl-assert (equal mtime (file-attribute-modification-time (file-attributes file))))
        (my-test-shot "15-closed")))))

(add-hook 'emacs-startup-hook
          (lambda ()
            (run-with-timer
             1 nil
             (lambda ()
               (let ((result (condition-case err (progn (my-test-run) "passed")
                               (error (format "failed: %S" err)))))
                 (with-temp-file (expand-file-name "result" user-emacs-directory) (insert result "\n"))
                 (kill-emacs (if (equal result "passed") 0 1)))))))
