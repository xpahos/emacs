;;; gui-markdown-smoke.el --- Native preview in project tabs -*- lexical-binding: t; -*-
(setq user-emacs-directory (file-name-as-directory (getenv "EMACS_TEST_HOME")))
(require 'eglot)
(load (expand-file-name "init.el" (or (getenv "EMACS_TEST_CONFIG")
                                     (expand-file-name ".." (file-name-directory load-file-name)))) nil t)
(require 'ert)

(defun my-test-markdown-scroll-panels ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (dotimes (i 15)
        (insert (format "## Section %d\n\nParagraph before code.\n\n```\nshort\n%s\n```\n\nAfter code.\n\n"
                        i (make-string 160 ?x))))
      (my-markdown-open)
      (goto-char (point-min))
      (set-window-start nil (point-min))
      (redisplay t)
      (dolist (direction '(down up))
        (catch 'boundary
          (dotimes (_ 1000)
            (let ((start (window-start)))
              (condition-case nil
                  (if (eq direction 'down) (scroll-up 1) (scroll-down 1))
                (end-of-buffer
                 (should (eq direction 'down))
                 (should (>= (window-end nil t) (point-max)))
                 (throw 'boundary t))
                (beginning-of-buffer
                 (should (eq direction 'up))
                 (should (< (window-start) 10))
                 (throw 'boundary t)))
              (redisplay t)
              (should (if (eq direction 'down)
                          (> (window-start) start)
                        (< (window-start) start)))))
          (ert-fail "Scrolling did not reach the document boundary"))))))

(defun my-test-markdown-wrapped-panel ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "```\n"
              (mapconcat #'identity (make-list (/ (window-width) 12) "слово") " ")
              " конец\nshort\n```\n\n```\ntiny\n```\n")
      (my-markdown-open)
      (goto-char (point-min))
      (forward-line 1)
      (let* ((start (point))
             (end (line-end-position))
             (wide (selected-window))
             (narrow (split-window wide (/ (* 3 (window-total-width)) 4) t)))
        (sit-for 0.2)
        (should (eq (get-char-property end 'face wide) 'default))
        (should (plist-get (get-char-property end 'face narrow) :extend))
        (should (> (cdr (posn-x-y (posn-at-point (1- end) narrow)))
                   (cdr (posn-x-y (posn-at-point start narrow)))))
        (delete-window wide)
        (sit-for 0.2)
        (should (eq (get-char-property end 'face narrow) 'default))))))

(defun my-test-markdown-gui ()
  (condition-case err
      (let* ((root (expand-file-name "project/" user-emacs-directory))
             (file (expand-file-name "example.md" root)))
        (my-test-markdown-wrapped-panel)
        (my-test-markdown-scroll-panels)
        (make-directory root t)
        (with-temp-file (expand-file-name "image.svg" root)
          (insert "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"160\" height=\"60\"><rect width=\"160\" height=\"60\" fill=\"#642d3b\"/></svg>"))
        (with-temp-file file
          (insert "# Markdown preview\n\nПривет **мир** — [relative link](other.md).\n\n- One\n- [x] Done\n\n| A | B |\n|---|---|\n| 1 | 2 |\n\n```elisp\n(message \"Hello\")\n```\n\n![Image](image.svg)\n"))
        (with-temp-file (expand-file-name "other.md" root) (insert "# Other\n"))
        (my-project-open root)
        (find-file file)
        (let ((buffer (current-buffer)) (window (selected-window)))
          (font-lock-ensure)
          (redisplay t)
          (should (eq major-mode 'markdown-ts-view-mode))
          (should tab-line-mode)
          (should (memq buffer (my-project-file-tabs)))
          (should (string-match-p "Preview" (format-mode-line header-line-format)))
          (let* ((block (seq-find (lambda (ov) (overlay-get ov 'markdown-ts-code-block))
                                  (overlays-in (point-min) (point-max))))
                 (caps (seq-filter (lambda (ov) (overlay-get ov 'my-markdown-code-cap))
                                   (overlays-in (point-min) (point-max))))
                 (cap (overlay-get (car caps) 'before-string))
                 (width (+ (car (plist-get (cdr (get-text-property 0 'display cap)) :width))
                           (car (plist-get (cdr (get-text-property 1 'display cap)) :width))))
                 (size (window-text-pixel-size window (overlay-start block) (overlay-end block)
                                               t nil nil t))
                 (gutter (line-number-display-width t)))
            (should (< (car size) (- (window-body-width window t) 50)))
            (should (<= (- width 2) (- (car size) gutter) (+ width 2)))
            (let ((padded-height (cdr (window-text-pixel-size window))))
              (mapc #'delete-overlay caps)
              (redisplay t)
              (should (>= (- padded-height (cdr (window-text-pixel-size window))) 10))
              (my-markdown-style-code-panels)))
          (should (seq-some (lambda (ov)
                              (let ((image (overlay-get ov 'after-string)))
                                (and image (> (length image) 0)
                                     (eq (car-safe (get-text-property (1- (length image)) 'display image)) 'image))))
                            (overlays-in (point-min) (point-max))))
          (goto-char (point-min))
          (search-forward "relative link")
          (backward-char)
          (let ((keymap (get-text-property (point) 'keymap)))
            (should keymap)
            (call-interactively (lookup-key keymap (kbd "RET"))))
          (should (equal buffer-file-name (expand-file-name "other.md" root)))
          (switch-to-buffer buffer)
          (execute-kbd-macro (kbd "C-c C-x C-m"))
          (should (eq major-mode 'markdown-ts-mode))
          (should-not buffer-read-only)
          (should tab-line-mode)
          (goto-char (point-max))
          (insert "Unsaved\n")
          (let* ((label (nth 1 header-line-format))
                 (map (get-text-property 0 'local-map label)))
            (funcall (lookup-key map [header-line mouse-1])
                     (list 'mouse-1 (list window 'header-line '(30 . 5) 0))))
          (should (eq major-mode 'markdown-ts-view-mode))
          (should (buffer-modified-p))
          (should (eq (selected-window) window))
          (should (eq (window-buffer window) buffer))
          (tabspaces-save-session)
          (should tab-line-mode)
          (should (memq buffer (my-project-file-tabs)))
          (save-buffer)
          (tab-bar-close-tab)
          (my-project-open root)
          (should (get-file-buffer file))
          (with-current-buffer (get-file-buffer file)
            (should (eq major-mode 'markdown-ts-view-mode))
            (should (string-suffix-p "Unsaved\n" (buffer-substring-no-properties (point-min) (point-max))))))
        (with-temp-file (expand-file-name "passed" user-emacs-directory)
          (insert "Markdown GUI: scrolling both ways, wrapping/resizing, preview, image, relative link, keyboard/header switching, file tabs and project reopen passed.\n"))
        (kill-emacs 0))
    (error
     (with-temp-file (expand-file-name "failure" user-emacs-directory) (prin1 err (current-buffer)))
     (with-temp-file (expand-file-name "messages" user-emacs-directory) (insert-buffer-substring "*Messages*"))
     (kill-emacs 1))))

(add-hook 'emacs-startup-hook
          (lambda () (run-with-timer 1 nil #'my-test-markdown-gui)))
