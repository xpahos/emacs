;;; gui-pi-history-smoke.el --- Real transport and picker checks -*- lexical-binding: t; -*-
(load (expand-file-name "gui-pi-panel-smoke.el" (file-name-directory load-file-name)) nil t)
(load (expand-file-name "pi-history-fixtures.el" (file-name-directory load-file-name)) nil t)
(defun pi-gui-wait (predicate)
  (let ((deadline (+ (float-time) 25)))
    (while (and (not (funcall predicate)) (< (float-time) deadline)) (accept-process-output nil 0.05))
    (should (funcall predicate))))
(defun my-test-history-extra (root first)
  (let* ((id (agent-shell-session-id :shell-buffer first))
         (second (my-pi-new-chat root)))
    (pi-gui-wait (lambda () (agent-shell-initialized-p :shell-buffer second)))
    (should-not (eq first second))
    (should-not (equal id (agent-shell-session-id :shell-buffer second)))
    (should (my-pi-live-p first))
    (my-pi-open-chat root id)
    (should (eq (window-buffer) first))
    (should (my-pi-live-p second))
    (let* ((profile (my-pi-history-profile))
           (dir (plist-get profile :sessions))
           (file (expand-file-name "history-fixture.jsonl" dir))
           (history-id "11111111-2222-4333-8444-555555555555"))
      (make-directory dir t)
      (make-directory (expand-file-name "original/" root) t)
      (pi-test-jsonl file
       (list `((type . "session") (version . 3) (id . "22222222-2222-4333-8444-555555555555")
               (cwd . ,(expand-file-name "original/" root))
               (timestamp . "2026-11-16T10:00:00Z"))
             (pi-test-message "u1" nil "user" "Find PCI device")
             (pi-test-message "a1" "u1" "assistant" "PCI response unique CLOUD-298453")
             (pi-test-message "u2" "a1" "user" "Find PCI device")
             (pi-test-message "a2" "u2" "assistant" "PCI response unique CLOUD-298453")))
      (let* ((map (plist-get profile :map)) (data (my-pi-history-read-json map)))
        (setf (alist-get (intern history-id) (alist-get 'sessions data))
              `((sessionId . ,history-id) (cwd . ,root) (sessionFile . ,file)))
        (with-temp-file map (insert (decode-coding-string (json-serialize data) 'utf-8))))
      (let (done)
        (my-pi-history-refresh root (lambda () (setq done t)))
        (pi-gui-wait (lambda () done)))
      (should (my-pi-history-get history-id))
      (let ((windows (cl-remove-if (lambda (w) (eq (window-parameter w 'window-side) 'left))
                                   (window-list))))
        (my-pi-history-show root)
        (should (frame-live-p my-pi-history-frame))
        (should (equal (frame-parameter my-pi-history-frame 'parent-frame) (window-frame (car windows))))
        (should (frame-parameter my-pi-history-frame 'drag-internal-border))
        (should (frame-parameter my-pi-history-frame 'drag-with-header-line))
        (should (eq (lookup-key (current-local-map) [header-line down-mouse-1]) #'mouse-drag-header-line))
        (should (= (frame-parameter my-pi-history-frame 'tab-bar-lines) 0))
        (should (= (line-number-at-pos) 2))
        (should (eq (get-text-property (point) 'face) 'my-pi-search-field))
        (should (face-attribute 'my-pi-search-field :box))
        (insert "CLOUD-29")
        (let ((picker my-pi-history-frame) (buffer (current-buffer)))
          (tabspaces-save-session)
          (should (frame-live-p picker))
          (should (eq (selected-frame) picker))
          (should (eq (current-buffer) buffer))
          (should (equal my-pi-picker-query "CLOUD-29")))
        (pi-gui-wait (lambda () (and (equal my-pi-picker-query "CLOUD-29") (plist-get (car my-pi-picker-results) :matches))))
        (goto-char my-pi-picker-input-start)
        (insert "x")
        (delete-char -1)
        (should (equal my-pi-picker-query "CLOUD-29"))
        (should-error (delete-char -1))
        (my-pi-picker-focus-search)
        (should (= (point) my-pi-picker-input-end))
        (should (= (length my-pi-picker-results) 1))
        (should (equal (plist-get (car my-pi-picker-results) :id) history-id))
        (set-frame-size my-pi-history-frame (+ 100 (window-pixel-width my-pi-picker-window)) 300 t)
        (set-frame-position my-pi-history-frame 40 60)
        (my-pi-picker-constrain my-pi-history-frame)
        (should (> (frame-pixel-width my-pi-history-frame) (window-pixel-width my-pi-picker-window)))
        (let ((parent (window-frame my-pi-picker-window)))
          (should (equal (frame-position my-pi-history-frame) '(40 . 60)))
          (window-resize my-pi-picker-window -4 t)
          (my-pi-picker-constrain parent)
          (should (equal (frame-position my-pi-history-frame) '(40 . 60)))
          (window-resize my-pi-picker-window 4 t)
          (set-frame-position my-pi-history-frame (frame-pixel-width parent) (frame-pixel-height parent))
          (my-pi-picker-constrain parent)
          (let ((position (frame-position my-pi-history-frame)))
            (should (<= (+ (car position) (frame-pixel-width my-pi-history-frame)) (frame-pixel-width parent)))
            (should (<= (+ (cdr position) (frame-pixel-height my-pi-history-frame)) (frame-pixel-height parent)))))
        (set-frame-position my-pi-history-frame 40 60)
        (let ((size (cons (frame-pixel-width my-pi-history-frame) (frame-pixel-height my-pi-history-frame))))
          (my-pi-history-close)
          (sqlite-close my-pi-history-db)
          (setq my-pi-history-db nil)
          (my-pi-history-show root)
          (should (equal (frame-position my-pi-history-frame) '(40 . 60)))
          (should (equal size (cons (frame-pixel-width my-pi-history-frame) (frame-pixel-height my-pi-history-frame))))
          (my-pi-history-close))
        ;; Treemacs recreates its own window while Tabspaces saves the tabs.
        (should (equal windows (cl-remove-if (lambda (w) (eq (window-parameter w 'window-side) 'left))
                                             (window-list))))
        (should (equal (window-buffer) first)))
      (let ((restored (my-pi-open-chat root history-id "a2")))
        (pi-gui-wait (lambda () (and (agent-shell-initialized-p :shell-buffer restored)
                                    (with-current-buffer restored (not my-pi-jump-message)))))
        (should (my-pi-live-p first)) (should (my-pi-live-p second))
        (should (with-current-buffer restored (string-match-p "PCI response unique" (buffer-string))))
        (with-current-buffer restored
          (my-pi-goto-message "a2")
          (let ((last (point)))
            (my-pi-goto-message "a1")
            (should (< (point) last)))
          (let ((db (my-pi-history-open)))
            (sqlite-execute db "DELETE FROM messages WHERE session_id=? AND message_id IN ('u1','a1')" (list history-id))
            (goto-char (point-max))
            (let ((before (point))) (my-pi-goto-message "a2") (should (= before (point))))))
        (my-pi-open-chat root id)
        (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
          (my-pi-history-confirm-delete root (list history-id)))
        (should (file-exists-p file))
        (my-pi-history-delete root (list history-id))
        (pi-gui-wait (lambda () (not (my-pi-history-get history-id))))
        (should-not (file-exists-p file))
        (should (my-pi-live-p first)) (should (my-pi-live-p second))
        (let ((unrelated (cl-remove-if (lambda (b) (equal (my-pi-history-root root) (buffer-local-value 'my-pi-root b)))
                                      (agent-shell-buffers))))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (my-pi-history-confirm-delete root (mapcar (lambda (c) (plist-get c :id)) (my-pi-history-list root)) t))
          (pi-gui-wait (lambda () (not (my-pi-history-list root))))
          (dolist (b unrelated) (should (my-pi-live-p b)))
          (should (with-current-buffer (window-buffer (selected-window)) (string-match-p "No chats yet" (buffer-string)))))))))
