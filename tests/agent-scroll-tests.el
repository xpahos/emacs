;;; agent-scroll-tests.el --- Chat label scrolling regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'package)
(let ((package-user-dir
       (expand-file-name "../elpa" (file-name-directory load-file-name))))
  (package-initialize))
(require 'agent-shell)

(defun my-agent-scroll-fixture (restored)
  "Insert a response whose marker follows input when RESTORED is non-nil."
  (comint-mode)
  (visual-line-mode 1)
  (setq-local agent-shell-chat-mode t)
  (insert (propertize "Pi> " 'font-lock-face 'comint-highlight-prompt 'field 'output)
          "Question" (if restored "" "\n")
          (propertize "<shell-maker-end-of-prompt>" 'shell-maker--marker t 'invisible t)
          "\n\n")
  (dotimes (i 100) (insert (format "Response line %d\n" i)))
  (save-excursion
    (goto-char (point-min))
    (search-forward "<shell-maker-end-of-prompt>")
    (put-text-property (match-beginning 0) (point-max) 'field 'output))
  (agent-shell-chat--label-responses))

(ert-deftest my-agent-scroll-response-label-has-addressable-rows ()
  (dolist (restored '(nil t))
    (with-temp-buffer
      (my-agent-scroll-fixture restored)
      (let ((text (buffer-string))
            (rendered (agent-shell-chat--displayed-substring (point-min) (point-max))))
        (should (string-prefix-p "Pi> Question\n\n Agent \n\nResponse line 0\n" rendered))
        (dotimes (_ 2)
          (agent-shell-chat--label-responses)
          (should (equal text (buffer-string)))
          (should (equal rendered (agent-shell-chat--displayed-substring (point-min) (point-max)))))
        (dolist (ov (overlays-in (point-min) (point-max)))
          (dolist (prop '(before-string display))
            (let ((value (overlay-get ov prop)))
              (when (stringp value)
                (should (<= (cl-count ?\n value) 1))))))))))

(ert-deftest my-agent-scroll-wheel-crosses-restored-label ()
  (skip-unless (display-graphic-p))
  (dolist (restored '(nil t))
    (let ((frame (make-frame '((width . 80) (height . 25))))
          (buffer (generate-new-buffer " *agent scroll test*")))
      (unwind-protect
          (with-selected-frame frame
            (switch-to-buffer buffer)
            (my-agent-scroll-fixture restored)
            (goto-char (point-min))
            (insert (make-string 30 ?\n))
            (agent-shell-chat--relabel)
            (goto-char (point-min))
            (forward-line 28)
            (set-window-start nil (point))
            (redisplay t)
            (let ((mouse-wheel-progressive-speed nil)
                  (target (selected-window)))
              (select-window (split-window-right))
              (switch-to-buffer (get-buffer-create "*scratch*"))
              (dolist (direction '(wheel-down wheel-up))
		(dotimes (_ 14)
                  (let ((start (window-start target)))
                    (mwheel-scroll (list direction (posn-at-x-y 20 20 target) 1))
                    (redisplay t)
                    (sit-for 0.02)
                    (ert-info ((format "%s step %s: %s -> %s, vscroll %s"
                                       direction _ start (window-start target)
                                       (window-vscroll target t)))
                      (should (if (eq direction 'wheel-down)
                                  (> (window-start target) start)
				(< (window-start target) start)))))))))
	(delete-frame frame)
	(kill-buffer buffer)))))
