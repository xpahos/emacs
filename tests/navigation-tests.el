;;; navigation-tests.el --- Command-hover checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(setq user-emacs-directory (make-temp-file "emacs-hover-tests-" t))
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(ert-deftest my-navigation-hover-tracks-command-without-moving-point ()
  (save-window-excursion
    (with-temp-buffer
      (emacs-lisp-mode)
      (insert "(answer value)\n")
      (set-buffer-modified-p nil)
      (switch-to-buffer (current-buffer))
      (goto-char (point-max))
      (let ((held t)
            (point-before (point))
            (hover-window (split-window-right)))
        (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () held))
                  ((symbol-function 'mouse-pixel-position)
                   (lambda () (cons (selected-frame) '(20 . 20))))
                  ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                  ((symbol-function 'posn-at-x-y)
                   (lambda (&rest _) (list hover-window 3 '(20 . 20) 0))))
          (my-navigation-update-hover)
          (should (equal (buffer-substring (overlay-start my-navigation-hover-overlay)
                                          (overlay-end my-navigation-hover-overlay))
                         "answer"))
          (should (eq (overlay-get my-navigation-hover-overlay 'window) hover-window))
          (should (equal (overlay-get my-navigation-hover-overlay 'face) '(:underline t)))
          (should (= (point) point-before))
          (should-not (buffer-modified-p))
          (setq held nil)
          (my-navigation-update-hover)
          (should-not (overlay-buffer my-navigation-hover-overlay)))))))

(ert-deftest my-navigation-hover-skips-comments-strings-and-whitespace ()
  (save-window-excursion
    (with-temp-buffer
      (emacs-lisp-mode)
      (insert "answer ; comment\n\"string\"\n")
      (switch-to-buffer (current-buffer))
      (let ((position 2))
        (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () t))
                  ((symbol-function 'mouse-pixel-position)
                   (lambda () (cons (selected-frame) '(20 . 20))))
                  ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                  ((symbol-function 'posn-at-x-y)
                   (lambda (&rest _) (list (selected-window) position '(20 . 20) 0))))
          (my-navigation-update-hover)
          (should (overlay-buffer my-navigation-hover-overlay))
          (dolist (pos '(7 12 20))
            (setq position pos)
            (my-navigation-update-hover)
            (should-not (overlay-buffer my-navigation-hover-overlay))))))))

(ert-deftest my-navigation-native-modifier-query-is-boolean ()
  (should (memq (my-navigation-command-held-p) '(nil t))))

(ert-deftest my-navigation-hover-rejects-invalid-pixel-coordinates ()
  (dolist (xy '((-1 . 20) (20 . -1) (1.5 . 20) (nil . 20)))
    (let ((my-navigation-hover-overlay (make-overlay (point-min) (point-min))))
      (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () t))
                ((symbol-function 'mouse-pixel-position)
                 (lambda () (cons (selected-frame) xy)))
                ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                ((symbol-function 'posn-at-x-y)
                 (lambda (&rest _) (ert-fail "Invalid coordinates reached posn-at-x-y"))))
        (my-navigation-update-hover)
        (should-not (overlay-buffer my-navigation-hover-overlay))))))
