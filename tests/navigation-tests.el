;;; navigation-tests.el --- Command-hover checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(setq user-emacs-directory (make-temp-file "emacs-hover-tests-" t))
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(ert-deftest my-navigation-hover-tracks-command-without-moving-point ()
  (save-window-excursion
    (with-temp-buffer
      (emacs-lisp-mode)
      (insert "(answer value)\n")
      (set-buffer-modified-p nil)
      (switch-to-buffer (current-buffer))
      (goto-char (point-max))
      (let ((held t)
            (point-before (point))
            (hover-window (split-window-right)))
        (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () held))
                  ((symbol-function 'mouse-pixel-position)
                   (lambda () (cons (selected-frame) '(20 . 20))))
                  ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                  ((symbol-function 'posn-at-x-y)
                   (lambda (&rest _) (list hover-window 3 '(20 . 20) 0))))
          (my-navigation-update-hover)
          (should (equal (buffer-substring (overlay-start my-navigation-hover-overlay)
                                          (overlay-end my-navigation-hover-overlay))
                         "answer"))
          (should (eq (overlay-get my-navigation-hover-overlay 'window) hover-window))
          (should (equal (overlay-get my-navigation-hover-overlay 'face) '(:underline t)))
          (should (= (point) point-before))
          (should-not (buffer-modified-p))
          (setq held nil)
          (my-navigation-update-hover)
          (should-not (overlay-buffer my-navigation-hover-overlay)))))))

(ert-deftest my-navigation-hover-skips-comments-strings-and-whitespace ()
  (save-window-excursion
    (with-temp-buffer
      (emacs-lisp-mode)
      (insert "answer ; comment\n\"string\"\n")
      (switch-to-buffer (current-buffer))
      (let ((position 2))
        (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () t))
                  ((symbol-function 'mouse-pixel-position)
                   (lambda () (cons (selected-frame) '(20 . 20))))
                  ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                  ((symbol-function 'posn-at-x-y)
                   (lambda (&rest _) (list (selected-window) position '(20 . 20) 0))))
          (my-navigation-update-hover)
          (should (overlay-buffer my-navigation-hover-overlay))
          (dolist (pos '(7 12 20))
            (setq position pos)
            (my-navigation-update-hover)
            (should-not (overlay-buffer my-navigation-hover-overlay))))))))

(ert-deftest my-navigation-native-modifier-query-is-boolean ()
  (should (memq (my-navigation-command-held-p) '(nil t))))

(ert-deftest my-navigation-hover-rejects-invalid-pixel-coordinates ()
  (dolist (xy '((-1 . 20) (20 . -1) (1.5 . 20) (nil . 20)))
    (let ((my-navigation-hover-overlay (make-overlay (point-min) (point-min))))
      (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () t))
                ((symbol-function 'mouse-pixel-position)
                 (lambda () (cons (selected-frame) xy)))
                ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                ((symbol-function 'posn-at-x-y)
                 (lambda (&rest _) (ert-fail "Invalid coordinates reached posn-at-x-y"))))
        (my-navigation-update-hover)
        (should-not (overlay-buffer my-navigation-hover-overlay))))))

(defmacro my-test-navigation-tooltip (&rest body)
  `(save-window-excursion
     (with-temp-buffer
       (emacs-lisp-mode)
       (insert "answer value\n")
       (setq buffer-file-name "/tmp/navigation-hover.go")
       (switch-to-buffer (current-buffer))
       (goto-char (point-max))
       (let ((held t) (position 2) requests tips (hides 0)
             my-navigation-hover-target my-navigation-tooltip-timer
             my-navigation-tooltip-shown)
         (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () held))
                   ((symbol-function 'mouse-pixel-position)
                    (lambda () (cons (selected-frame) '(20 . 20))))
                   ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                   ((symbol-function 'posn-at-x-y)
                    (lambda (&rest _) (list (selected-window) position '(20 . 20) 0)))
                   ((symbol-function 'eglot-managed-p) (lambda () t))
                   ((symbol-function 'eglot-current-server) (lambda () 'server))
                   ((symbol-function 'eglot-server-capable) (lambda (&rest _) t))
                   ((symbol-function 'jsonrpc-async-request)
                    (lambda (_server method params &rest args)
                      (push (list method params args) requests)))
                   ((symbol-function 'posframe-show)
                    (lambda (_buffer &rest args) (push (plist-get args :string) tips)))
                   ((symbol-function 'posframe-hide) (lambda (_) (cl-incf hides))))
           (unwind-protect (progn ,@body)
             (my-navigation-clear-hover)))))))

(defun my-test-navigation-fire-tooltip-timer ()
  (should (timerp my-navigation-tooltip-timer))
  (let ((timer my-navigation-tooltip-timer))
    (cancel-timer timer)
    (apply (timer--function timer) (timer--args timer))))

(ert-deftest my-navigation-tooltip-shows-hover-docs-once-without-moving-point ()
  (my-test-navigation-tooltip
   (my-navigation-update-hover)
   (should-not requests)
   (let ((timer my-navigation-tooltip-timer))
     (setq position 4)
     (my-navigation-update-hover)
     (should (eq timer my-navigation-tooltip-timer)))
   (my-test-navigation-fire-tooltip-timer)
   (should (eq (caar requests) :textDocument/hover))
   (should (equal (plist-get (cadar requests) :position) '(:line 0 :character 0)))
   (funcall (plist-get (nth 2 (car requests)) :success-fn)
            '(:contents (:kind "plaintext" :value "func answer() int\nReturns the answer.")))
   (should (equal (substring-no-properties (car tips))
                  "func answer() int\nReturns the answer."))
   (should (= (point) (point-max)))
   (my-navigation-update-hover)
   (should (= (length requests) 1))
   (setq held nil)
   (my-navigation-update-hover)
   (should (= hides 1))
   (should-not my-navigation-tooltip-timer)))

(ert-deftest my-navigation-tooltip-discards-stale-responses ()
  (dolist (change '(release move edit close))
    (my-test-navigation-tooltip
     (my-navigation-update-hover)
     (my-test-navigation-fire-tooltip-timer)
     (pcase change
       ('release (setq held nil))
       ('move (setq position 9))
       ('edit (insert "changed"))
       ('close (kill-buffer (current-buffer))))
     (funcall (plist-get (nth 2 (car requests)) :success-fn)
              '(:contents (:kind "plaintext" :value "stale")))
     (should-not tips))))

(ert-deftest my-navigation-tooltip-tolerates-empty-and-failed-hover ()
  (dolist (response '(nil (:contents "") (:contents []) error timeout))
    (my-test-navigation-tooltip
     (my-navigation-update-hover)
     (my-test-navigation-fire-tooltip-timer)
     (let ((callbacks (nth 2 (car requests))))
       (pcase response
         ('error (funcall (plist-get callbacks :error-fn) '(:code -32603 :message "failed")))
         ('timeout (funcall (plist-get callbacks :timeout-fn)))
         (_ (funcall (plist-get callbacks :success-fn) response))))
     (should-not tips))))

(ert-deftest my-navigation-tooltip-skips-unmanaged-buffers ()
  (my-test-navigation-tooltip
   (cl-letf (((symbol-function 'eglot-managed-p) (lambda () nil)))
     (my-navigation-update-hover)
     (should-not my-navigation-tooltip-timer)
     (should (overlay-buffer my-navigation-hover-overlay)))))

(ert-deftest my-navigation-tooltip-preserves-go-syntax-colors ()
  (my-test-navigation-tooltip
   (my-navigation-update-hover)
   (my-test-navigation-fire-tooltip-timer)
   (funcall (plist-get (nth 2 (car requests)) :success-fn)
            '(:contents (:kind "markdown" :value
                               "```go\nfunc answer() int\n```\n\nReturns the answer.\n\n```go\ntype Widget struct { Count int }\n```")))
   (dolist (sample '(("func" . font-lock-keyword-face)
                     ("answer" . font-lock-function-name-face)
                     ("Widget" . font-lock-type-face)
                     ("Count" . font-lock-property-name-face)))
     (let* ((start (string-match (car sample) (car tips)))
            (face (get-text-property start 'face (car tips))))
       (should (memq (cdr sample) (if (listp face) face (list face))))))))

(ert-deftest my-navigation-tooltip-colors-gopls-field-descriptions ()
  (my-test-navigation-tooltip
   (my-navigation-update-hover)
   (my-test-navigation-fire-tooltip-timer)
   (funcall (plist-get (nth 2 (car requests)) :success-fn)
            '(:contents (:kind "markdown" :value
                               "```go\nfield Count int\n```\n\nCount tracks items.")))
   (dolist (sample '(("Count int" . font-lock-property-name-face)
                     ("int" . font-lock-type-face)))
     (let* ((start (string-match (car sample) (car tips)))
            (face (get-text-property start 'face (car tips))))
       (should (memq (cdr sample) (if (listp face) face (list face))))))))
