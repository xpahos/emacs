(ert-deftest pi-history-retry-preserves-write-order ()
  (pi-test-env
   (my-pi-history-register "a" root)
   (let ((connection (sqlite-open (my-pi-history-path))))
     (unwind-protect
         (progn
           (sqlite-execute connection "BEGIN IMMEDIATE")
           (my-pi-history-update "a" :turn_state "running")
           (sqlite-execute connection "ROLLBACK")
           (my-pi-history-update "a" :turn_state "idle")
           (let ((deadline (+ (float-time) 0.5)))
             (while (< (float-time) deadline) (accept-process-output nil 0.05)))
           (should (equal (plist-get (my-pi-history-get "a") :turn_state) "idle")))
       (sqlite-close connection)))))

