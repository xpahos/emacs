;;; pi-history-tests.el --- Pi catalogue regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defconst pi-test-directory (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(load (expand-file-name "pi-history.el" pi-test-directory) t t)
(load (expand-file-name "pi-history-worker.el" pi-test-directory) t t)

(defmacro pi-test-env (&rest body)
  `(let* ((user-emacs-directory (make-temp-file "pi-history-test-" t))
          (my-pi-history-db nil)
          (process-environment (cons (concat "HOME=" user-emacs-directory) process-environment))
          (root (expand-file-name "project/" user-emacs-directory))
          (other (expand-file-name "other/" user-emacs-directory)))
     (make-directory root t) (make-directory other t)
     (unwind-protect (progn ,@body)
       (when my-pi-history-db (sqlite-close my-pi-history-db))
       (delete-directory user-emacs-directory t))))

(load (expand-file-name "tests/pi-history-fixtures.el" pi-test-directory) nil t)

(ert-deftest pi-history-project-isolation ()
  (pi-test-env
   (should (fboundp 'my-pi-history-register))
   (my-pi-history-register "a" root)
   (my-pi-history-register "b" other)
   (my-pi-history-register "a" root)
   (should (equal (mapcar (lambda (c) (plist-get c :id)) (my-pi-history-list root)) '("a")))))

(ert-deftest pi-history-geometry-migration-on-reload ()
  (pi-test-env
   (let ((db (my-pi-history-open)))
     (sqlite-execute db "ALTER TABLE projects DROP COLUMN picker_left")
     (sqlite-execute db "ALTER TABLE projects DROP COLUMN picker_top")
     (sqlite-execute db "INSERT INTO projects VALUES (?,'selected',640,420)" (list root))
     (load (expand-file-name "pi-history.el" pi-test-directory) nil t)
     (should (equal (sqlite-select db "SELECT selected_session_id,picker_width,picker_height,picker_left,picker_top FROM projects WHERE project_root=?" (list root))
                    '(("selected" 640 420 nil nil)))))))

(ert-deftest pi-history-order-and-read ()
  (pi-test-env
   (my-pi-history-register "old" root)
   (my-pi-history-register "new" root)
   (my-pi-history-update "old" :last_reply_at "2026-01-01" :last_reply_id "r1")
   (my-pi-history-update "new" :last_reply_at "2026-02-01" :last_reply_id "r2")
   (should (equal (mapcar (lambda (c) (plist-get c :id)) (my-pi-history-list root)) '("new" "old")))
   (my-pi-history-update "new" :read_reply_id "r2" :title "Renamed")
   (should (equal (plist-get (car (my-pi-history-list root)) :id) "old"))))

(ert-deftest pi-history-branch-compaction-and-search ()
  (pi-test-env
   (let ((file (expand-file-name "chat.jsonl" root)))
     (pi-test-jsonl file
      (list `((type . "session") (version . 3) (id . "a") (cwd . ,root))
            (pi-test-message "u1" nil "user" "obsolete secret")
            (pi-test-message "a1" "u1" "assistant" "wrong branch")
            (pi-test-message "u2" "u1" "user" "PCI устройство")
            (pi-test-message "a2" "u2" "assistant" "PCI устройство works")
            '((type . "compaction") (id . "c") (parentId . "a2") (firstKeptEntryId . "u2") (summary . "summary"))
            (pi-test-message "u3" "c" "user" "next"))
      "{\"type\":")
     (my-pi-history-index-file file root)
     (should (= (length (my-pi-history-query root "pci устройство")) 1))
     (should-not (my-pi-history-query root "obsolete"))
     (should-not (my-pi-history-query root "wrong"))
     (should-not (my-pi-history-query other "pci"))
     (should (= (length (cl-remove-if (lambda (m) (equal (plist-get m :message-id) "")) (plist-get (car (my-pi-history-query root "\"PCI устройство\"")) :matches))) 2))
     (my-pi-history-update "a" :read_reply_id "a2")
     (my-pi-history-index-file file root)
     (should (equal (plist-get (my-pi-history-get "a") :read_reply_id) "a2")))))

