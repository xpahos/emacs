     (make-directory sessions t)
     (with-temp-file map (insert "{broken"))
     (pi-test-jsonl (expand-file-name "a.jsonl" sessions)
      (list `((type . "session") (id . "a") (cwd . ,alias))
            (pi-test-message "u" nil "user" "targetword")))
     (pi-test-jsonl (expand-file-name "b.jsonl" sessions)
      (list `((type . "session") (id . "b") (cwd . ,other))
            (pi-test-message "u" nil "user" "otherword")))
