(ert-deftest pi-history-worker-transport ()
  (pi-test-env
   (let* ((sessions (expand-file-name "sessions" user-emacs-directory))
          (profile (list :map (expand-file-name "absent-map" user-emacs-directory) :sessions sessions))
          result)
     (make-directory sessions t)
     (pi-test-jsonl (expand-file-name "a.jsonl" sessions)
      (list `((type . "session") (id . "a") (cwd . ,root))
            (pi-test-message "u" nil "user" "Unicode устройство")))
     (cl-letf (((symbol-function 'my-pi-history-profile) (lambda () profile)))
       (let ((process (my-pi-history-search root "устройство" (lambda (r) (setq result r))))
             (deadline (+ (float-time) 10)))
         (while (and (not result) (< (float-time) deadline)) (accept-process-output process 0.1))
         (should result)
         (should-not (plist-get result :error))
         (should (equal (plist-get (car (plist-get result :chats)) :id) "a")))))))

(ert-deftest pi-delete-verifies-file-and-project ()
  (pi-test-env
   (let ((file (expand-file-name "chat.jsonl" root)))
     (pi-test-jsonl file (list `((type . "session") (id . "a") (cwd . ,root))))
     (my-pi-history-register "a" root file)
     (my-pi-history-update "a" :title "searchable")
     (should-error (my-pi-history-delete-finish other "a"))
     (should-error (my-pi-history-delete-finish root "a"))
     (should (my-pi-history-get "a"))
     (delete-file file)
     (my-pi-history-delete-finish root "a")
     (should-not (my-pi-history-get "a"))
     (should-not (my-pi-history-query root "searchable")))))

(ert-deftest pi-history-recover-stale-running ()
  (pi-test-env
   (my-pi-history-register "a" root)
   (my-pi-history-update "a" :turn_state "running" :owner_instance "dead-instance")
   (my-pi-history-register "b" root)
   (my-pi-history-update "b" :turn_state "running" :owner_instance my-pi-history-instance)
   (my-pi-history-recover root)
