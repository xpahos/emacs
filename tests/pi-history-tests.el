     (my-pi-history-discover root (list :map map :sessions sessions))
     (should (my-pi-history-get "a")))))

(ert-deftest pi-history-process-crash-rolls-back ()
  (pi-test-env
   (my-pi-history-register "durable" root)
   (my-pi-history-update "durable" :title "Saved before crash")
   (let* ((output (generate-new-buffer " *Pi crash test*"))
          (code (format "(progn (setq user-emacs-directory %S) (load %S nil t) (let ((db (my-pi-history-open))) (sqlite-execute db \"BEGIN IMMEDIATE\") (sqlite-execute db \"DELETE FROM chats\") (with-temp-file (expand-file-name \"ready\" user-emacs-directory) (insert \"ready\")) (while t (sleep-for 1))))"
                        user-emacs-directory (expand-file-name "pi-history.el" pi-test-directory)))
          (process (make-process :name "pi-crash-test" :buffer output :connection-type 'pipe :noquery t
                    :command (list (expand-file-name invocation-name invocation-directory) "-Q" "--batch" "--eval" code))))
     (unwind-protect
         (progn
           (let ((deadline (+ (float-time) 5)))
             (while (and (not (file-exists-p (expand-file-name "ready" user-emacs-directory)))
                         (< (float-time) deadline)) (accept-process-output process 0.05)))
           (should (file-exists-p (expand-file-name "ready" user-emacs-directory)))
           (signal-process process 'SIGKILL)
           (while (process-live-p process) (accept-process-output process 0.05))
           (sqlite-close my-pi-history-db) (setq my-pi-history-db nil)
           (should (equal (plist-get (my-pi-history-get "durable") :title) "Saved before crash"))
           (should (equal (sqlite-select (my-pi-history-open) "PRAGMA integrity_check") '(("ok")))))
       (when (process-live-p process) (delete-process process))
       (kill-buffer output)))))

