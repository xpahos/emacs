(ert-deftest pi-history-gui-write-retries-lock ()
  (pi-test-env
   (my-pi-history-register "a" root)
   (let ((other-db (sqlite-open (my-pi-history-path))))
     (unwind-protect
         (progn
           (sqlite-execute other-db "BEGIN IMMEDIATE")
           (my-pi-history-update "a" :title "survives-lock")
           (sqlite-execute other-db "ROLLBACK")
           (let ((deadline (+ (float-time) 3)))
             (while (and (not (equal (plist-get (my-pi-history-get "a") :title) "survives-lock"))
                         (< (float-time) deadline)) (accept-process-output nil 0.05)))
           (should (equal (plist-get (my-pi-history-get "a") :title) "survives-lock")))
       (sqlite-close other-db)))))

