(ert-deftest pi-history-mapped-identity-and-legacy-duplicates ()
  (pi-test-env
   (let* ((file (expand-file-name "chat.jsonl" other))
          (map (expand-file-name "map.json" user-emacs-directory))
          (profile (list :map map :sessions other)))
     (pi-test-jsonl file
       (list `((type . "session") (id . "native") (cwd . ,other))
             (pi-test-message "u" nil "user" "Actual conversation")
             (pi-test-message "r" "u" "assistant" "PCI answer")))
     (with-temp-file map
       (insert (json-serialize `((sessions . ((external . ((sessionId . "external") (cwd . ,root)
                                                          (sessionFile . ,file) (updatedAt . "2026-11-16")))))))))
     (my-pi-history-register "external" root file)
     (my-pi-history-update "external" :deleting 1)
     (my-pi-history-index-file file other)
     (my-pi-history-update "native" :read_reply_id "r")
     (my-pi-history-select other "native")
     (should-not (my-pi-history-discover root profile))
     (should (= (length (my-pi-history-list root)) 1))
     (should-not (my-pi-history-get "native"))
     (should (equal (plist-get (my-pi-history-get "external") :title) "Actual conversation"))
     (should-not (plist-get (my-pi-history-get "external") :unread))
     (should (= (plist-get (my-pi-history-get "external") :deleting) 0))
     (should (my-pi-history-query root "PCI"))
     (should-not (my-pi-history-discover other profile))
     (should-not (my-pi-history-list other))
     (cl-letf (((symbol-function 'my-pi-history-profile) (lambda () profile)))
       (my-pi-history-validate-delete root "external")
       (my-pi-history-update "external" :session_file (expand-file-name "other.jsonl" root))
       (should-error (my-pi-history-validate-delete root "external")))
     (should (file-exists-p file)))))

(ert-deftest pi-delete-stops-all-aliases-and-propagates-failure ()
  (let (stopped result)
    (cl-letf (((symbol-function 'my-pi-stop-for-delete)
               (lambda (buffer callback)
                 (push buffer stopped)
                 (funcall callback (when (eq buffer 'failed) "still running")))))
      (my-pi-stop-aliases-for-delete '(one two) (lambda (error) (setq result (or error 'done))))
      (should (equal (reverse stopped) '(one two)))
      (should (eq result 'done))
      (setq stopped nil)
      (my-pi-stop-aliases-for-delete '(one failed three) (lambda (error) (setq result error)))
      (should (equal (reverse stopped) '(one failed)))
      (should (equal result "still running")))))

