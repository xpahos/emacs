(ert-deftest pi-history-search-identifier-prefix-in-message ()
  (pi-test-env
   (let ((file (expand-file-name "chat.jsonl" root)))
     (pi-test-jsonl file
       (list `((type . "session") (id . "a") (cwd . ,root))
             (pi-test-message "u" nil "user" "Investigate the issue")
             (pi-test-message "r" "u" "assistant" "See CLOUD-298453: устройство PCI")))
     (my-pi-history-index-file file root)
     (dolist (query '("CLOUD-29" "cloud-298" "устрой" "cloud-29 pci"))
       (let ((matches (plist-get (car (my-pi-history-query root query)) :matches)))
         (should (equal (plist-get (car matches) :message-id) "r"))))
     (should-not (my-pi-history-query root "\"CLOUD-29\""))
     (should (my-pi-history-query root "\"CLOUD-298453\""))
     (should-not (my-pi-history-query other "CLOUD-29")))))

(ert-deftest pi-history-index-rollback ()
  (pi-test-env
   (my-pi-history-register "a" root)
   (let ((db (my-pi-history-open)))
     (condition-case nil
         (my-pi-history-transaction db
           (sqlite-execute db "DELETE FROM chats")
           (error "interrupted"))
       (error nil))
     (should (my-pi-history-get "a"))
     (should (equal (sqlite-select db "PRAGMA integrity_check") '(("ok")))))))

