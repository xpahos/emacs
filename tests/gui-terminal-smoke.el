;;; gui-terminal-smoke.el --- Real native terminal and side-window geometry -*- lexical-binding: t; -*-
(setq user-emacs-directory (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME required"))))
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(require 'server)
(setq server-name "ghostel-smoke")
(server-start)
(setq my-shell-home (expand-file-name "shell/" user-emacs-directory))
(make-directory (expand-file-name "zsh" my-shell-home) t)
(dolist (file '("history.py" "vimrc" "zsh/.zshrc" "zsh/prompt.zsh"))
  (copy-file (expand-file-name file (or (getenv "MY_SHELL_HOME") "~/.emacs/shell/"))
             (expand-file-name file my-shell-home) t))

(defun my-test-shell-wait (predicate description)
  (let ((deadline (+ (float-time) 15)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05) (redisplay t))
    (unless (funcall predicate) (error "Timed out: %s" description))))

(defun my-test-shell ()
  (set-frame-size nil 150 45)
  (when (eq system-type 'darwin)
    (cl-assert (null (frame-parameter nil 'vertical-scroll-bars)))
    (cl-assert (null (frame-parameter nil 'horizontal-scroll-bars)))
    (let* ((log (get-buffer-create "*test-log*"))
           (_ (with-current-buffer log (special-mode)))
           (window (my-eglot-log-popup log nil))
           (frame (window-frame window)))
      (cl-assert (frame-parent frame))
      (cl-assert (null (frame-parameter frame 'vertical-scroll-bars)))
      (delete-frame frame))
    (let* ((file (expand-file-name "xref-fixture.txt" user-emacs-directory))
           (_ (with-temp-file file (insert "reference\n")))
           (buffer (my-references-popup
                    (lambda () (list (xref-make "reference" (xref-make-file-location file 1 0)))) nil))
           (frame (window-frame (get-buffer-window buffer t))))
      (cl-assert (frame-parent frame))
      (cl-assert (null (frame-parameter frame 'vertical-scroll-bars)))
      (delete-frame frame)))
  (let ((root (expand-file-name "repo/" user-emacs-directory)))
    (make-directory root)
    (dolist (args '(("init" "-q" "-b" "main") ("-c" "user.name=Test" "-c" "user.email=t@example.com"
                                                           "-c" "commit.gpgsign=false" "commit" "--allow-empty" "-qm" "fixture")
                    ("branch" "terminal-copy")))
      (cl-assert (zerop (car (apply #'my-wt-call root "git" args)))))
    (my-project-open root))
  (let* ((editor (selected-window))
         (pi (get-buffer-create "*test-pi-panel*"))
         (right (my-pi-display-buffer pi nil))
         (tree (treemacs-get-local-window))
         (shell (progn (select-window editor) (my-shell-toggle)))
         (panel (get-buffer-window shell))
         (process (buffer-local-value 'ghostel--process shell)))
    (my-test-shell-wait (lambda () (with-current-buffer shell ghostel--prompt-positions)) "zsh prompt / OSC 133 integration")
    (cl-assert (process-live-p process))
    (cl-assert (process-get process 'ghostel--native-child))
    (cl-assert (= (window-pixel-width panel) (window-pixel-width (frame-root-window))))
    (cl-assert (<= (nth 3 (window-pixel-edges tree)) (nth 1 (window-pixel-edges panel))))
    (cl-assert (<= (nth 3 (window-pixel-edges right)) (nth 1 (window-pixel-edges panel))))
    (cl-assert (eq (key-binding (kbd "C-c t")) #'my-shell-toggle))
    (my-test-shell-wait (lambda () (with-current-buffer shell (string-match-p "\\[ \\. \\] " (buffer-string)))) "project-root prompt")
    (cl-assert (= (buffer-local-value 'ghostel--cursor-style shell) 1))
    (cl-assert (eq (face-attribute 'ghostel-bold :weight) 'semi-bold))
    (make-directory (expand-file-name "api/internal" my-shell-project-root) t)
    (ghostel-send-string " cd api/internal\n" t)
    (my-test-shell-wait (lambda () (with-current-buffer shell (string-match-p "\\[ api/internal \\] " (buffer-string)))) "relative prompt after cd")
    (ghostel-send-string " git switch -c prompt-check\n" t)
    (my-test-shell-wait (lambda () (with-current-buffer shell (string-match-p "repo · prompt-check" (my-shell-header)))) "branch header after shell checkout")
    (ghostel-send-string " cd ../..\n" t)
    (ghostel-send-string "printf 'GHOSTEL_SMOKE_OK\\n'\n" t)
    (my-test-shell-wait (lambda () (with-current-buffer shell (string-match-p "GHOSTEL_SMOKE_OK" (buffer-string)))) "terminal output")
    (let ((id (with-current-buffer shell my-shell-context-id)))
      (window-resize panel 2)
      (my-shell-remember-height)
      (let ((height (gethash id my-shell-heights)))
        (my-shell-toggle)
        (cl-assert (eq (selected-window) editor))
        (cl-assert (process-live-p process))
        (my-shell-toggle)
        (cl-assert (eq (current-buffer) shell))
        (cl-assert (equal height (gethash id my-shell-heights)))))
    (my-shell-maximize)
    (cl-assert (= (length (window-list)) 1))
    (my-shell-maximize)
    (cl-assert (= (length (window-list)) 4))
    ;; A new named terminal has its own scope but reuses the panel.
    (pcase-let ((`(,context ,copy ,directory) (my-shell-location)))
      (let ((second (my-shell-show context copy directory "server")))
        (cl-assert (not (eq second shell)))
        (my-test-shell-wait (lambda () (with-current-buffer second ghostel--prompt-positions)) "second prompt")
        (let ((kill-buffer-query-functions nil)) (kill-buffer second)))
      (my-shell-show context copy directory "shell"))
    ;; Restart zsh and ask its builtin history to show the earlier command.
    (ghostel-send-string " exit\n" t)
    (my-test-shell-wait (lambda () (not (buffer-live-p shell))) "shell exit")
    (select-window editor)
    (setq shell (my-shell-toggle))
    (my-test-shell-wait (lambda () (with-current-buffer shell ghostel--prompt-positions)) "restarted prompt")
    (ghostel-send-string " fc -ln 1\n" t)
    (my-test-shell-wait (lambda () (with-current-buffer shell (string-match-p "printf 'GHOSTEL_SMOKE_OK" (buffer-string)))) "SQLite history after restart")
    (let* ((original (my-wt-tab-copy))
           (copy (my-wt-create original '(:branch "terminal-copy")))
           (id (plist-get copy :copy_id)))
      (my-test-shell-wait (lambda () (not (gethash id my-wt-busy))) "worktree creation")
      (setq copy (my-wt-copy id))
      (my-shell-maximize)
      (my-wt-switch copy)
      (cl-assert (not (my-shell-window)))
      (cl-assert (equal default-directory (plist-get copy :directory)))
      (let ((copy-shell (my-shell-toggle)))
        (my-test-shell-wait (lambda () (with-current-buffer copy-shell ghostel--prompt-positions)) "copy prompt")
        (cl-assert (equal (buffer-local-value 'my-shell-context-id copy-shell) (concat "copy:" id)) nil
                   "Copy context %S != copy:%s; record %S; buffer %S"
                   (buffer-local-value 'my-shell-context-id copy-shell) id (my-wt-tab-copy) copy-shell)
        (cl-assert (not (my-wt-delete-blockers copy)))
        (ghostel-send-string "echo COPY_HISTORY\n" t)
        (my-wt-switch original)
        (cl-assert (eq (window-buffer (my-shell-window)) shell))
        (cl-assert (> (length (window-list)) 1))
        (cl-assert (not (buffer-local-value 'my-shell-expanded-config shell)))
        (cl-assert (process-live-p (buffer-local-value 'ghostel--process copy-shell)))
        (my-wt-switch copy)
        (cl-assert (eq (window-buffer (my-shell-window)) copy-shell))
        (select-window (my-shell-window)))
      (my-wt-delete copy)
      (my-test-shell-wait (lambda () (not (gethash id my-wt-busy))) "worktree deletion")
      (cl-assert (equal (plist-get (my-wt-copy id) :state) "deleted"))
      (cl-assert (gethash id my-shell-cleaned))
      (cl-assert (eq (window-buffer (my-shell-window)) shell))
      (select-window (my-shell-window)))
    (my-shell-maximize)
    (ghostel-send-string " exit\n" t)
    (my-test-shell-wait (lambda () (not (buffer-live-p shell))) "final exit")
    (cl-assert (not (my-shell-window)))
    (setq shell (my-shell-toggle))
    (my-test-shell-wait (lambda () (with-current-buffer shell ghostel--prompt-positions)) "reopen after expanded exit")
    (ghostel-send-string " exit\n" t)
    (my-test-shell-wait (lambda () (not (buffer-live-p shell))) "reopened shell exit")))

(run-at-time
 1 nil
 (lambda ()
   (condition-case err
       (progn (my-test-shell)
              (with-temp-file (expand-file-name "result" user-emacs-directory)
                (insert "PASS: native Ghostel, zsh integration, full-width panel, named sessions, toggle, resize, maximize, SQLite restart, worktree switching and deletion\n"))
              (kill-emacs 0))
     (error
      (with-temp-file (expand-file-name "result" user-emacs-directory)
        (insert (error-message-string err) "\n")
        (dolist (buffer (ghostel-buffer-list))
          (insert (format "\n%s\n%s\n" (buffer-name buffer) (with-current-buffer buffer (buffer-string))))))
      (let ((kill-emacs-query-functions nil)) (kill-emacs 1))))))
