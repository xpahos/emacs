;;; gui-navigation-smoke.el --- Real gopls reference popup check -*- lexical-binding: t; -*-
(setq user-emacs-directory
      (file-name-as-directory (file-truename (or (getenv "EMACS_TEST_HOME")
                                                (error "EMACS_TEST_HOME is required")))))
;; Initialize font caches before Eglot probes glyphs in this early -Q launch.
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(defun my-test-reference-popup ()
  (condition-case err
      (let* ((root (expand-file-name "project/" user-emacs-directory))
             (file (expand-file-name "main.go" root))
             (parent (selected-frame))
             (eglot-sync-connect t)
             (eglot-connect-timeout 15))
        (make-directory root t)
        (with-temp-file (expand-file-name "go.mod" root)
          (insert "module example.test/popup\n\ngo 1.24\n"))
        (with-temp-file file
          (insert "package demo\n// answer returns forty-two.\nfunc answer() int { return 42 }\nfunc one() int { return answer() }\nfunc two() int { return answer() }\n"
                  "\n// Widget holds a count.\ntype Widget struct {\n// Count tracks items.\nCount int\n}\n"))
        (my-project-open root)
        (find-file file)
        (run-hooks 'post-command-hook)
        (redisplay t)
        (cl-assert (eglot-current-server))
        (goto-char (point-min)) (search-forward "func answer") (backward-char 3)
        (let ((source (selected-window))
              (origin (point))
              (windows (window-list parent)))
          (let ((held t) (hover-position origin) tips
                (show-tip (symbol-function 'posframe-show)))
            (cl-letf (((symbol-function 'my-navigation-command-held-p) (lambda () held))
                      ((symbol-function 'mouse-pixel-position)
                       (lambda () (cons parent '(20 . 40))))
                      ((symbol-function 'frame-focus-state) (lambda (&optional _) t))
                      ((symbol-function 'posn-at-x-y)
                       (lambda (&rest _) (list source hover-position '(20 . 40) 0)))
                      ((symbol-function 'posframe-show)
                       (lambda (buffer &rest args)
                         (push (plist-get args :string) tips)
                         (apply show-tip buffer args))))
              (my-navigation-update-hover)
              (redisplay t)
              (cl-assert (equal (buffer-substring
                                 (overlay-start my-navigation-hover-overlay)
                                 (overlay-end my-navigation-hover-overlay)) "answer"))
              (cl-assert (= (point) origin))
              (dolist (spec '(("func answer" "func answer() int" "answer returns forty-two."
                               "answer" font-lock-function-name-face)
                              ("type Widget" "type Widget struct" "Widget holds a count."
                               "Widget" font-lock-type-face)
                              ("Count int" "Count int" "Count tracks items."
                               "Count int" font-lock-property-name-face)))
                (setq tips nil held t
                      hover-position (save-excursion
                                       (goto-char (point-min))
                                       (search-forward (car spec))
                                       (- (point) (if (equal (car spec) "Count int") 7 1))))
                (my-navigation-update-hover)
                (let ((deadline (+ (float-time) 10)))
                  (while (and (not tips) (< (float-time) deadline))
                    (accept-process-output nil 0.05)))
                (cl-assert tips)
                (cl-assert (string-match-p (regexp-quote (cadr spec)) (car tips)))
                (cl-assert (string-match-p (regexp-quote (caddr spec)) (car tips)))
                (cl-assert (not (string-match-p "return 42" (car tips))))
                (cl-assert (= (point) origin))
                (cl-assert (eq (selected-window) source))
                (cl-assert my-navigation-tooltip-shown)
                (with-current-buffer " *Hover documentation*"
                  (goto-char (point-min))
                  (cl-assert (invisible-p (point)))
                  (search-forward (nth 3 spec))
                  (let ((face (get-text-property (match-beginning 0) 'face)))
                    (cl-assert (memq (nth 4 spec) (if (listp face) face (list face))))))
                (let ((tip (seq-find (lambda (frame) (frame-parameter frame 'posframe-buffer))
                                     (frame-list))))
                  (cl-assert tip)
                  (cl-assert (= (frame-parameter tip 'child-frame-border-width) 2))
                  (cl-assert (equal (frame-parameter tip 'background-color)
                                    (face-background 'tooltip nil t)))
                  (cl-assert (= (frame-parameter tip 'left-fringe) 12))
                  (cl-assert (= (frame-parameter tip 'right-fringe) 12)))
                (setq held nil)
                (my-navigation-update-hover)
                (cl-assert (not my-navigation-tooltip-shown))
                (cl-assert (not (overlay-buffer my-navigation-hover-overlay))))))
          (my-overview-refresh)
          (cl-assert (= (length my-overview-views) 1))
          (funcall (key-binding [s-mouse-1])
                   (list 's-mouse-1 (list source origin '(20 . 40) 0)))
          (cl-assert (eq (frame-parent) parent))
          (cl-assert (= (frame-parameter nil 'child-frame-border-width) 2))
          (cl-assert (= (frame-parameter nil 'left-fringe) 12))
          (cl-assert (equal (frame-parameter nil 'background-color)
                            (face-background 'tooltip nil t)))
          (let ((popup (selected-frame)))
            (my-overview-refresh)
            (cl-assert (eq (selected-frame) popup)))
          (unless (seq-set-equal-p (window-list parent) windows #'eq)
            (error "Parent windows changed: before %S after %S"
                   windows (window-list parent)))
          (cl-assert (= (length (tab-bar-tabs parent)) 2))
          (with-current-buffer (window-buffer (selected-window))
            (cl-assert (string-match-p "one()" (buffer-string)))
            (cl-assert (string-match-p "two()" (buffer-string)))
            ;; An idle save must save the editor, not the popup's empty tabs.
            (tabspaces-save-session)
            (cl-assert (assoc root tabspaces-project-tab-map))
            ;; Eglot includes the declaration; choose the next actual use.
            (call-interactively (key-binding [down]))
            (let ((popup (selected-frame)))
              (call-interactively (command-remapping 'xref-goto-xref))
              (cl-assert (not (frame-live-p popup)))))
          (cl-assert (eq (selected-window) source))
          (set-buffer (window-buffer source))
          (cl-assert (memq (line-number-at-pos) '(4 5)))
          (xref-go-back)
          (cl-assert (= (point) origin))
          (my-find-references-at-mouse
           (list 's-mouse-1 (list source origin '(20 . 40) 0)))
          (my-find-references-at-mouse
           (list 's-mouse-1 (list source origin '(20 . 40) 0)))
          (cl-assert (= 1 (length (seq-filter
                                  (lambda (frame)
                                    (and (eq (frame-parent frame) parent)
                                         (frame-visible-p frame)
                                         (not (frame-parameter frame 'my-overview-view))))
                                  (frame-list)))))
          (let ((popup (selected-frame)))
            (with-current-buffer (window-buffer (selected-window))
              (call-interactively (key-binding [escape])))
            (cl-assert (not (frame-live-p popup))))
          (cl-assert (eq (selected-window) source))
          (set-buffer (window-buffer source))
          (cl-assert (= (point) origin)))
        (with-temp-file (expand-file-name "navigation.passed" user-emacs-directory)
          (insert "Real gopls function/type/field hover tooltips, references, floating list, jump, back, Esc and session save passed.\n"))
        (when-let* ((server (with-current-buffer (get-file-buffer file)
                             (eglot-current-server))))
          (eglot-shutdown server))
        (kill-emacs 0))
    (error
     (with-temp-file (expand-file-name "failure.txt" user-emacs-directory)
       (prin1 err (current-buffer)))
     (kill-emacs 1))))

(add-hook 'emacs-startup-hook
          (lambda () (run-with-timer 1 nil #'my-test-reference-popup)))
