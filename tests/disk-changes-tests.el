;;; disk-changes-tests.el --- External file change review -*- lexical-binding: t; -*-
(require 'ert)
(load (expand-file-name "../disk-changes.el" (file-name-directory load-file-name)) nil t)

(defvar my-disk-test-tick 0)

(defun my-disk-test-write (file text)
  "Write TEXT to FILE as another program would, with a distinct timestamp."
  (let ((coding-system-for-write 'utf-8-unix))
    (write-region text nil file nil 'silent))
  (set-file-times file (time-add nil (cl-incf my-disk-test-tick))))

(defmacro my-disk-test (text &rest body)
  (declare (indent 1))
  `(let* ((dir (make-temp-file "emacs-disk-" t))
          (file (expand-file-name "retry.go" dir))
          (my-disk-recovery-directory (expand-file-name "recovery/" dir))
          buffer)
     (unwind-protect
         (progn
           (my-disk-test-write file ,text)
           (setq buffer (find-file-noselect file))
           (with-current-buffer buffer ,@body))
       (when (buffer-live-p buffer)
         (with-current-buffer buffer (set-buffer-modified-p nil))
         (kill-buffer buffer))
       (delete-directory dir t))))

(defun my-disk-test-file-text (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest my-disk-detects-change-in-clean-buffer-without-reloading ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (should my-disk-pending)
    (should (plist-get my-disk-pending :expanded))
    (should (equal (buffer-string) "one\n"))
    (should-not (buffer-modified-p))
    (should (string-match-p "retry\\.go has external changes\\." (my-disk-message)))
    (should-not (string-match-p "unsaved" (my-disk-header-line 100)))))

(ert-deftest my-disk-auto-revert-notifies-instead-of-reloading ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (let ((auto-revert--global-mode t)) (auto-revert-handler))
    (should (equal (buffer-string) "one\n"))
    (should my-disk-pending)))

(ert-deftest my-disk-metadata-only-change-is-silent ()
  (my-disk-test "one\n"
    (my-disk-test-write file "one\n")
    (my-disk-check)
    (should-not my-disk-pending)
    (should (verify-visited-file-modtime))
    ;; Unsaved edits: the same bytes rewritten are still the edits' baseline.
    (goto-char (point-max)) (insert "edit\n")
    (my-disk-test-write file "one\n")
    (my-disk-check)
    (should-not my-disk-pending)
    (should (buffer-modified-p))))

(ert-deftest my-disk-repeated-checks-do-not-renotify-until-a-new-change ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (my-disk-later)
    (should-not (plist-get my-disk-pending :expanded))
    (should-not (equal header-line-format '(:eval (my-disk-header-line))))
    (dotimes (_ 3) (my-disk-check))
    (should-not (plist-get my-disk-pending :expanded))
    (my-disk-test-write file "three\n")
    (my-disk-check)
    (should (plist-get my-disk-pending :expanded))
    (should (plist-get my-disk-pending :again))))

(ert-deftest my-disk-modified-buffer-wording-and-keep-writes-nothing ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "theirs\n")
    (my-disk-check)
    (should (string-match-p "Your editor has unsaved changes" (my-disk-message)))
    (let ((mtime (file-attribute-modification-time (file-attributes file))))
      (my-disk-keep)
      (should (equal (my-disk-test-file-text file) "theirs\n"))
      (should (equal mtime (file-attribute-modification-time (file-attributes file)))))
    (should (equal (buffer-string) "one\nmine\n"))
    (should (buffer-modified-p))
    (should-not my-disk-pending)
    ;; A later save still meets Emacs' overwrite protection.
    (should-not (verify-visited-file-modtime))
    (my-disk-check)
    (should-not my-disk-pending)
    (my-disk-test-write file "again\n")
    (my-disk-check)
    (should my-disk-pending)))

(ert-deftest my-disk-keep-marks-clean-buffer-modified ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (my-disk-keep)
    (should (buffer-modified-p))
    (should (equal (my-disk-test-file-text file) "two\n"))))

(ert-deftest my-disk-reload-keeps-a-recovery-copy-after-confirmation ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "theirs\n")
    (my-disk-check)
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
      (should-error (my-disk-reload) :type 'user-error))
    (should (equal (buffer-string) "one\nmine\n"))
    (should-not (file-exists-p my-disk-recovery-directory))
    (let (asked)
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) (setq asked t))))
        (my-disk-reload))
      (should asked))
    (should (equal (buffer-string) "theirs\n"))
    (should-not (buffer-modified-p))
    (should-not my-disk-pending)
    (let ((copies (directory-files my-disk-recovery-directory t "\\`retry\\.go\\.")))
      (should (= (length copies) 1))
      (should (equal (my-disk-test-file-text (car copies)) "one\nmine\n")))))

(ert-deftest my-disk-reload-of-clean-buffer-does-not-ask ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) (error "Asked"))))
      (my-disk-reload))
    (should (equal (buffer-string) "two\n"))
    (should-not (file-exists-p my-disk-recovery-directory))))

(ert-deftest my-disk-stale-reload-refreshes-instead-of-applying ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "v2\n")
    (my-disk-check)
    (my-disk-later)
    (my-disk-test-write file "v3\n")
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
      (my-disk-reload))
    (should (equal (buffer-string) "one\nmine\n"))
    (should (plist-get my-disk-pending :expanded))
    (should (plist-get my-disk-pending :again))
    (should-not (file-exists-p my-disk-recovery-directory))))

(ert-deftest my-disk-deleted-file-keeps-editor-text ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (delete-file file)
    (my-disk-check)
    (should (eq (plist-get my-disk-pending :hash) 'missing))
    (should (string-match-p "deleted or cannot be read" (my-disk-message)))
    (my-disk-later)
    (my-disk-check)
    (should-not (plist-get my-disk-pending :expanded))
    (should-error (my-disk-reload) :type 'user-error)
    (should (equal (buffer-string) "one\nmine\n"))
    (should (buffer-modified-p))))

(ert-deftest my-disk-skips-remote-and-internal-buffers ()
  (with-temp-buffer
    (setq buffer-file-name "/ssh:host:/tmp/x.go")
    (should-not (my-disk-covered-p)))
  (with-temp-buffer
    (should-not (my-disk-covered-p))))

(ert-deftest my-disk-compare-uses-snapshots-and-restores-layout ()
  (my-disk-test "one\n"
    (switch-to-buffer buffer)
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "theirs\n")
    (my-disk-check)
    (let ((windows (length (window-list)))
          (mtime (file-attribute-modification-time (file-attributes file))))
      (my-disk-compare)
      (let ((control (plist-get my-disk-compare :control)))
        (should (buffer-live-p control))
        (should (get-buffer "*Disk Version: retry.go*"))
        (should (equal (with-current-buffer "*Disk Version: retry.go*" (buffer-string)) "theirs\n"))
        ;; A write during comparison is noticed without changing the snapshot.
        (my-disk-test-write file "fourth\n")
        (my-disk-check buffer)
        (should (plist-get (buffer-local-value 'my-disk-pending buffer) :again))
        (should (equal (with-current-buffer "*Disk Version: retry.go*" (buffer-string)) "theirs\n"))
        (should (string-match-p "Outdated" (with-current-buffer "*Disk Version: retry.go*"
                                             (my-disk-snapshot-header))))
        (setq mtime (file-attribute-modification-time (file-attributes file)))
        (with-current-buffer control (ediff-really-quit nil)))
      (should-not (get-buffer "*Disk Version: retry.go*"))
      (should (eq (window-buffer) buffer))
      (should (= windows (length (window-list))))
      (should (equal (buffer-string) "one\nmine\n"))
      (should (equal (my-disk-test-file-text file) "fourth\n"))
      (should (equal mtime (file-attribute-modification-time (file-attributes file)))))))

(defun my-disk-test-write-once-after (function file text)
  "Make the next return from FUNCTION be followed by an external write of TEXT."
  (let (advice)
    (setq advice (lambda (result)
                   (advice-remove function advice)
                   (my-disk-test-write file text)
                   result))
    (advice-add function :filter-return advice)))

(ert-deftest my-disk-write-during-check-is-not-acknowledged ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "one\n")
    ;; The bytes read match the edits' baseline, but another write lands before acknowledging.
    (my-disk-test-write-once-after 'my-disk-read file "theirs\n")
    (my-disk-check)
    (should-not my-disk-pending)
    (should-not (verify-visited-file-modtime))
    (let (asked)
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (setq asked t) nil)))
        (should-error (save-buffer)))
      (should asked))
    (should (equal (my-disk-test-file-text file) "theirs\n"))
    (my-disk-check)
    (should my-disk-pending)))

(ert-deftest my-disk-read-retries-a-file-changing-while-read ()
  (my-disk-test "one\n"
    (my-disk-test-write-once-after 'insert-file-contents-literally file "theirs\n")
    (pcase-let ((`(,hash ,bytes ,meta) (my-disk-read)))
      (should (equal bytes "theirs\n"))
      (should (equal hash (secure-hash 'sha1 "theirs\n")))
      (should (equal meta (my-disk-meta file))))))

(ert-deftest my-disk-write-during-recovery-copy-is-not-loaded ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "v2\n")
    (my-disk-check)
    (my-disk-test-write-once-after 'my-disk-save-recovery file "v3\n")
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
      (my-disk-reload))
    (should (equal (buffer-string) "one\nmine\n"))
    (should (buffer-modified-p))
    (should (plist-get my-disk-pending :again))
    (should (equal (plist-get my-disk-pending :hash) (secure-hash 'sha1 "v3\n")))
    (should-not (verify-visited-file-modtime))
    (let ((copies (directory-files my-disk-recovery-directory t "\\`retry\\.go\\.")))
      (should (equal (mapcar #'my-disk-test-file-text copies) '("one\nmine\n"))))
    ;; Reviewing v3 and reloading again applies exactly v3; later writes stay detectable.
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
      (my-disk-reload))
    (should (equal (buffer-string) "v3\n"))
    (should-not (buffer-modified-p))
    (should (verify-visited-file-modtime))
    (my-disk-test-write file "v4\n")
    (my-disk-check)
    (should my-disk-pending)))

(ert-deftest my-disk-reload-keeps-point-and-encoding ()
  (my-disk-test "alpha\nbeta\ngamma\n"
    (search-forward "gam")
    (my-disk-test-write file "alpha\ninserted\nbeta\ngamma\n")
    (my-disk-check)
    (let ((coding buffer-file-coding-system))
      (my-disk-reload)
      (should (eq coding buffer-file-coding-system)))
    (should (looking-at "ma"))
    (should (equal (buffer-string) "alpha\ninserted\nbeta\ngamma\n"))))

(defun my-disk-test-header-actions (header)
  (let (actions)
    (dotimes (i (length header))
      (when-let* ((action (get-text-property i 'my-disk-action header)))
        (cl-pushnew action actions)))
    actions))

(ert-deftest my-disk-header-keeps-actions-visible-in-narrow-windows ()
  (my-disk-test "one\n"
    (set-visited-file-name (expand-file-name "a-rather-long-file-name_for_retry_handler_test.go" dir) t)
    (goto-char (point-max)) (insert "mine\n")
    (setq my-disk-pending (list :hash "x" :expanded t))
    (dolist (width '(80 90 100 150))
      (let ((header (my-disk-header-line width)))
        (should (<= (string-width header) width))
        (should (cl-subsetp '(my-disk-compare my-disk-reload my-disk-keep my-disk-later)
                            (my-disk-test-header-actions header)))
        (should (string-match-p "unsaved edits" header))
        (should (string-match-p "Changed on disk" header))))
    (should (string-match-p "\\[Reload from Disk\\]" (my-disk-header-line 150)))
    ;; Too narrow even for short labels: one menu holds every action.
    (let ((header (my-disk-header-line 40)))
      (should (<= (string-width header) 40))
      (should (equal (my-disk-test-header-actions header) '(my-disk-choose))))
    (should (equal (lookup-key global-map (kbd "C-c d m")) #'my-disk-choose))
    (set-buffer-modified-p nil)))

(ert-deftest my-disk-write-during-baseline-capture-is-not-adopted ()
  (my-disk-test "A\n"
    ;; Lands after the modification-time check, before the baseline read.
    (let (advice)
      (setq advice (lambda (&rest _)
                     (advice-remove 'my-disk-read advice)
                     (my-disk-test-write file "B\n")))
      (advice-add 'my-disk-read :before advice))
    (goto-char (point-max)) (insert "local\n")
    (should-not my-disk-baseline)
    (should (equal (buffer-string) "A\nlocal\n"))
    (my-disk-check)
    (should (equal (plist-get my-disk-pending :hash) (secure-hash 'sha1 "B\n")))
    (should-not (verify-visited-file-modtime))
    (let (asked)
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (setq asked t) nil)))
        (should-error (save-buffer)))
      (should asked))
    (should (equal (my-disk-test-file-text file) "B\n"))
    (should (equal (buffer-string) "A\nlocal\n"))
    (should (buffer-modified-p))
    (should my-disk-pending)))
