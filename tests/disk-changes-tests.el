;;; disk-changes-tests.el --- External file change review -*- lexical-binding: t; -*-
(require 'ert)
(load (expand-file-name "../disk-changes.el" (file-name-directory load-file-name)) nil t)

(defvar my-disk-test-tick 0)

(defun my-disk-test-write (file text)
  "Write TEXT to FILE as another program would, with a distinct timestamp."
  (let ((coding-system-for-write 'utf-8-unix))
    (write-region text nil file nil 'silent))
  (set-file-times file (time-add nil (cl-incf my-disk-test-tick))))

(defmacro my-disk-test (text &rest body)
  (declare (indent 1))
  `(let* ((dir (make-temp-file "emacs-disk-" t))
          (file (expand-file-name "retry.go" dir))
          (my-disk-recovery-directory (expand-file-name "recovery/" dir))
          buffer)
     (unwind-protect
         (progn
           (my-disk-test-write file ,text)
           (setq buffer (find-file-noselect file))
           (with-current-buffer buffer ,@body))
       (when (buffer-live-p buffer)
         (with-current-buffer buffer (set-buffer-modified-p nil))
         (kill-buffer buffer))
       (delete-directory dir t))))

(defun my-disk-test-file-text (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest my-disk-detects-change-in-clean-buffer-without-reloading ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (should my-disk-pending)
    (should (plist-get my-disk-pending :expanded))
    (should (equal (buffer-string) "one\n"))
    (should-not (buffer-modified-p))
    (should (string-match-p "retry\\.go has external changes\\." (my-disk-message)))
    (should-not (string-match-p "unsaved" (my-disk-header-line 100)))))

(ert-deftest my-disk-auto-revert-notifies-instead-of-reloading ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (let ((auto-revert--global-mode t)) (auto-revert-handler))
    (should (equal (buffer-string) "one\n"))
    (should my-disk-pending)))

(ert-deftest my-disk-metadata-only-change-is-silent ()
  (my-disk-test "one\n"
    (my-disk-test-write file "one\n")
    (my-disk-check)
    (should-not my-disk-pending)
    (should (verify-visited-file-modtime))
    ;; Unsaved edits: the same bytes rewritten are still the edits' baseline.
    (goto-char (point-max)) (insert "edit\n")
    (my-disk-test-write file "one\n")
    (my-disk-check)
    (should-not my-disk-pending)
    (should (buffer-modified-p))))

(ert-deftest my-disk-repeated-checks-do-not-renotify-until-a-new-change ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (my-disk-later)
    (should-not (plist-get my-disk-pending :expanded))
    (should-not (equal header-line-format '(:eval (my-disk-header-line))))
    (dotimes (_ 3) (my-disk-check))
    (should-not (plist-get my-disk-pending :expanded))
    (my-disk-test-write file "three\n")
    (my-disk-check)
    (should (plist-get my-disk-pending :expanded))
    (should (plist-get my-disk-pending :again))))

(ert-deftest my-disk-modified-buffer-wording-and-keep-writes-nothing ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "theirs\n")
    (my-disk-check)
    (should (string-match-p "Your editor has unsaved changes" (my-disk-message)))
    (let ((mtime (file-attribute-modification-time (file-attributes file))))
      (my-disk-keep)
      (should (equal (my-disk-test-file-text file) "theirs\n"))
      (should (equal mtime (file-attribute-modification-time (file-attributes file)))))
    (should (equal (buffer-string) "one\nmine\n"))
    (should (buffer-modified-p))
    (should-not my-disk-pending)
    ;; A later save still meets Emacs' overwrite protection.
    (should-not (verify-visited-file-modtime))
    (my-disk-check)
    (should-not my-disk-pending)
    (my-disk-test-write file "again\n")
    (my-disk-check)
    (should my-disk-pending)))

(ert-deftest my-disk-keep-marks-clean-buffer-modified ()
  (my-disk-test "one\n"
    (my-disk-test-write file "two\n")
    (my-disk-check)
    (my-disk-keep)
    (should (buffer-modified-p))
    (should (equal (my-disk-test-file-text file) "two\n"))))

(ert-deftest my-disk-reload-keeps-a-recovery-copy-after-confirmation ()
  (my-disk-test "one\n"
    (goto-char (point-max)) (insert "mine\n")
    (my-disk-test-write file "theirs\n")
    (my-disk-check)
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
      (should-error (my-disk-reload) :type 'user-error))
    (should (equal (buffer-string) "one\nmine\n"))
    (should-not (file-exists-p my-disk-recovery-directory))
    (let (asked)
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) (setq asked t))))
        (my-disk-reload))
      (should asked))
    (should (equal (buffer-string) "theirs\n"))
    (should-not (buffer-modified-p))
    (should-not my-disk-pending)
    (let ((copies (directory-files my-disk-recovery-directory t "\\`retry\\.go\\.")))
      (should (= (length copies) 1))
      (should (equal (my-disk-test-file-text (car copies)) "one\nmine\n")))))

(ert-deftest my-disk-reload-of-clean-buffer-does-not-ask ()
