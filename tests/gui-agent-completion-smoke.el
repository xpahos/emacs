;;; gui-agent-completion-smoke.el --- Corfu popup in the Pi panel -*- lexical-binding: t; -*-
;; Keys go through the real command loop (unread-command-events), one step per timer tick.
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "Test home required"))))
(redisplay t)
(load (expand-file-name "init.el" (expand-file-name ".." (file-name-directory load-file-name))) nil t)
(require 'ert)

(defvar my-test-chat nil)
(defvar my-test-layout nil)
(defvar my-test-long (concat "Review the current change for bugs. " (make-string 300 ?x) " END-OF-DESCRIPTION"))
(defvar my-test-streaming nil)
(defvar my-test-release (expand-file-name "release-files" user-emacs-directory))
(advice-add 'my-project-search-source :around
            (lambda (original root)
              (if my-test-streaming
                  (list root "sh" "-c"
                        (concat "printf '"
                                (mapconcat (lambda (i) (format "early%02d.txt\\0" i))
                                           (number-sequence 1 20) "")
                                "'; while ! test -f " (shell-quote-argument my-test-release)
                                "; do sleep 0.05; done; printf 'late file.txt\\0'"))
                (funcall original root))))

(defun my-test-layout ()
  (list (frame-native-height) (frame-parameter nil 'tab-bar-lines)
        (mapcar (lambda (w) (list w (window-pixel-width w) (window-pixel-height w))) (window-list nil t))))

(defun my-test-keys (keys)
  (setq unread-command-events (append unread-command-events (listify-key-sequence (kbd keys)))))

(defun my-test-input ()
  (buffer-substring-no-properties (agent-shell--prompt-input-start) (point-max)))

(defun my-test-popup-ok ()
  "Popup visible, inside the frame, focus and layout unchanged."
  (should (frame-live-p corfu--frame))
  (should (frame-visible-p corfu--frame))
  (should (eq (selected-frame) (frame-parent corfu--frame)))
  (should (eq (window-buffer (selected-window)) my-test-chat))
  (should-not (get-buffer-window "*Completions*"))
  (should (equal (my-test-layout) my-test-layout))
  (pcase-let ((`(,x . ,y) (frame-position corfu--frame)))
    (should (>= x 0)) (should (>= y 0))
    (should (<= (+ x (frame-pixel-width corfu--frame)) (frame-native-width)))
    (should (<= (+ y (frame-pixel-height corfu--frame)) (frame-native-height))))
  (should (<= (with-current-buffer (window-buffer (frame-root-window corfu--frame))
                (count-lines (point-min) (point-max)))
              10)))

(defun my-test-clear ()
  (delete-region (agent-shell--prompt-input-start) (point-max)))

(defvar my-test-steps
  (list
   ;; Style matches popup-style.el.
   (lambda ()
     (should corfu-mode)
     (should-not (with-current-buffer "*scratch*" corfu-mode))
     (should (equal (face-background 'corfu-default nil t) (face-background 'tooltip nil t)))
     (should (equal (face-background 'corfu-border nil t) (face-background 'child-frame-border nil t)))
     (should (equal (face-background 'corfu-current nil t) (face-background 'region nil t)))
     (should-not (equal (face-background 'corfu-current nil t) (face-background 'corfu-default nil t)))
     (map-put! (agent-shell--state) :available-commands
               (append `(((name . "review") (description . ,my-test-long))
                         ((name . "reload") (description . "Reload extensions")))
                       (mapcar (lambda (i) `((name . ,(format "zfiller%02d" i)) (description . "Filler")))
                               (number-sequence 1 15))))
     (goto-char (point-max))
     (recenter -1)  ; prompt at the bottom of the side panel
     (message nil))
   (lambda ()
     (should (= (window-end nil t) (point-max)))
     (setq my-test-layout (my-test-layout))
     (my-test-keys "/"))
   ;; / pops at most 10 rows with a single-line, truncated description.
   (lambda ()
     (my-test-popup-ok)
     (should (= (length corfu--candidates) 17))
     (let ((rows (with-current-buffer (window-buffer (frame-root-window corfu--frame)) (buffer-string))))
       (should (string-match-p "review" rows))
       (should-not (string-match-p "END-OF-DESCRIPTION" rows))
       (should (string-match-p "…" rows)))
     (my-test-keys "<down>"))
   (lambda ()
     (my-test-popup-ok)
     (should (= corfu--index 1))
     (should (equal (my-test-input) "/"))
     ;; A background reply shifts the prompt while completion is open.
     (let ((inhibit-read-only t))
       (save-excursion (goto-char (point-min)) (insert "Background update\n")))
     (my-test-keys "<up>"))
   (lambda ()
     (my-test-popup-ok)
     (should (= corfu--index 0))
     (should (equal (my-test-input) "/"))
     (my-test-keys "r e x"))
   ;; An unmatched prefix must recover when erased back to /.
   (lambda ()
     (should (equal (my-test-input) "/rex"))
     (my-test-keys "DEL DEL DEL"))
   (lambda ()
     (my-test-popup-ok)
     (should (= (length corfu--candidates) 17))
     (should (equal (my-test-input) "/"))
     (my-test-keys "DEL"))
   (lambda ()
     (should-not completion-in-region-mode)
     (should (equal (my-test-input) ""))
     (my-test-keys "/ r e"))
   ;; Filtering while typing; full description in the info popup.
   (lambda ()
     (my-test-popup-ok)
     (should (equal (sort (copy-sequence corfu--candidates) #'string<) '("reload" "review")))
     (should (equal (my-test-input) "/re"))
     (my-test-keys "<down>"))
   ;; Arrow moves the selection; its full description shows in the info popup.
   (lambda ()
     (should (= corfu--index 1))
     (should (equal (nth corfu--index corfu--candidates) "review")))
   (lambda ()
     (should (frame-visible-p corfu-popupinfo--frame))
     (should (string-match-p "END-OF-DESCRIPTION"
                             (with-current-buffer (window-buffer (frame-root-window corfu-popupinfo--frame))
                               (buffer-string))))
     (pcase-let ((`(,x . ,y) (frame-position corfu-popupinfo--frame)))
       (should (>= x 0)) (should (>= y 0))
       (should (<= (+ x (frame-pixel-width corfu-popupinfo--frame)) (frame-native-width)))
       (should (<= (+ y (frame-pixel-height corfu-popupinfo--frame)) (frame-native-height))))
     (should (equal (my-test-layout) my-test-layout))
     (my-test-keys "<tab>"))
   ;; Tab inserts without submitting.
   (lambda ()
     (should-not (and corfu--frame (frame-visible-p corfu--frame)))
     (should (equal (my-test-input) "/review "))
     (should-not (map-elt (agent-shell--state) :pending-prompts))
     (should (equal (my-test-layout) my-test-layout))
     (my-test-clear)
     (my-test-keys "/"))
   ;; Escape cancels and keeps the typed text.
   (lambda () (my-test-popup-ok) (my-test-keys "<escape>"))
   (lambda ()
     (should-not (frame-visible-p corfu--frame))
     (should (equal (my-test-input) "/"))
     (should (eq (window-buffer (selected-window)) my-test-chat))
     (my-test-clear)
     (my-test-keys "@ q q q"))
   ;; File completion also recovers after a prefix with no matches.
   (lambda ()
     (should (equal (my-test-input) "@qqq"))
     (my-test-keys "DEL DEL DEL"))
   (lambda ()
     (my-test-await (member "src/main.el" corfu--candidates))
     (my-test-popup-ok)
     (should (member "src/main.el" corfu--candidates))
     (should (equal (my-test-input) "@"))
     (my-test-keys "M y"))
   ;; File completion of a path containing a space.
   (lambda ()
     (my-test-popup-ok)
     (should (member "My Design.png" corfu--candidates))
     (should-not (member "src/main.el" corfu--candidates))
     (my-test-keys "RET"))
   (lambda ()
     (should (equal (my-test-input) "@\"My Design.png\" "))
     (should-not (map-elt (agent-shell--state) :pending-prompts))
     (my-test-clear)
     (my-test-keys "@"))
   ;; Resizing the frame while the popup is up keeps it inside the frame.
   (lambda ()
     (my-test-popup-ok)
     (should (member "src/main.el" corfu--candidates))
     (set-frame-size nil 110 30))
   (lambda ()
     (when (frame-visible-p corfu--frame)
       (pcase-let ((`(,x . ,y) (frame-position corfu--frame)))
         (should (<= (+ x (frame-pixel-width corfu--frame)) (frame-native-width)))
         (should (<= (+ y (frame-pixel-height corfu--frame)) (frame-native-height)))))
     (setq my-test-resize-visible (frame-visible-p corfu--frame))
     (setq my-test-layout (my-test-layout))
     (my-test-keys "s r c"))
   (lambda ()
     (my-test-popup-ok)
     (should (member "src/main.el" corfu--candidates))
     (my-test-keys "<escape>"))
   ;; Compose buffer gets the same popup.
   (lambda ()
     (my-test-clear)
     (agent-shell-prompt-compose))
   (lambda ()
     (should (derived-mode-p 'agent-shell-viewport-edit-mode))
     (should corfu-mode)
     (setq my-test-chat (current-buffer) my-test-layout (my-test-layout))
     (my-test-keys "@ s r c"))
   (lambda ()
     (my-test-popup-ok)
     (should (member "src/main.el" corfu--candidates))
     (my-test-keys "<tab>"))
   (lambda ()
     (should (string-suffix-p "@src/main.el " (buffer-string)))
     (erase-buffer)
     (setq my-test-streaming t)
     (my-test-keys "@"))
   ;; First batch is usable before the rest of the directory arrives.
   (lambda ()
     (my-test-await (and corfu--candidates (= (length corfu--candidates) 20)))
     (my-test-popup-ok)
     (should (= (length corfu--candidates) 20))
     (should (seq-some (lambda (p) (and (process-live-p p)
                                       (equal (process-name p) "agent-files")))
                      (process-list)))
     (my-test-keys "l a t e"))
   (lambda ()
     (should completion-in-region-mode)
     (should-not corfu--candidates)
     (write-region "" nil my-test-release nil 'silent))
   (lambda ()
     (my-test-await (equal corfu--candidates '("late file.txt")))
     (my-test-popup-ok)
     (should (equal corfu--candidates '("late file.txt")))
     (my-test-keys "<tab>"))
   (lambda ()
     (should (equal (buffer-string) "@\"late file.txt\" "))
     (should-not my-agent-file-table)
     (setq my-test-streaming nil)
     'done)))

(defvar my-test-cmd nil)
(defvar my-test-resize-visible nil)
(defvar my-test-step-count (length my-test-steps))
(define-error 'my-test-wait "Waiting for asynchronous results")
(defvar my-test-wait-start nil)
(defun my-test-await (ready)
  (unless ready
    (unless my-test-wait-start (setq my-test-wait-start (float-time)))
    (if (< (- (float-time) my-test-wait-start) 5)
        (signal 'my-test-wait nil)
      (ert-fail "Timed out waiting for asynchronous results"))))

(defun my-test-fail (err)
  (with-temp-file (expand-file-name "failure" user-emacs-directory)
    (prin1 (list err :step (1+ (- my-test-step-count (length my-test-steps))) :buffer (buffer-name)
                 :input (ignore-errors (with-current-buffer my-test-chat (my-test-input)))
                 :files (ignore-errors (with-current-buffer my-test-chat (agent-shell--project-files)))
                 :styles completion-styles
                 :cands (seq-take corfu--candidates 5)
                 :echo (current-message)
                 :table (with-current-buffer my-test-chat
                          (when my-agent-file-table (all-completions "" my-agent-file-table)))
                 :geo (ignore-errors
                        (mapcar (lambda (f) (list (frame-parameter f 'corfu--geometry) (frame-position f)
                                                  (frame-pixel-width f) (frame-parameter f 'left-fringe)
                                                  (frame-parameter f 'right-fringe)))
                                (list corfu--frame corfu-popupinfo--frame)))
                 :dir corfu-popupinfo--lock-dir :parent (list (frame-pixel-width) (frame-native-width) (frame-native-width))
                 :messages (with-current-buffer "*Messages*" (buffer-substring (max 1 (- (point-max) 1500)) (point-max))))
           (current-buffer)))
  (kill-emacs 1))

(defun my-test-run ()
  ;; Redisplay inside Corfu can run timers before candidate computation finishes.
  (if (or unread-command-events (not (waiting-for-user-input-p))
          (and completion-in-region-mode
               (pcase-let ((`(,beg ,end . ,_) completion-in-region--data))
                 (or (> beg end)
                     (not (equal (car corfu--input)
                                 (with-current-buffer (window-buffer (selected-window))
                                   (buffer-substring-no-properties beg end))))))))
      (run-with-timer 0.1 nil #'my-test-run)
    (condition-case err
      (with-current-buffer (window-buffer (selected-window))
        (if (eq (funcall (car my-test-steps)) 'done)
            (progn
              (with-temp-file (expand-file-name "passed" user-emacs-directory)
                (insert (format "Agent completion passed: streaming, selection colors and recovery after no matches (popup %s after resize).\n"
                                (if my-test-resize-visible "repositioned" "closed"))))
              (dolist (shell (agent-shell-buffers))
                (with-current-buffer shell (agent-shell--shutdown)))
              (kill-emacs 0))
          (pop my-test-steps)
          (setq my-test-wait-start nil)
          (run-with-timer 0.8 nil #'my-test-run)))
      (my-test-wait (run-with-timer 0.1 nil #'my-test-run))
      (error (my-test-fail err)))))

(defun my-test-start ()
  (condition-case err
      (let* ((root (expand-file-name "proj/" user-emacs-directory))
             (test-home (expand-file-name "pi-home/" user-emacs-directory))
             (agent-shell-pi-environment
              (list (concat "HOME=" test-home)
                    (concat "PI_CODING_AGENT_DIR=" test-home "agent")
                    "ANTHROPIC_API_KEY=completion-test-placeholder")))
        (make-directory (expand-file-name "src" root) t)
        (make-directory test-home t)
        (dolist (f '("My Design.png" "src/main.el" "README.md"))
          (write-region "" nil (expand-file-name f root)))
        (call-process "git" nil nil nil "init" "-q" root)
        (set-frame-size nil 160 45)
        (my-project-open root)
        (my-pi-toggle)
        (setq my-test-chat (current-buffer))
        (let ((deadline (+ (float-time) 25)))
          (while (and (not (agent-shell-initialized-p :shell-buffer my-test-chat))
                      (< (float-time) deadline))
            (accept-process-output nil 0.1)))
        (should (agent-shell-initialized-p :shell-buffer my-test-chat))
        (run-with-timer 0.5 nil #'my-test-run))
    (error (my-test-fail err))))

(add-hook 'emacs-startup-hook (lambda () (run-with-timer 1 nil #'my-test-start)))
