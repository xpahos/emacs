;;; overview-tests.el --- Whole-file marker checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(load "/Volumes/Sources/emacs/overview.el" nil t)

(ert-deftest my-overview-collects-diagnostics-and-hunks-outside-narrowing ()
  (with-temp-buffer
    (dotimes (i 100) (insert (format "line %d\n" (1+ i))))
    (let* ((beg (progn (goto-char (point-min)) (forward-line 79) (point)))
           (end (progn (forward-line 3) (point)))
           (diagnostic (flymake-make-diagnostic (current-buffer) beg (1+ beg)
                                               :error "Example"))
           (d (make-overlay beg (1+ beg)))
           (h (make-overlay beg end)))
      (overlay-put d 'flymake-diagnostic diagnostic)
      (overlay-put h 'diff-hl-hunk t)
      (overlay-put h 'diff-hl-hunk-type 'change)
      (narrow-to-region 1 10)
      (let* ((data (my-overview-data))
             (marks (cdr data)))
        (should (= (car data) 101))
        (should (member (list 80 80 'error beg) marks))
        (should (member (list 80 82 'change beg) marks))
        (should (eq data (my-overview-data)))
        (delete-overlay h)
        (should (= (length (cdr (my-overview-data))) 1))
        (should (= (point-max) 10))))))

(ert-deftest my-overview-refreshes-on-text-and-diagnostic-changes ()
  (with-temp-buffer
    (insert "a\nb\nc\n")
    (let ((h (make-overlay 3 4)))
      (overlay-put h 'diff-hl-hunk t)
      (overlay-put h 'diff-hl-hunk-type 'insert)
      (should (= (caar (cdr (my-overview-data))) 2))
      (goto-char 1)
      (insert "new\n")
      (should (= (caar (cdr (my-overview-data))) 3))
      (overlay-put h 'diff-hl-hunk-type 'delete)
      (should (eq (nth 2 (cadr (my-overview-data))) 'delete)))))

(ert-deftest my-overview-click-selects-the-correct-lane ()
  (let ((data '(101 (20 20 error 100) (80 82 change 500))))
    (should (= (my-overview-target data 200 3 38) 100))
    (should (= (my-overview-target data 200 12 158) 500))
    (should-not (my-overview-target data 200 3 158))))

(ert-deftest my-overview-empty-file-and-bottom-mark ()
  (with-temp-buffer (should (equal (my-overview-data) '(1))))
  (should (= (my-overview-y 1 1 200) 0))
  (should (= (my-overview-y 101 101 200) 197)))
