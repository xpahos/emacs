;;; keyboard-tests.el --- Modified keys across keyboard layouts -*- lexical-binding: t; -*-
(require 'ert)
(load (expand-file-name "../keyboard.el" (file-name-directory load-file-name)) nil t)

(defun my-keyboard-test-read (keys)
  (let ((unread-command-events (append (kbd keys) nil)))
    (read-key-sequence-vector "")))

(ert-deftest my-keyboard-russian-shortcuts-preserve-modifiers ()
  (dolist (pair '(("s-с" . "s-c") ("s-м" . "s-v") ("s-С" . "s-C")
                  ("M-ч" . "M-x") ("C-ч C-ы" . "C-x C-s")
                  ("C-M-а" . "C-M-f") ("s-х" . "s-[") ("s-Х" . "s-{")))
    (should (equal (my-keyboard-test-read (car pair)) (vconcat (kbd (cdr pair)))))))

(ert-deftest my-keyboard-plain-russian-and-english-are-unchanged ()
  (dolist (key '("с" "м" "Я" "ё" "s-c" "s-v" "M-x"))
    (should (equal (my-keyboard-test-read key) (vconcat (kbd key))))))

(ert-deftest my-keyboard-translations-use-local-bindings ()
  (with-temp-buffer
    (use-local-map (make-sparse-keymap))
    (local-set-key (kbd "s-c") #'copy-region-as-kill)
    (local-set-key (kbd "s-v") #'yank)
    (should (eq (key-binding (my-keyboard-test-read "s-с")) #'copy-region-as-kill))
    (should (eq (key-binding (my-keyboard-test-read "s-м")) #'yank))))

(ert-deftest my-keyboard-block-shift-uses-four-spaces-and-preserves-nesting ()
  (with-temp-buffer
    (text-mode)
    (insert "one\n    two\nthree\n")
    (indent-rigidly-right-to-tab-stop (point-min) (point-max))
    (should (equal (buffer-string) "    one\n        two\n    three\n"))
    (indent-rigidly-left-to-tab-stop (point-min) (point-max))
    (should (equal (buffer-string) "one\n    two\nthree\n"))))

(ert-deftest my-keyboard-go-indents-with-four-column-tabs ()
  (require 'go-ts-mode)
  (let ((treesit-extra-load-path (cons "/opt/local/lib" treesit-extra-load-path)))
    (skip-unless (treesit-ready-p 'go t))
    (with-temp-buffer
      (go-ts-mode)
      (insert "package main\nfunc main() {\nprintln(1)\n}\n")
      (indent-region (point-min) (point-max))
      (should (= tab-width 4))
      (should (equal (buffer-string) "package main\nfunc main() {\n\tprintln(1)\n}\n")))))

(ert-deftest my-keyboard-tab-shifts-only-current-line-and-keeps-text-position ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/indent-test.txt")
    (text-mode)
    (insert "first\n  second\nthird\n")
    (goto-char (point-min))
    (search-forward "sec")
    (call-interactively (key-binding [tab]))
    (should (equal (buffer-string) "first\n      second\nthird\n"))
    (should (eq (char-after) ?o))
    (call-interactively (key-binding [backtab]))
    (should (equal (buffer-string) "first\n  second\nthird\n"))
    (should (eq (char-after) ?o))
    (call-interactively (key-binding [backtab]))
    (call-interactively (key-binding [backtab]))
    (should (equal (buffer-string) "first\nsecond\nthird\n"))))

(ert-deftest my-keyboard-tab-indents-empty-line-and-leaves-nonfile-maps-alone ()
  (with-temp-buffer
    (text-mode)
    (should-not (eq (key-binding (kbd "TAB")) 'my-editing-tab))
    (setq buffer-file-name "/tmp/indent-test.txt")
    (my-editing-indent-setup)
    (call-interactively (key-binding (kbd "TAB")))
    (should (equal (buffer-string) "    "))
    (should (= (current-column) 4))
    (call-interactively (key-binding [S-tab]))
    (should (equal (buffer-string) ""))))

(ert-deftest my-keyboard-tab-keeps-syntactic-indentation-for-selection ()
  (require 'go-ts-mode)
  (let ((treesit-extra-load-path (cons "/opt/local/lib" treesit-extra-load-path))
        (transient-mark-mode t))
    (skip-unless (treesit-ready-p 'go t))
    (with-temp-buffer
      (setq buffer-file-name "/tmp/indent-test.go")
      (go-ts-mode)
      (insert "package main\nfunc main() {\nprintln(1)\n}\n")
      (set-mark (point-min))
      (activate-mark)
      (call-interactively (key-binding [tab]))
      (should (equal (buffer-string) "package main\nfunc main() {\n\tprintln(1)\n}\n")))))

(ert-deftest my-keyboard-makefile-keeps-required-recipe-tabs ()
  (with-temp-buffer
    (makefile-mode)
    (insert "all:\n")
    (call-interactively #'indent-for-tab-command)
    (should (equal (buffer-string) "all:\n\t"))))
