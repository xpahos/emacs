;;; markdown-view-tests.el --- Markdown switching checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defvar my-markdown-test-root
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(add-to-list 'treesit-extra-load-path (expand-file-name "tree-sitter" my-markdown-test-root))
(load (expand-file-name "markdown-view.el" my-markdown-test-root) t t)

(ert-deftest my-markdown-preview-does-not-edit-source ()
  (dolist (text '("" "# Привет **мир**" "# Title\n\nText\n"))
    (with-temp-buffer
      (insert text)
      (buffer-enable-undo)
      (set-buffer-modified-p nil)
      (my-markdown-open)
      (should (eq major-mode 'markdown-ts-view-mode))
      (font-lock-ensure)
      (should buffer-read-only)
      (should-error (insert "x") :type 'buffer-read-only)
      (my-markdown-toggle)
      (should (eq major-mode 'markdown-ts-mode))
      (should-not buffer-read-only)
      (should-not markdown-ts-hide-markup)
      (my-markdown-toggle)
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) text))
      (should-not (buffer-modified-p))
      (should-not buffer-undo-list))))

(ert-deftest my-markdown-switch-keeps-edits-and-undo ()
  (with-temp-buffer
    (insert "# Original\n")
    (buffer-enable-undo)
    (set-buffer-modified-p nil)
    (my-markdown-open)
    (my-markdown-toggle)
    (goto-char (point-max))
    (insert "Правка")
    (undo-boundary)
    (let ((history buffer-undo-list))
      (my-markdown-toggle)
      (my-markdown-toggle)
      (should (equal history buffer-undo-list)))
    (should (buffer-modified-p))
    (should (equal (buffer-substring-no-properties (point-min) (point-max)) "# Original\nПравка"))
    (undo 1)
    (should (equal (buffer-substring-no-properties (point-min) (point-max)) "# Original\n"))))

(ert-deftest my-markdown-switch-keeps-reading-position ()
  (save-window-excursion
    (with-temp-buffer
      (dotimes (i 150) (insert (format "Paragraph %d\n\n" i)))
      (switch-to-buffer (current-buffer))
      (my-markdown-open)
      (goto-char 600)
      (set-mark 650)
      (narrow-to-region 100 1400)
      (set-window-start nil 400)
      (my-markdown-toggle)
      (should (= (point) 600))
      (should (= (mark) 650))
      (should (= (point-min) 100))
      (should (= (point-max) 1400))
      (should (= (window-start) 400)))))

(ert-deftest my-markdown-preview-renders-and-key-toggles ()
  (with-temp-buffer
    (insert "# Heading\n\n**Bold** and [link](https://example.org)\n\n| A | B |\n|---|---|\n| 1 | 2 |\n")
    (my-markdown-open)
    (font-lock-ensure)
    (goto-char (point-min))
    (should (invisible-p (point)))
    (search-forward "link")
    (should (get-text-property (1- (point)) 'keymap))
    (call-interactively (key-binding (kbd "C-c C-x C-m")))
    (font-lock-ensure)
    (should-not buffer-read-only)
    (should-not (invisible-p (point-min)))
    (call-interactively (key-binding (kbd "C-c C-x C-m")))
    (should buffer-read-only)))

(ert-deftest my-markdown-code-panel-keeps-source-and-cleans-up ()
  (let ((text "Before\n\n```elisp\n(message \"Hello\")\n\n(+ 1 2)\n```\n\nAfter\n"))
    (with-temp-buffer
      (insert text)
      (buffer-enable-undo)
      (set-buffer-modified-p nil)
      (my-markdown-open)
      (font-lock-ensure)
      (let* ((block (seq-find (lambda (ov) (overlay-get ov 'markdown-ts-code-block))
                              (overlays-in (point-min) (point-max))))
             (decorations (seq-filter (lambda (ov) (overlay-get ov 'my-markdown-code-edge))
                                       (overlays-in (point-min) (point-max)))))
        (should (= (length (seq-filter (lambda (ov) (overlay-get ov 'my-markdown-code-cap))
                                       decorations)) 2))
        (should (overlay-get block 'line-prefix))
        (should (= (length decorations) 5))
        (font-lock-flush)
        (font-lock-ensure)
        (should (= (length (seq-filter (lambda (ov) (overlay-get ov 'my-markdown-code-edge))
                                      (overlays-in (point-min) (point-max)))) 5)))
      (my-markdown-toggle)
      (should-not (seq-some (lambda (ov) (overlay-get ov 'my-markdown-code-edge))
                            (overlays-in (point-min) (point-max))))
      (my-markdown-toggle)
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) text))
      (should-not (buffer-modified-p))
      (should-not buffer-undo-list))))

(ert-deftest my-markdown-code-panel-fits-code-with-padding ()
  (with-temp-buffer
    (insert "```\n1234567890\nx\n\n```\n")
    (my-markdown-open)
    (let* ((block (seq-find (lambda (ov) (overlay-get ov 'markdown-ts-code-block))
                            (overlays-in (point-min) (point-max))))
           (prefix (overlay-get block 'line-prefix))
           (edge (seq-find (lambda (ov) (and (overlay-get ov 'my-markdown-code-edge)
                                            (not (overlay-get ov 'my-markdown-code-cap))))
                           (overlays-in (point-min) (point-max))))
           (suffix (overlay-get edge 'before-string))
           (end (plist-get (cdr (get-text-property 0 'display suffix)) :align-to))
           (margin (car (plist-get (cdr (get-text-property 0 'display prefix)) :width)))
           (left (car (plist-get (cdr (get-text-property 1 'display prefix)) :width))))
      (should (= margin 6))
      (should (= left 4))
      (should (= (length prefix) 2))
      (should (numberp (car-safe end)))
      (should (= (- (car end) margin (string-pixel-width "1234567890" (current-buffer)))
                 (+ left 2)))
      (should-not (face-attribute 'markdown-ts-code-block-markup-hidden :extend))
      (dolist (ov (seq-filter (lambda (ov) (overlay-get ov 'my-markdown-code-cap))
                             (overlays-in (point-min) (point-max))))
        (let* ((cap (overlay-get ov 'before-string))
               (display (get-text-property 1 'display cap)))
          (should (= (+ margin (car (plist-get (cdr display) :width))) (car end)))
          (should (equal (plist-get (cdr display) :height) '(5)))
          (should-not (string-match-p "\n" cap))
          (should (eq (char-after (overlay-start ov)) ?\n))
          (should-not (invisible-p (overlay-start ov))))))))

(ert-deftest my-markdown-list-code-hides-only-fence-indentation ()
  (with-temp-buffer
    (insert "- item\n\n  ```sh\n  printf hi\n    nested\n  ```\n")
    (let ((source (buffer-string)))
      (my-markdown-open)
      (goto-char (point-min))
      (search-forward "printf hi")
      (beginning-of-line)
      (should (equal (get-char-property (point) 'display) ""))
      (should-not (get-char-property (+ (point) 2) 'display))
      (forward-line 1)
      (should (equal (get-char-property (point) 'display) ""))
      (should-not (get-char-property (+ (point) 2) 'display))
      (my-markdown-toggle)
      (should-not (get-char-property (point) 'display))
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) source)))))

(ert-deftest my-markdown-wrapped-panel-fills-only-narrow-windows ()
  (save-window-excursion
    (delete-other-windows)
    (with-temp-buffer
      (insert "```\n" (make-string 35 ?x) " конец\nshort\n```\n\n```\ntiny\n```\n")
      (let ((source (buffer-string)))
        (switch-to-buffer (current-buffer))
        (my-markdown-open)
        (goto-char (point-min))
        (forward-line 1)
        (let* ((end (line-end-position))
               (wide (selected-window))
               (narrow (split-window wide -20 t)))
          (my-markdown-update-wrapped-panels wide)
          (my-markdown-update-wrapped-panels narrow)
          (should (eq (get-char-property end 'face wide) 'default))
          (should (plist-get (get-char-property end 'face narrow) :extend))
          (forward-line 1)
          (should (plist-get (get-char-property (line-end-position) 'face narrow) :extend))
          (search-forward "tiny")
          (should (eq (get-char-property (point) 'face narrow) 'default))
          (delete-window wide)
          (my-markdown-update-wrapped-panels narrow)
          (should (eq (get-char-property end 'face narrow) 'default)))
        (my-markdown-toggle)
        (should-not (seq-some (lambda (ov) (overlay-get ov 'my-markdown-code-edge))
                             (overlays-in (point-min) (point-max))))
        (should (equal source (buffer-substring-no-properties (point-min) (point-max))))))))

(ert-deftest my-markdown-missing-grammar-keeps-file-editable ()
  (with-temp-buffer
    (insert "# Heading")
    (cl-letf (((symbol-function 'treesit-language-available-p) (lambda (&rest _) nil)))
      (my-markdown-open))
    (should (eq major-mode 'text-mode))
    (should-not buffer-read-only)
    (should (equal (buffer-string) "# Heading"))))

(ert-deftest my-markdown-file-save-keeps-encoding-and-readonly-file-is-protected ()
  (let ((file (make-temp-file "markdown-file-" nil ".md")) buffer)
    (unwind-protect
        (progn
          (with-temp-file file
            (setq buffer-file-coding-system 'utf-8-dos)
            (insert "# Привет\n\nText\n"))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (should (eq major-mode 'markdown-ts-view-mode))
            (let ((coding buffer-file-coding-system))
              (my-markdown-toggle)
              (goto-char (point-max))
              (insert "New\n")
              (my-markdown-toggle)
              (should (buffer-modified-p))
              (should (eq coding buffer-file-coding-system))
              (save-buffer))
            (set-file-modes file #o444)
            (should-error (my-markdown-toggle) :type 'user-error)
            (should buffer-read-only))
          (with-temp-buffer
            (set-buffer-multibyte nil)
            (insert-file-contents-literally file)
            (should (equal (buffer-string)
                           (encode-coding-string "# Привет\n\nText\nNew\n" 'utf-8-dos)))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (set-file-modes file #o600)
      (delete-file file))))
