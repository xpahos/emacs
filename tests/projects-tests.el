;;; projects-tests.el --- Project workflow checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'package)
(defconst my-test-config-dir
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(setq user-emacs-directory (make-temp-file "emacs-project-tests-" t)
      package-user-dir (expand-file-name "elpa" my-test-config-dir))
(package-initialize)
(load (expand-file-name "projects.el" my-test-config-dir) t t)

(defmacro my-test-projects (&rest body)
  `(let* ((test-root (file-truename (make-temp-file "emacs-folders-" t)))
          (project--list nil)
          (project-list-file (expand-file-name "projects.eld" user-emacs-directory)))
     (unwind-protect
         (progn
           (switch-to-buffer (get-buffer-create "*scratch*"))
           (delete-other-windows)
           (set-frame-parameter nil 'tabs nil)
           (tab-bar-mode 1)
           (tab-bar-rename-tab "Start")
           ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (file-in-directory-p (buffer-file-name buffer) test-root))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (while (> (length (tab-bar-tabs)) 1)
         (tab-bar-close-tab (length (tab-bar-tabs))))
       (delete-directory test-root t))))

(ert-deftest my-project-explicit-root-and-no-repository-writes ()
  (my-test-projects
   (let ((root (expand-file-name "mono/service/" test-root)))
     (make-directory root t)
     (make-directory (expand-file-name "mono/.git" test-root))
     (my-project-open root)
     (should (equal (project-root (project-current nil root)) (file-truename root)))
     (should (equal (directory-files root nil directory-files-no-dot-files-regexp) nil))
     (should (equal (car (project-known-project-roots)) root))
     (should (equal (mapcar #'treemacs-project->path
                           (treemacs-workspace->projects (treemacs-current-workspace)))
                    (list (directory-file-name root)))))))

(ert-deftest my-project-reopen-preserves-tab-and-file ()
  (my-test-projects
   (my-project-open test-root)
   (let ((buffer (find-file-noselect (expand-file-name "notes.txt" test-root))))
     (switch-to-buffer buffer)
     (my-project-home)
     (my-project-open test-root)
     (should (= (length (tab-bar-tabs)) 2))
     (should (eq (current-buffer) buffer)))))

(ert-deftest my-project-tabs-isolate-same-name-folders ()
  (my-test-projects
   (let ((a (expand-file-name "a/service/" test-root))
         (b (expand-file-name "b/service/" test-root)))
     (make-directory a t) (make-directory b t)
     (my-project-open a)
     (let ((file-a (find-file-noselect (expand-file-name "a.txt" a))))
       (switch-to-buffer file-a)
       (my-project-open b)
       (let ((file-b (find-file-noselect (expand-file-name "b.txt" b))))
         (switch-to-buffer file-b)
         (should (memq file-b (my-project-file-tabs)))
         (should-not (memq file-a (my-project-file-tabs)))
         (my-project-open a)
         (should (eq (current-buffer) file-a))
         (should-not (memq file-b (my-project-file-tabs)))
         (should (= (length (delete-dups (mapcar (lambda (tab) (alist-get 'name tab))
                                               (tab-bar-tabs)))) 3))
         (should (equal (treemacs-project->path
                         (car (treemacs-workspace->projects (treemacs-current-workspace))))
                        (directory-file-name a))))))))

(ert-deftest my-project-missing-path-leaves-tabs-unchanged ()
  (my-test-projects
   (let ((before (length (tab-bar-tabs))))
     (should-error (my-project-open (expand-file-name "missing" test-root)) :type 'user-error)
     (should (= before (length (tab-bar-tabs)))))))

(ert-deftest my-project-cancel-close-preserves-modified-file ()
  (my-test-projects
   (my-project-open test-root)
   (let ((buffer (find-file-noselect (expand-file-name "notes.txt" test-root))))
     (switch-to-buffer buffer)
     (insert "unsaved")
     (let ((kill-buffer-query-functions (list (lambda () nil))))
       (should-error (tab-bar-close-tab) :type 'user-error))
     (should (= (length (tab-bar-tabs)) 2))
     (should (buffer-live-p buffer))
     (should (buffer-modified-p buffer))
     (with-current-buffer buffer (set-buffer-modified-p nil))
     (tab-bar-close-tab)
     (should (= (length (tab-bar-tabs)) 1))
     (should (equal (alist-get 'name (tab-bar--current-tab)) "Start")))))

(ert-deftest my-project-dashboard-and-go-support ()
  (my-test-projects
   (my-project-home)
   (should (derived-mode-p 'dashboard-mode))
   (should (string-match-p "Open folder" (buffer-string)))
   (should (eq dashboard-projects-switch-function #'my-project-open))
   (should (executable-find "gopls"))
   (should (treesit-language-available-p 'go))
   (should (memq #'eglot-ensure go-ts-mode-hook))))

(ert-deftest my-project-home-refreshes-dashboard-once ()
  (my-test-projects
   (my-project-open test-root)
   (let ((updates 0)
         (original (symbol-function 'dashboard-insert-startupify-lists)))
     (cl-letf (((symbol-function 'dashboard-insert-startupify-lists)
                (lambda (&rest args) (cl-incf updates) (apply original args))))
       (my-project-home)
       (should (= updates 1))
       (should (derived-mode-p 'dashboard-mode))
       (setq updates 0)
       (my-project-home)
       (should (= updates 1))
       (setq updates 0)
       (my-project-open test-root)
       (tab-bar-select-tab-by-name "Start")
       (should (= updates 1))))))

(ert-deftest my-project-reload-refreshes-start-once ()
  (my-test-projects
   (my-project-home)
   (let ((updates 0)
         (original (symbol-function 'dashboard-insert-startupify-lists)))
     (cl-letf (((symbol-function 'dashboard-insert-startupify-lists)
                (lambda (&rest args) (cl-incf updates) (apply original args))))
       (load (expand-file-name "projects.el" my-test-config-dir) nil t)
       (should (= updates 1))
       (should (derived-mode-p 'dashboard-mode))))))

(ert-deftest my-project-rust-support ()
  (require 'rust-ts-mode)
  (should (executable-find "rust-analyzer"))
  (should (treesit-language-available-p 'rust))
  (should (memq #'eglot-ensure rust-ts-mode-hook))
  (with-temp-buffer
    (setq buffer-file-name "/tmp/example.rs")
    (let ((rust-ts-mode-hook nil))
      (set-auto-mode)
      (should (eq major-mode 'rust-ts-mode)))))

(ert-deftest my-project-cargo-file-watches-skip-build-artifacts ()
  (my-test-projects
   (with-temp-file (expand-file-name "Cargo.toml" test-root) (insert "[workspace]\n"))
   (make-directory (expand-file-name "target/debug" test-root) t)
   (with-temp-file (expand-file-name "target/debug/generated.rs" test-root) (insert "// build\n"))
   (with-temp-file (expand-file-name "lib.rs" test-root) (insert "// source\n"))
   (let ((project (cons 'transient test-root)))
     (should (member "target/" (project-ignores project test-root)))
     (should (member (expand-file-name "lib.rs" test-root) (project-files project)))
     (should-not (member (expand-file-name "target/debug/generated.rs" test-root)
                         (project-files project))))))

(ert-deftest my-project-lsp-file-watches-never-enumerate-the-root ()
  (cl-letf (((symbol-function 'project-files)
             (lambda (&rest _) (ert-fail "File watches must not list the project"))))
    (eglot-register-capability nil 'workspace/didChangeWatchedFiles "id"
                               :watchers [(:globPattern "**/*.go")])))

(ert-deftest my-project-buried-file-still-belongs-to-project ()
  (my-test-projects
   (my-project-open test-root)
   (let ((buffer (find-file-noselect (expand-file-name "buried.txt" test-root))))
     (switch-to-buffer buffer)
     (insert "unsaved")
     (bury-buffer buffer)
     (should (memq buffer (my-project-file-tabs)))
     (my-project-home)
     (let ((kill-buffer-query-functions (list (lambda () nil))))
       (should-error (tab-bar-close-tab 2) :type 'user-error))
     (should (buffer-live-p buffer))
     (should (buffer-modified-p buffer)))))

(ert-deftest my-project-shared-buried-file-survives-other-project-close ()
  (my-test-projects
   (let ((a (expand-file-name "a/" test-root))
         (b (expand-file-name "b/" test-root)))
     (make-directory a) (make-directory b)
     (my-project-open a)
     (let ((buffer (find-file-noselect (expand-file-name "shared.txt" a))))
       (switch-to-buffer buffer)
       (bury-buffer buffer)
       (my-project-open b)
       (switch-to-buffer buffer)
       (tab-bar-close-tab)
       (should (buffer-live-p buffer))
       (my-project-open a)
       (should (memq buffer (my-project-file-tabs)))))))

(ert-deftest my-project-symlink-opens-existing-workspace ()
  (my-test-projects
   (let ((root (expand-file-name "real/" test-root))
         (alias (expand-file-name "alias" test-root)))
     (make-directory root)
     (make-symbolic-link root alias)
     (my-project-open root)
     (my-project-home)
     (my-project-open alias)
     (should (= (length (tab-bar-tabs)) 2))
     (should (equal (project-root (project-current nil alias)) root)))))

(ert-deftest my-project-reload-translates-existing-start-tab ()
  (my-test-projects
   (tab-bar-rename-tab "Старт")
   (my-project-open test-root)
   (let ((root (alist-get 'my-project-root (tab-bar--current-tab))))
     (load (expand-file-name "projects.el" my-test-config-dir) nil t)
     (should (equal (alist-get 'my-project-root (tab-bar--current-tab)) root))
     (my-project-home)
     (should (= (length (tab-bar-tabs)) 2))
     (should (equal (alist-get 'name (tab-bar--current-tab)) "Start"))
     (should (string-match-p "Open folder" (buffer-string)))
     (should-not (string-match-p "Открыть" (buffer-string))))))

(ert-deftest my-project-session-restores-roots-files-and-trees ()
  (my-test-projects
   (let* ((tabspaces-session-file (expand-file-name "test-session.el" user-emacs-directory))
          (a (expand-file-name "a/service/" test-root))
          (b (expand-file-name "b/service/" test-root))
          (file-a (expand-file-name "a.txt" a))
          (hidden-a (expand-file-name "hidden.txt" a))
          (file-b (expand-file-name "b.txt" b)))
     (make-directory a t) (make-directory b t)
     (dolist (file (list file-a hidden-a file-b))
       (with-temp-file file (insert "saved\n")))
     (my-project-open a)
     (find-file hidden-a)
     (bury-buffer)
     (find-file file-a)
     (my-project-open b)
     (find-file file-b)
     (tabspaces-save-session)
     (while (> (length (tab-bar-tabs)) 1)
       (tab-bar-close-tab (length (tab-bar-tabs))))
     (setq tabspaces-project-tab-map nil)
     (tabspaces-restore-session tabspaces-session-file)
     (should (= (length (tab-bar-tabs)) 3))
     (tab-bar-select-tab-by-name "Start")
     (should (derived-mode-p 'dashboard-mode))
     (dolist (pair (list (cons a (list file-a hidden-a)) (cons b (list file-b))))
       (my-project-open (car pair))
       (should (= (length (tab-bar-tabs)) 3))
       (should (equal (alist-get 'my-project-root (tab-bar--current-tab)) (car pair)))
       (should (equal (sort (mapcar #'buffer-file-name (my-project-file-tabs)) #'string<)
                      (sort (copy-sequence (cdr pair)) #'string<)))
       (should (equal (mapcar #'treemacs-project->path
                             (treemacs-workspace->projects (treemacs-current-workspace)))
                      (list (directory-file-name (car pair)))))))))

(ert-deftest my-project-close-and-reopen-restores-files ()
  (my-test-projects
   (let ((first (expand-file-name "first.txt" test-root))
         (hidden (expand-file-name "hidden.txt" test-root)))
     (dolist (file (list first hidden)) (with-temp-file file (insert "saved")))
     (my-project-open test-root)
     (find-file hidden) (bury-buffer) (find-file first)
     (my-project-home)
     (tab-bar-close-tab 2)
     (should-not (get-file-buffer first))
     (my-project-open test-root)
     (should (equal (sort (mapcar #'buffer-file-name (my-project-file-tabs)) #'string<)
                    (sort (list first hidden) #'string<)))
     (should (equal (buffer-file-name) first)))))

(ert-deftest my-project-closed-file-lists-isolate-equal-folder-names ()
  (my-test-projects
   (let* ((a (expand-file-name "a/service/" test-root))
          (b (expand-file-name "b/service/" test-root))
          (fa (expand-file-name "a.txt" a))
          (fb (expand-file-name "b.txt" b)))
     (make-directory a t) (make-directory b t)
     (dolist (file (list fa fb)) (with-temp-file file (insert "saved")))
     (my-project-open a) (find-file fa) (tab-bar-close-tab)
     (my-project-open b) (find-file fb) (tab-bar-close-tab)
     (my-project-open a)
     (should (equal (mapcar #'buffer-file-name (my-project-file-tabs)) (list fa)))
     (tab-bar-close-tab)
     (delete-file fb)
     (my-project-open b)
     (should-not (my-project-file-tabs))
     (should-not (get-file-buffer fb)))))

(ert-deftest my-project-directory-clicks-reuse-editor-window ()
  (my-test-projects
   (let* ((subdir (expand-file-name "subdir/" test-root))
          (file (expand-file-name "notes.txt" subdir)))
     (make-directory subdir)
     (with-temp-file file (insert "saved"))
     (my-project-open test-root)
     (let ((editor (selected-window)) (count (length (window-list))))
       (dired-goto-file (directory-file-name subdir))
       (funcall (key-binding [mouse-2])
                (list 'mouse-2 (list editor (point) '(0 . 0) 0)))
       (should (eq editor (selected-window)))
       (should (= count (length (window-list))))
       (should (equal (file-truename default-directory) subdir))
       (dired-goto-file file)
       (funcall (key-binding [mouse-2])
                (list 'mouse-2 (list editor (point) '(0 . 0) 0)))
       (should (equal (buffer-file-name) file))
       (should (= count (length (window-list))))
       (should-not (seq-some
                    (lambda (win) (with-current-buffer (window-buffer win)
                                    (derived-mode-p 'dired-mode)))
                    (window-list)))))))

(ert-deftest my-project-file-hides-leftover-directory-panes ()
  (my-test-projects
   (my-project-open test-root)
   (let* ((directory-buffer (current-buffer))
          (editor (split-window (selected-window) nil 'below))
          (file (expand-file-name "notes.txt" test-root)))
     (with-selected-window editor (find-file file))
     (run-hook-with-args 'window-buffer-change-functions (selected-frame))
     (should (window-live-p editor))
     (should (treemacs-get-local-window))
     (should (buffer-live-p directory-buffer))
     (should-not (get-buffer-window directory-buffer))
     (should (= (length (window-list)) 2)))))
