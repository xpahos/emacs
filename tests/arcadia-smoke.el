;;; arcadia-smoke.el --- Read-only integration with the real Arc mount -*- lexical-binding: t; -*-
(load (expand-file-name "arcadia-tests.el" (file-name-directory load-file-name)) nil t)
(let* ((file (expand-file-name "~/arc/arcadia/devtools/emacs/plugins/arcit/arcit.el"))
       (buffer (find-file-noselect file)))
  (unwind-protect
      (with-current-buffer buffer
        (when (display-graphic-p) (switch-to-buffer buffer))
        (cl-assert (eq (vc-backend file) 'Arc))
        (cl-assert (eq (vc-arc-state file) 'up-to-date))
        (cl-assert display-line-numbers-mode)
        (cl-assert diff-hl-mode)
        (let ((original (encode-coding-string (buffer-string) buffer-file-coding-system)))
          (cl-assert (equal original
                            (with-temp-buffer
                              (set-buffer-multibyte nil)
                              (vc-arc-find-revision file "HEAD" (current-buffer))
                              (buffer-string)))))
        (goto-char (point-min))
        (delete-region (point) (line-end-position))
        (insert ";;; Modified only in this test buffer")
        (forward-line 20)
        (delete-region (point) (progn (forward-line 1) (point)))
        (goto-char (point-max))
        (insert ";;; Added only in this test buffer\n")
        (diff-hl-update)
        (let ((deadline (+ (float-time) 10)))
          (while (and (< (float-time) deadline)
                      (not (seq-some (lambda (o) (overlay-get o 'diff-hl))
                                     (overlays-in (point-min) (point-max)))))
            (accept-process-output nil 0.05)))
        (let ((types (delete-dups
                      (delq nil (mapcar (lambda (o) (overlay-get o 'diff-hl-hunk-type))
                                       (overlays-in (point-min) (point-max)))))))
          (princ (format "Arc gutter overlay values: %S\n" types))
          (dolist (type '(insert change delete)) (cl-assert (memq type types))))
        (when (display-graphic-p)
          (goto-char (point-min))
          (recenter)
          (redisplay t)
          (cl-assert (fringe-bitmap-p 'my-diff-bar))
          (cl-assert (> (or (car (window-fringes)) 0) 0))
          (cl-assert (eq (car (fringe-bitmaps-at-pos (point-min))) 'my-diff-bar)))
        (princ "Real Arc baseline and unsaved change markers passed; no file was saved.\n"))
    (with-current-buffer buffer (set-buffer-modified-p nil))
    (kill-buffer buffer)))
