;;; gui-project-search-smoke.el --- Floating file and symbol search in a real frame -*- lexical-binding: t; -*-
;; Run with `make test-project-search-gui'; needs a logged-in GUI session, gopls and go.
;; Also times the real Arc tree when ~/arc/cloudia/cloud/compute/go exists.
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME is required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(defvar ps-report nil)

(defun ps-note (format &rest args) (push (apply #'format format args) ps-report))

(defun ps-wait (what predicate &optional seconds)
  (let ((deadline (+ (float-time) (or seconds 10))))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05)
      ;; This harness runs inside a timer, not the command loop; while gopls streams
      ;; output, an overdue refresh can be starved there, so run it as the loop would.
      (dolist (timer (copy-sequence timer-list))
        (when (and (eq (timer--function timer) #'my-search--flush)
                   (time-less-p (timer--time timer) nil))
          (cancel-timer timer)
          (apply (timer--function timer) (timer--args timer)))))
    (redisplay t)
    (unless (funcall predicate) (error "Timed out waiting for %s" what))))

(defun ps-dialog () (get-buffer my-search-buffer-name))
(defmacro ps-in-dialog (&rest body) `(with-current-buffer (ps-dialog) ,@body))
(defun ps-settled-p ()
  (and (ps-dialog) (ps-in-dialog (and (null my-search-timer) (equal my-search-query (my-search--read-query))))))

(defun ps-keys (keys)
  "Type KEYS into whatever has keyboard focus, as the user would."
  (execute-kbd-macro (if (stringp keys) (kbd keys) keys))
  (condition-case nil
      (ps-wait "the dialog to redraw" (lambda () (or (not (ps-dialog)) (ps-settled-p))))
    (error (error "Dialog did not settle after %S: %S" keys
                  (ps-in-dialog (list :timer my-search-timer :query my-search-query
                                      :typed (my-search--read-query) :active my-search-active
                                      :selected-frame (selected-frame) :live (my-search--live-p (current-buffer))
                                      :listed (and (memq my-search-timer timer-list) t)
                                      :due-in (and (timerp my-search-timer) (float-time (time-subtract (timer--time my-search-timer) nil)))
                                      :timers (length timer-list)))))))

(defun ps-status ()
  (ps-in-dialog
   (let ((start (text-property-any (point-min) (point-max) 'my-search-status t)))
     (buffer-substring-no-properties start (next-single-property-change start 'my-search-status nil (point-max))))))

(defun ps-x-y (pos)
  "Displayed pixel position of POS in the dialog window."
  (posn-x-y (posn-at-point pos (get-buffer-window (ps-dialog) t))))

(defun ps-color-distance (a b)
  (apply #'+ (cl-mapcar (lambda (x y) (abs (- x y))) (color-values a) (color-values b))))

(defun ps-check-dialog (title)
  "A focused child frame with the editor's font, a bounded field, whole rows."
  (cl-assert (frame-live-p my-search-frame))
  (cl-assert (eq (frame-parent my-search-frame) ps-parent))
  (cl-assert (eq (selected-frame) my-search-frame))
  (cl-assert (eq (window-buffer (selected-window)) (ps-dialog)))
  (cl-assert (= (length (window-list my-search-frame)) 1))
  ;; Font: family, size and weight are the parent's; dialog faces only color.
  (dolist (attribute '(:family :height :weight))
    (cl-assert (equal (face-attribute 'default attribute my-search-frame)
                      (face-attribute 'default attribute ps-parent))))
  (cl-assert (= (frame-char-height my-search-frame) (frame-char-height ps-parent)))
  (cl-assert (equal (face-font 'default my-search-frame) (face-font 'default ps-parent)))
  (dolist (face '(my-search-field my-search-border my-search-dim my-search-name my-search-selected))
    (dolist (attribute '(:height :weight :family))
      (cl-assert (eq (face-attribute face attribute) 'unspecified))))
  (ps-in-dialog
   (cl-assert (string-match-p title (format-mode-line header-line-format)))
   (cl-assert (<= my-search-input (point) my-search-input-end))
   ;; No details/preview panel below the results.
   (cl-assert (not (string-match-p "^ *\\(File\\|Definition\\|Signature\\|References\\|Description\\)\\b"
                                   (buffer-substring-no-properties (point-min) (point-max))))))
  (ps-check-field)
  (ps-check-layout))

(defun ps-check-field ()
  "The field's outline encloses padding and the caret, as displayed."
  (redisplay t)
  (ps-in-dialog
   (let* ((cw (frame-char-width my-search-frame)) (ch (frame-char-height my-search-frame))
          (borders (let (found)
                     (dotimes (i (1- (point-max)))
                       (when (memq 'my-search-border (ensure-list (get-text-property (1+ i) 'face)))
                         (push (1+ i) found)))
                     (nreverse found)))
          (positions (mapcar #'ps-x-y borders))
          (left (seq-min (mapcar #'car positions)))
          (top (seq-min (mapcar #'cdr positions)))
          (bottom (seq-max (mapcar #'cdr positions)))
          (caret (ps-x-y (point)))
          (input-y (cdr (ps-x-y my-search-input))))
     ;; Outline is a separate, contrasting color.
     (cl-assert (> (ps-color-distance (face-background 'my-search-border my-search-frame)
                                     (face-background 'my-search-field my-search-frame)) 60))
     (cl-assert (> (ps-color-distance (face-background 'my-search-border my-search-frame)
                                     (frame-parameter my-search-frame 'background-color)) 60))
     ;; Every field row starts its outline at the same x: a continuous left edge.
     (dolist (pos borders)
       (when (= (car (ps-x-y pos)) left)
         (cl-assert (= (car (ps-x-y pos)) left))))
     (unless (= 5 (length (delete-dups (mapcar #'cdr positions))))
       (error "Row tops %S" (save-excursion (goto-char (point-min)) (cl-loop repeat 12 collect (prog1 (list (line-number-at-pos) (pos-visible-in-window-p (point) (get-buffer-window (current-buffer) t) t)) (forward-line 1))))))
     ;; Padding: the caret row is inside, away from the top and bottom outline.
     (cl-assert (and (< top input-y) (> bottom input-y)))
     (cl-assert (>= (- input-y top) (/ ch 4)))
     ;; The caret: same row as the query, right of the outline by the padding.
     (cl-assert (= (cdr caret) input-y))
     (cl-assert (> (car caret) (+ left 2)))
     (cl-assert (<= (- (car caret) (car (ps-x-y my-search-input))) (* cw (length (my-search--read-query)))))
     (cl-assert (< (car caret) (+ (car (ps-x-y my-search-input)) (* cw (1+ (length (my-search--read-query))))))))))

(defun ps-check-caret ()
  "Typing, moving, deleting and clearing keep the displayed caret right after the text."
  (let* ((empty (progn (redisplay t) (ps-in-dialog (car (ps-x-y my-search-input)))))
         (cw (frame-char-width my-search-frame))
         (caret (lambda () (redisplay t) (ps-in-dialog (car (ps-x-y (point)))))))
    (cl-assert (= (funcall caret) empty))
    (cl-assert (< empty (/ (window-body-width (get-buffer-window (ps-dialog) t) t) 3)))
    (ps-keys "abc")
    (cl-assert (= (funcall caret) (+ empty (* 3 cw))))
    (ps-keys "<left> <left>")
    (cl-assert (= (funcall caret) (+ empty cw)))
    (ps-keys "<home>")
    (cl-assert (= (funcall caret) empty))
    (ps-keys "<end>")
    (cl-assert (= (funcall caret) (+ empty (* 3 cw))))
    (ps-keys "<deletechar> <end> <backspace>")
    (cl-assert (equal (ps-in-dialog (my-search--read-query)) "ab"))
    (ps-keys "<backspace> <backspace> <backspace>")
    (cl-assert (equal (ps-in-dialog (my-search--read-query)) ""))
    (cl-assert (= (funcall caret) empty))
    (ps-check-field)
    (ps-note "Caret: empty at x=%d px, +3 chars at x=%d, cleared back to x=%d." empty (+ empty (* 3 cw)) (funcall caret))))

(defun ps-borders ()
  "Positions of the field outline's glyphs."
  (ps-in-dialog
   (let (found)
     (dotimes (i (1- (point-max)))
       (when (memq 'my-search-border (ensure-list (get-text-property (1+ i) 'face)))
         (push (1+ i) found)))
     (nreverse found))))

(defun ps-fixed-layout ()
  "Displayed places of everything that must not move while the query changes."
  (redisplay t)
  (ps-in-dialog
   (list :hscroll (window-hscroll (get-buffer-window (current-buffer) t))
         :label (ps-x-y (save-excursion (goto-char (point-min)) (search-forward "Search") (match-beginning 0)))
         :outline (mapcar #'ps-x-y (ps-borders))
         :status (ps-x-y (text-property-any (point-min) (point-max) 'my-search-status t))
         :rows (ps-x-y my-search-rows-start))))

(defun ps-check-caret-in-field (fixed)
  "The caret is displayed between the field's left and right outline, on the query row."
  (redisplay t)
  (ps-in-dialog
   (let* ((window (get-buffer-window (current-buffer) t))
          (caret (ps-x-y (point)))
          (row (cdr (ps-x-y my-search-input-end)))
          (edges (seq-filter (lambda (xy) (and xy (= (cdr xy) row))) (plist-get fixed :outline))))
     (cl-assert caret)
     (cl-assert (= (length edges) 2))
     (cl-assert (< (car (car edges)) (car caret) (car (cadr edges))))
     (dolist (pos (list my-search-input-end (1+ my-search-input-end)))
       (cl-assert (= 2 (length (pos-visible-in-window-p pos window t)))))
     caret)))

(defun ps-check-long-input ()
  "Long queries scroll inside the field only; the rest of the dialog stays put."
  (let* ((fixed (ps-fixed-layout))
         (cw (frame-char-width my-search-frame))
         (empty (car (ps-check-caret-in-field fixed)))
         (same (lambda (what)
                 (let ((now (ps-fixed-layout)))
                   (unless (equal now fixed) (error "%s moved the dialog: %S -> %S" what fixed now)))))
         (long (concat "cloud/compute/go/" (mapconcat #'identity (make-list 12 "segment") "/") "/x.go")))
    (cl-assert (= (plist-get fixed :hscroll) 0))
    (ps-keys (make-string 120 ?q))
    (cl-assert (= (length (ps-in-dialog (my-search--read-query))) 120))
    (funcall same "Typing 120 characters")
    (ps-check-caret-in-field fixed)
    (cl-assert (ps-in-dialog (overlay-get my-search-field-head 'display)))
    (ps-keys "<home>")
    (funcall same "Home")
    (cl-assert (= (car (ps-check-caret-in-field fixed)) empty))
    (cl-assert (ps-in-dialog (overlay-get my-search-field-tail 'display)))
    (ps-keys "<right> <right> <right> <right> <right>")
    (cl-assert (= (car (ps-check-caret-in-field fixed)) (+ empty (* 5 cw))))
    (ps-keys "<end>")
    (funcall same "End")
    (ps-check-caret-in-field fixed)
    (ps-keys "<left> <left> <left>")
    (funcall same "Left")
    (ps-check-caret-in-field fixed)
    (ps-keys "<end>")
    (ps-keys (make-vector 120 'backspace))
    (cl-assert (equal (ps-in-dialog (my-search--read-query)) ""))
    (funcall same "Deleting back to empty")
    (cl-assert (= (car (ps-check-caret-in-field fixed)) empty))
    (cl-assert (not (ps-in-dialog (or (overlay-get my-search-field-head 'display)
                                      (overlay-get my-search-field-tail 'display)))))
    (ps-check-field)
    ;; A pasted path keeps the whole path for matching and only shows its end.
    (let ((kill-ring (list long)) (interprogram-paste-function nil))
      (ps-keys "C-y"))
    (cl-assert (equal (ps-in-dialog (my-search--read-query)) long))
    (funcall same "Pasting a long path")
    (ps-check-caret-in-field fixed)
    ;; Resizing with a long query keeps it inside the field.
    (let ((frame-resize-pixelwise t))
      (set-frame-size ps-parent 520 330 t)
      (ps-wait "refit" (lambda () (redisplay t) (< (frame-pixel-width my-search-frame) 600)))
      (let ((narrow (ps-fixed-layout)))
        (cl-assert (= (plist-get narrow :hscroll) 0))
        (ps-check-caret-in-field narrow)
        (ps-keys "<home>")
        (ps-check-caret-in-field narrow))
      (set-frame-size ps-parent 1100 760 t)
      (ps-wait "refit" (lambda () (redisplay t) (> (frame-pixel-width my-search-frame) 600)))
      (ps-check-caret-in-field (ps-fixed-layout)))
    (ps-keys "<home> C-k")
    (cl-assert (equal (ps-in-dialog (my-search--read-query)) ""))
    (ps-check-field)
    (ps-note "Long input: 120 typed chars, Home/End/Left/Right, a %d-char pasted path, clearing and a parent resize kept hscroll 0 and the field, label, status and rows in place."
             (length long))))

(defun ps-wheel (type count &optional lines)
  "Deliver COUNT real wheel events of TYPE over the result rows."
  (dotimes (_ count)
    (redisplay t)
    (let* ((window (get-buffer-window (ps-dialog) t))
           (posn (ps-in-dialog (posn-at-point my-search-rows-start window))))
      (execute-kbd-macro (vector (list type posn 1 lines))))))

(defun ps-trackpad (dy count)
  "Deliver COUNT synthetic trackpad events moving DY pixels toward later results."
  (dotimes (_ count)
    (let* ((window (get-buffer-window (ps-dialog) t))
           (posn (ps-in-dialog (posn-at-point my-search-rows-start window))))
      (execute-kbd-macro (vector (list (if (< dy 0) 'wheel-up 'wheel-down) posn 1 nil (cons 0 (- dy)))))))
  (redisplay t))

(defun ps-check-trackpad (state)
  "Pixel deltas with precision scrolling on: steps follow distance, not event count."
  (let ((precision (bound-and-true-p pixel-scroll-precision-mode)))
    (pixel-scroll-precision-mode 1)
    (unwind-protect
        (let* ((total (ps-in-dialog (length my-search-shown)))
               (before (funcall state))
               (row (ps-in-dialog (my-search--row-pixels)))
               (drawn (ps-in-dialog
                       (let* ((first my-search-rows-start)
                              (second (next-single-property-change first 'my-search-key)))
                         (- (cdr (ps-x-y second)) (cdr (ps-x-y first)))))))
          (cl-assert (eq (ps-in-dialog (key-binding [wheel-down])) #'my-search-wheel))
          (cl-assert (= row drawn))
          (ps-wheel 'wheel-up 60)
          (ps-trackpad 1 (1- row))
          (cl-assert (= (ps-selected-index) 0))
          (ps-trackpad 1 1)
          (cl-assert (= (ps-selected-index) 1))
          (ps-trackpad (* 2 row) 1)
          (cl-assert (= (ps-selected-index) 3))
          (ps-trackpad -1 (* 2 row))
          (cl-assert (= (ps-selected-index) 1))
          (ps-trackpad 0 10)
          (cl-assert (= (ps-selected-index) 1))
          ;; A burst of small events, like momentum, stops at the end; reversing answers at once.
          (ps-trackpad 3 (* 2 total row))
          (cl-assert (= (ps-selected-index) (1- total)))
          (ps-trackpad (- row) 1)
          (cl-assert (= (ps-selected-index) (- total 2)))
          (ps-check-layout)
          (unless (equal (funcall state) before)
            (error "Trackpad moved the dialog: %S -> %S" before (funcall state)))
          (ps-wheel 'wheel-up 60)
          (ps-note "Trackpad (%s): row %d px = step; %d events of 1 px moved one row; momentum burst clamped."
                   (ps-in-dialog my-search-kind) row row))
      (unless precision (pixel-scroll-precision-mode -1)))))

(defun ps-selected-index ()
  (ps-in-dialog (cl-position my-search-selected my-search-shown :key (lambda (it) (plist-get it :key)) :test #'equal)))

(defun ps-check-wheel ()
  "Wheel events page through results; field, caret and window never move."
  (ps-keys "<left> <left>")
  (let* ((total (ps-in-dialog (length my-search-shown)))
         (state (lambda ()
                  (redisplay t)
                  (ps-in-dialog (list (ps-fixed-layout) (ps-x-y (point)) (my-search--read-query)
                                      (- (point) my-search-input)
                                      (window-start (get-buffer-window (current-buffer) t))
                                      (window-vscroll (get-buffer-window (current-buffer) t))))))
         (before (funcall state))
         (same (lambda (what)
                 (let ((now (funcall state)))
                   (unless (equal now before) (error "Wheel %s moved the dialog: %S -> %S" what before now))))))
    (cl-assert (> total (ps-in-dialog my-search-rows)))
    (ps-wheel 'wheel-down 8)
    (cl-assert (= (ps-selected-index) (min 8 (1- total))))
    (cl-assert (> (ps-in-dialog my-search-offset) 0))
    (funcall same "down")
    (ps-check-layout)
    (ps-wheel 'wheel-up 3)
    (cl-assert (= (ps-selected-index) (- (min 8 (1- total)) 3)))
    (funcall same "up")
    (ps-wheel 'wheel-down 60)
    (cl-assert (= (ps-selected-index) (1- total)))
    (ps-check-layout)
    (ps-wheel 'wheel-up 60)
    (cl-assert (= (ps-selected-index) 0))
    (cl-assert (= (ps-in-dialog my-search-offset) 0))
    (ps-wheel 'double-wheel-down 1 3)
    (cl-assert (= (ps-selected-index) (min 3 (1- total))))
    (ps-wheel 'wheel-right 4)
    (funcall same "after reversing, repeats and horizontal events")
    (ps-check-layout)
    (ps-wheel 'wheel-up 60)
    (ps-check-trackpad state)
    (ps-note "Wheel (%s): %d results, paged to the end and back with the caret mid-query; field, caret and window start stayed put."
             (ps-in-dialog my-search-kind) total)))

(defun ps-check-layout ()
  "Whole padded two-line rows, all fully visible above the footer, inside the parent."
  (redisplay t)
  (let* ((window (get-buffer-window (ps-dialog) t)) (frame (window-frame window))
         (parent (frame-parent frame)))
    (ps-in-dialog
     (cl-assert (<= 1 my-search-rows 6))
     (cl-assert (string-match-p (if (eq my-search-kind 'file)
                                    "↑ ↓ Select · Enter Open · Esc Close"
                                  "↑ ↓ Select · Enter Open · C-c C-r References · Esc Close")
                                (format-mode-line mode-line-format)))
     (let ((pos my-search-rows-start) (rows 0))
       (while (< pos (point-max))
         (let ((key (get-text-property pos 'my-search-key))
               (end (next-single-property-change pos 'my-search-key nil (point-max))))
           (cl-assert key)
           ;; Padding row, name line, path line, padding row.
           (cl-assert (= 4 (count-lines pos end)))
           (cl-assert (= 2 (length (seq-filter (lambda (l) (not (string-blank-p l)))
                                               (split-string (buffer-substring-no-properties pos end) "\n")))))
           (dolist (p (list pos (1- end)))
             (unless (= 2 (length (pos-visible-in-window-p p window t)))
               (error "Row %d at %d partly visible: %S; rows %d, window %dpx, frame text %dpx, start %S"
                      rows p (pos-visible-in-window-p p window t) my-search-rows
                      (window-pixel-height window) (frame-text-height frame)
                      (list :body (window-body-height window t) :header (window-header-line-height window)
                            :mode (window-mode-line-height window)
                            :top (cdr (window-text-pixel-size window (point-min) my-search-rows-start))
                            :all (cdr (window-text-pixel-size window (point-min) (point-max)))
                            :row (cdr (window-text-pixel-size window pos end))))))
           (when (equal key my-search-selected)
             (cl-loop for p from pos below end
                      do (cl-assert (memq 'my-search-selected (ensure-list (get-text-property p 'face))))))
           (cl-incf rows)
           (setq pos end)))
       (cl-assert (= rows (min my-search-rows (length my-search-shown)))))
     (save-excursion
       (goto-char (point-min))
       (while (not (eobp))
         (cl-assert (<= (car (window-text-pixel-size window (pos-bol) (pos-eol))) (window-body-width window t)))
         (forward-line 1))))
    (pcase-let ((`(,x . ,y) (frame-position frame)))
      (unless (and (>= x 0) (>= y 0)
                   (<= (+ x (frame-pixel-width frame)) (frame-pixel-width parent))
                   (<= (+ y (frame-pixel-height frame)) (frame-pixel-height parent)))
        (error "Dialog %S at %d,%d %dx%d outside parent %dx%d (rows %d)" frame x y
               (frame-pixel-width frame) (frame-pixel-height frame)
               (frame-pixel-width parent) (frame-pixel-height parent) (ps-in-dialog my-search-rows))))))

(defun ps-check-closed (origin buffer)
  (cl-assert (not (ps-dialog)))
  (cl-assert (not (frame-live-p my-search-frame)))
  (cl-assert (eq (selected-window) origin))
  (unless (eq (window-buffer origin) buffer) (error "Expected %s in origin, got %s (selected %s)" buffer (window-buffer origin) (window-buffer (selected-window))))
  (cl-assert (not (seq-some (lambda (p) (and (process-live-p p) (string-prefix-p "project-files" (process-name p))))
                            (process-list)))))

(defvar ps-parent nil)

(defun ps-make-module ()
  (let ((root (file-name-as-directory (file-truename (make-temp-file "search-gui-" t)))))
    (dolist (spec '(("go.mod" . "module example.test/search\n\ngo 1.21\n")
                    ("alpha/alpha.go" . "package alpha\n\n// Run starts alpha.\nfunc Run() int { return 1 }\n\nfunc use() int { return Run() }\n")
                    ("beta/beta.go" . "package beta\n\ntype Runner struct{}\n\n// Run starts beta.\nfunc Run() int { return 2 }\n\nfunc (Runner) Run() {}\n")
                    ("gamma/gamma.go" . "package gamma\n\nfunc RunOne() {}\nfunc RunTwo() {}\nfunc RunThree() {}\nfunc RunFour() {}\nfunc RunFive() {}\nfunc RunWithAnExtremelyLongNameThatMustBeTruncatedInsideItsOwnLineOfTheDialogWithoutPushingAnything() {}\n")
                    ("list/item01.txt" . "1\n") ("list/item02.txt" . "2\n") ("list/item03.txt" . "3\n")
                    ("list/item04.txt" . "4\n") ("list/item05.txt" . "5\n") ("list/item06.txt" . "6\n")
                    ("list/item07.txt" . "7\n") ("list/item08.txt" . "8\n") ("list/item09.txt" . "9\n")
                    ("list/item10.txt" . "10\n") ("list/item11.txt" . "11\n") ("list/item12.txt" . "12\n")
                    ("deeply/nested/path/that/is/very/long/and/keeps/going/beyond/the/dialog/width/notes.txt" . "x\n")
                    (".git/config" . "[core]\n")))
      (let ((file (expand-file-name (car spec) root)))
        (make-directory (file-name-directory file) t)
        (with-temp-file file (insert (cdr spec)))))
    root))

(defun ps-run ()
  (let* ((root (ps-make-module)) (alpha (expand-file-name "alpha/alpha.go" root))
         (beta (expand-file-name "beta/beta.go" root)))
    (setq ps-parent (selected-frame))
    (setf (alist-get 'my-project-root (cdr (tab-bar--current-tab-find))) root)
    (find-file alpha)
    (let ((origin (selected-window)) (start (float-time)))
      ;; Files: open, type a fragment, move, open; long paths keep the input on line 1.
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-check-dialog "Find file")
      (ps-check-caret)
      (ps-check-long-input)
      (cl-assert (equal (ps-in-dialog (plist-get (car my-search-shown) :key)) "alpha/alpha.go"))
      (ps-keys "a/b")
      (ps-wait "files" (lambda () (ps-in-dialog (not my-search-loading))))
      (ps-keys "<backspace> <backspace> <backspace> .go")
      (ps-check-dialog "Find file")
      (cl-assert (equal (ps-in-dialog (mapcar (lambda (it) (plist-get it :key)) my-search-shown))
                        '("alpha/alpha.go" "beta/beta.go" "gamma/gamma.go")))
      ;; "a/b" matched beta/beta.go, and the selection stayed on it.
      (cl-assert (equal (ps-in-dialog my-search-selected) "beta/beta.go"))
      (ps-keys "<up>")
      (ps-keys "<down>")
      (ps-keys "RET")
      (ps-check-closed origin (get-file-buffer beta))
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-keys "notes")
      (ps-wait "long path" (lambda () (ps-in-dialog (and (not my-search-loading) my-search-shown))))
      (ps-check-dialog "Find file")
      (ps-keys "zzzz")
      (cl-assert (string-match-p "No matching files" (ps-status)))
      (ps-check-dialog "Find file")
      (cl-assert (not (seq-some (lambda (it) (string-match-p "\\.git/" (plist-get it :key)))
                                (ps-in-dialog my-search-items))))
      (ps-keys "<escape>")
      (ps-check-closed origin (get-file-buffer beta))
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-keys "C-g")
      (ps-check-closed origin (get-file-buffer beta))
      (ps-note "Files: focus, typing, Down/Enter, Esc, C-g, long path and .git exclusion passed (%.2fs)."
               (- (float-time) start)))
    ;; Wheel paging in file search; Enter opens the row the wheel highlighted.
    (let ((origin (selected-window)))
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-keys "item")
      (ps-wait "items" (lambda () (ps-in-dialog (not my-search-loading))))
      (ps-check-wheel)
      (ps-wheel 'wheel-down 7)
      (let ((key (ps-in-dialog my-search-selected)))
        (ps-keys "RET")
        (cl-assert (eq (selected-window) origin))
        (cl-assert (equal buffer-file-name (expand-file-name key root)))))
    ;; Symbols with the real gopls.
    (switch-to-buffer (get-file-buffer alpha))
    (ps-wait "gopls" (lambda () (and (eglot-current-server)
                                     (jsonrpc-running-p (eglot-current-server))))
             60)
    (let ((origin (selected-window)) (start (float-time)) local server)
      (call-interactively (key-binding (kbd "C-c p s")))
      (ps-check-dialog "Go symbols")
      (ps-keys "Run")
      (setq local (- (float-time) start))
      (cl-assert (equal (ps-in-dialog (plist-get (car my-search-shown) :rel)) "alpha/alpha.go"))
      (ps-wait "gopls symbols" (lambda () (ps-in-dialog (and (not my-search-loading) (not my-search-error)
                                                             (>= (length my-search-shown) 3))))
               30)
      (setq server (- (float-time) start))
      (ps-check-dialog "Go symbols")
      (ps-check-wheel)
      ;; Beyond the first page: the selection scrolls into view, rows stay whole.
      (dotimes (_ 7) (ps-keys "<down>"))
      (ps-in-dialog (cl-assert (> my-search-offset 0)))
      (ps-note "Symbols at %dx%d parent: %d whole rows, dialog %dx%d, %d results scrolled to offset %d."
               (frame-pixel-width ps-parent) (frame-pixel-height ps-parent) (ps-in-dialog my-search-rows)
               (frame-pixel-width my-search-frame) (frame-pixel-height my-search-frame)
               (ps-in-dialog (length my-search-shown)) (ps-in-dialog my-search-offset))
      (ps-check-dialog "Go symbols")
      (dotimes (_ 7) (ps-keys "<up>"))
      (ps-in-dialog (cl-assert (= my-search-offset 0)))
      (let ((names (ps-in-dialog (mapcar (lambda (it) (format "%s %s:%d" (plist-get it :name) (plist-get it :rel) (plist-get it :line)))
                                         my-search-shown))))
        (cl-assert (member "Run alpha/alpha.go:4" names))
        (cl-assert (member "Run beta/beta.go:6" names))
        (cl-assert (member "Runner.Run beta/beta.go:8" names))
        (ps-in-dialog
         (setq my-search-selected (plist-get (seq-find (lambda (it) (and (equal (plist-get it :name) "Run") (equal (plist-get it :rel) "beta/beta.go"))) my-search-shown) :key))
         (my-search--render)))
      (ps-keys "RET")
      (ps-check-closed origin (get-file-buffer beta))
      (cl-assert (= (line-number-at-pos) 6))
      (cl-assert (looking-at-p "Run() int { return 2"))
      (ps-note "Symbols: local results after %.2fs, gopls after %.2fs; same-name navigation passed." local server)
      ;; References on explicit request only.
      (switch-to-buffer (get-file-buffer alpha))
      (call-interactively (key-binding (kbd "C-c p s")))
      (ps-keys "Run")
      (ps-wait "gopls symbols" (lambda () (ps-in-dialog (not my-search-loading))) 30)
      (cl-assert (not (get-buffer "*References*")))
      (ps-keys "C-c C-r")
      (ps-wait "references" (lambda () (get-buffer-window "*References*" t)) 30)
      (cl-assert (with-current-buffer "*References*" (string-match-p "alpha.go" (buffer-string))))
      (ps-note "References: C-c C-r opened the References popup.")
      (with-selected-window (get-buffer-window "*References*" t) (quit-window)))
    ;; A small parent frame: fewer whole rows, dialog still inside it.
    (let ((origin (selected-window)) (buffer (current-buffer)) (frame-resize-pixelwise t))
      (set-frame-size ps-parent 520 330 t)
      (redisplay t)
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-keys ".go")
      (ps-wait "files" (lambda () (ps-in-dialog (not my-search-loading))))
      (ps-check-dialog "Find file")
      (ps-keys "<home> C-k item")
      (ps-wait "items" (lambda () (ps-in-dialog (> (length my-search-shown) my-search-rows))))
      (ps-check-wheel)
      (ps-note "Small parent 520x330: %d whole rows, dialog %dx%d."
               (ps-in-dialog my-search-rows) (frame-pixel-width my-search-frame) (frame-pixel-height my-search-frame))
      (ps-keys "<escape>")
      (ps-check-closed origin buffer)
      ;; Resizing the parent while the dialog is open refits it.
      (set-frame-size ps-parent 1100 760 t)
      (redisplay t)
      (call-interactively (key-binding (kbd "C-c p o")))
      (ps-keys ".go")
      (ps-wait "files" (lambda () (ps-in-dialog (not my-search-loading))))
      (let ((large (ps-in-dialog my-search-rows)))
        (set-frame-size ps-parent 520 300 t)
        (ps-wait "refit" (lambda () (redisplay t) (< (ps-in-dialog my-search-rows) large)))
        (ps-check-dialog "Find file")
        (set-frame-size ps-parent 1100 760 t)
        (ps-wait "refit" (lambda () (redisplay t) (= (ps-in-dialog my-search-rows) large)))
        (ps-check-dialog "Find file")
        (ps-note "Parent resize while open: %d rows -> fewer -> %d rows." large (ps-in-dialog my-search-rows)))
      (ps-keys "C-g")
      (ps-check-closed origin buffer))
    ;; Live timing on the real tree.
    (let ((arc (expand-file-name "~/arc/cloudia/cloud/compute/go/")))
      (when (file-directory-p arc)
        (switch-to-buffer (get-buffer-create "*search-origin*"))
        (setf (alist-get 'my-project-root (cdr (tab-bar--current-tab-find))) arc)
        (let ((start (float-time)) first)
          (call-interactively (key-binding (kbd "C-c p o")))
          (ps-keys "common/pkg/hw/pci/class.go")
          (cl-assert (string-match-p "Indexing" (ps-status)))
          (ps-wait "class.go" (lambda () (ps-in-dialog my-search-shown)) 120)
          (setq first (- (float-time) start))
          (cl-assert (equal (ps-in-dialog (plist-get (car my-search-shown) :key)) "common/pkg/hw/pci/class.go"))
          (ps-keys "RET")
          (cl-assert (equal buffer-file-name (expand-file-name "common/pkg/hw/pci/class.go" arc)))
          (ps-note "Arc tree: class.go offered after %.2fs while indexing continued." first))))
    (delete-directory root t)))

(add-hook 'emacs-startup-hook
          (lambda ()
            (run-with-timer
             1 nil
             (lambda ()
               (condition-case err
                   (progn (ps-run)
                          (with-temp-file (expand-file-name "result" user-emacs-directory)
                            (insert "PASSED\n" (string-join (reverse ps-report) "\n") "\n"))
                          (kill-emacs 0))
                 (error
                  (with-temp-file (expand-file-name "result" user-emacs-directory)
                    (insert "FAILED\n" (string-join (reverse ps-report) "\n") "\n")
                    (prin1 err (current-buffer)))
                  (kill-emacs 1)))))))
