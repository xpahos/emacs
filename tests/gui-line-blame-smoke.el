;;; gui-line-blame-smoke.el --- Check blame placement in a real frame -*- lexical-binding: t; -*-
;; Run with `make test-line-blame-gui'; uses a throwaway profile and a real Arc file.
;; Needs the logged-in GUI session; sandboxed runs aborted during AppKit startup.
;; Diagnose SIGABRT from crash logs: exit -6 alone does not identify the cause.
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "Test home required"))))
(redisplay t)
(require 'eglot)
(advice-add 'eglot-ensure :override #'ignore)
(load "/Volumes/Sources/emacs/init.el" nil t)
(require 'ert)

(defconst lb-arc-file (expand-file-name "~/arc/arcadia/util/generic/yexception.h"))

(defun lb-gui-wait ()
  (let ((deadline (+ (float-time) 60)))
    (while (and line-blame--request (< (float-time) deadline))
      (accept-process-output nil 0.1)))
  (should-not line-blame--request)
  (should line-blame-mode)
  (redisplay t))

(defun lb-step (label)
  (write-region (format "%s\n" label) nil (expand-file-name "progress" user-emacs-directory) t 'silent))

(defvar lb-gui-tips 0 "Blame tooltips shown by the shared popup helper.")
(defvar lb-gui-pointer nil "Controlled pointer coordinates for the GUI checks.")
(advice-add 'mouse-pixel-position :override (lambda () lb-gui-pointer))

(defun lb-gui-move-pointer (frame x y)
  "Move the test pointer without competing with the user's desktop mouse."
  (setq lb-gui-pointer (cons frame (cons x y))))

(advice-add 'my-popup-show :after
            (lambda (buffer &rest _)
              (when (equal buffer " *Blame details*") (cl-incf lb-gui-tips))))

(defun lb-gui-warp (window col pos)
  "Move the test pointer to column COL of the text area, on the screen row of POS.
POS may instead be (Y), a row's window-relative pixel position."
  (let ((edges (window-inside-pixel-edges window))
        (y (if (consp pos) (car pos) (cdr (posn-x-y (posn-at-point pos window))))))
    (lb-gui-move-pointer (window-frame window)
                              (+ (nth 0 edges) (* col (frame-char-width))
                                 (/ (frame-char-width) 2))
                              (+ (nth 1 edges) y (/ (frame-char-height) 2)))))

(defun lb-gui-settle (seconds)
  (let ((end (+ (float-time) seconds)))
    ;; Child-frame input can make `sit-for' return without running hover timers.
    (while (< (float-time) end) (accept-process-output nil 0.02))))

(defun lb-gui-await (predicate)
  "Wait for a child-frame transition, with a bounded deadline."
  (let ((end (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) end))
      (accept-process-output nil 0.02)))
  (should (funcall predicate)))

(defun lb-gui-x (pos &optional window)
  (car (posn-x-y (posn-at-point pos window))))

(defun lb-gui-check ()
  (lb-step "check")
  (condition-case err
      (let* ((window (selected-window))
             (cw (frame-char-width))
             (dir (file-name-as-directory (make-temp-file "line-blame-gui-" t)))
             (file (expand-file-name "wrap.txt" dir))
             report)
        (set-frame-size nil 100 40)
        ;; Git file with a line long enough to wrap twice.
        (with-temp-file file
          (insert "short\n" (mapconcat #'number-to-string (number-sequence 1 120) " ")
                  "\nend\n"))
        (let ((default-directory dir))
          (dolist (args `(("init" "-q") ("add" ".")
                          ("-c" "commit.gpgsign=false" "-c" "user.name=Ivan Petrov" "-c" "user.email=i@p"
                           "commit" "-qm" "init")))
            (apply #'call-process "git" nil nil nil args)))
        (lb-step "visit git") (find-file file)
        (should display-line-numbers-mode)
        (should diff-hl-mode)
        (setq truncate-lines nil)
        ;; Let the minimap claim its margin first so the baseline is stable.
        (when (fboundp 'my-overview-refresh) (my-overview-refresh))
        (redisplay t)
        (let* ((margins (window-margins window))
               (fringes (window-fringes window))
               (lnum (line-number-display-width))
               (base (lb-gui-x 1))
               (line2 (save-excursion (goto-char 1) (forward-line 1) (point)))
               (cont (save-excursion (goto-char line2) (vertical-motion 1) (point))))
          (should (= (lb-gui-x cont) base))
          (lb-step "enable git") (line-blame-mode 1)
          (lb-gui-wait)
          (let* ((prefix (string-width (overlay-get (car line-blame--overlays) 'line-prefix)))
                 (cont (save-excursion (goto-char line2) (vertical-motion 1) (point))))
            ;; Line numbers keep their width; annotation follows them directly.
            (should (= lnum (line-number-display-width)))
            ;; Separator first, so it sits right after the line number's padding.
            (should (string-match-p "\\`│ [0-9.]\\{10\\}  i │ \\'"
                                    (overlay-get (car line-blame--overlays) 'line-prefix)))
            (should (= (lb-gui-x 1) (+ base (* cw prefix))))
            (should (= (lb-gui-x line2) (+ base (* cw prefix))))
            (should (= (lb-gui-x cont) (+ base (* cw prefix))))
            (should (equal fringes (window-fringes window)))
            ;; Horizontal scrolling moves code only; the annotation stays put.
            (setq truncate-lines t)
            (goto-char (+ line2 40))
            (set-window-hscroll window 20)
            (redisplay t)
            (should (= (lb-gui-x (point)) (+ base (* cw (+ prefix 20)))))
            (set-window-hscroll window 0)
            (setq truncate-lines nil)
            ;; A second window on the same buffer shows the same layout.
            (let ((second (split-window-right)))
              (set-window-start second 1)
              (redisplay t)
              (should (= (lb-gui-x 1 second) (lb-gui-x 1 window)))
              ;; The minimap uses the right margin and leaves the prefix alone.
              (when (fboundp 'my-overview-refresh)
                (my-overview-refresh)
                (redisplay t)
                (should (= (lb-gui-x 1) (+ base (* cw prefix)))))
              (delete-window second)
              (when (fboundp 'my-overview-refresh) (my-overview-refresh)))
            (lb-step "hover")
            (let* ((bcol (/ base cw)) (sel (selected-window))
                   (line3 (save-excursion (goto-char line2) (forward-line 1) (point)))
                   (prefix-of (lambda (pos) (get-char-property pos 'line-prefix)))
                   (shades (mapcar (lambda (f) (plist-get f :background))
                                   (line-blame--shade-faces))))
              (goto-char 1)
              (redisplay t)
              ;; Five distinct shades starting from the theme's gutter color.
              (should (cl-every (lambda (a b) (<= (abs (- a b)) 257)) ; HSL rounding
                                (color-values (car shades)) (color-values "#999891")))
              (should (= 5 (length (delete-dups (copy-sequence shades)))))
              (should (equal (car (get-text-property 2 'face (funcall prefix-of 1)))
                             (car (line-blame--shade-faces))))
              ;; Rest on the date, then the nickname: one delay, details at 0.4 s.
              (let ((tips lb-gui-tips))
                (lb-gui-warp window (+ bcol 4) 1)
                (lb-gui-settle 0.2)
                (should line-blame--target)
                (should-not line-blame--shown)
                (lb-gui-warp window (+ bcol 12) 1) ; padding between date and nick
                (lb-gui-settle 0.1)
                (lb-gui-warp window (+ bcol 14) 1)
                (lb-gui-settle 0.25)
                (should (eq (cadr line-blame--shown) (funcall prefix-of 1)))
                (should (= lb-gui-tips (1+ tips)))
                (let ((tip (buffer-local-value 'posframe--frame
                                                (get-buffer " *Blame details*"))))
                  (should (eq (frame-parent tip) (window-frame sel)))
                  (should (= (frame-parameter tip 'child-frame-border-width) 2))
                  (should (= (frame-parameter tip 'left-fringe) 12))
                  (should (= (frame-parameter tip 'right-fringe) 12))
                  (should (equal (frame-parameter tip 'background-color)
                                 (face-background 'tooltip nil t))))
                (should (eq (selected-window) sel))
                (should (= (point) 1)))
              ;; Code, line numbers and both separators are not targets.
              (dolist (col (list (+ bcol prefix 1) (- bcol 2) bcol (+ bcol 1)
                                 (+ bcol prefix -2)))
                (lb-gui-warp window col 1)
                (lb-gui-settle 0.1)
                (should-not line-blame--target)
                (should-not line-blame--shown))
              ;; Moving onto the tooltip hides it.
              (lb-gui-warp window (+ bcol 4) 1)
              (lb-gui-await (lambda () line-blame--shown))
              (should line-blame--shown)
              (let ((inner (frame-edges nil 'inner-edges)))
                (lb-gui-move-pointer (selected-frame) (+ 4 (- (nth 2 line-blame--shown) (nth 0 inner)))
                                          (+ 4 (- (nthcdr 3 line-blame--shown) (nth 1 inner)))))
              (lb-gui-settle 0.1)
              (should-not line-blame--shown)
              ;; A brief pass shows nothing.
              (let ((tips lb-gui-tips))
                (lb-gui-warp window (+ bcol 4) 1)
                (lb-gui-settle 0.15)
                (lb-gui-warp window (+ bcol prefix 1) 1)
                (lb-gui-settle 0.6)
                (should (= lb-gui-tips tips)))
              ;; Blank continuation prefixes are not targets.
              (lb-gui-warp window (+ bcol 4) cont)
              (lb-gui-settle 0.1)
              (should-not line-blame--target)
              ;; Switching lines while the message loads shows only the new line.
              (clrhash line-blame--messages)
              (lb-gui-warp window (+ bcol 4) 1)
              (let ((deadline (+ (float-time) 3)))
                (while (and (zerop (hash-table-count line-blame--fetching))
                            (< (float-time) deadline))
                  (sit-for 0.005)))
              (lb-gui-warp window (+ bcol 4) line3)
              (lb-gui-settle 0.2)
              (should-not line-blame--shown)
              (lb-gui-settle 0.4)
              (lb-gui-await (lambda () (eq (cadr line-blame--shown) (funcall prefix-of line3))))
              (should (eq (cadr line-blame--shown) (funcall prefix-of line3)))
              ;; Scrolling under a resting pointer drops the old line's tip at once.
              (lb-step "hover-scroll")
              (lb-gui-warp window (+ bcol 4) 1)
              (lb-gui-await (lambda () (eq (cadr line-blame--shown) (funcall prefix-of 1))))
              (should (eq (cadr line-blame--shown) (funcall prefix-of 1)))
              (set-window-start window line2)
              (redisplay t)
              (lb-gui-settle 0.1)
              (should-not line-blame--shown)
              (should (eq (cadr line-blame--target) (funcall prefix-of line2)))
              (set-window-start window 1)
              (redisplay t)
              ;; Horizontal scrolling keeps the annotation hoverable.
              (lb-step "hover-hscroll")
              (let ((row (list (cdr (posn-x-y (posn-at-point 1 window))))))
                (setq truncate-lines t)
                (set-window-hscroll window 20)
                (redisplay t)
                (lb-gui-warp window (+ bcol 4) row))
              (lb-gui-await (lambda () (eq (cadr line-blame--shown) (funcall prefix-of 1))))
              (should (eq (cadr line-blame--shown) (funcall prefix-of 1)))
              (set-window-hscroll window 0)
              (setq truncate-lines nil)
              ;; Each window is its own target.
              (lb-step "hover-second-window")
              (let ((second (split-window-right)))
                (set-window-start second 1)
                (redisplay t)
                (lb-gui-warp second (+ bcol 4) 1)
                (lb-gui-settle 0.1)
                (should (eq (car line-blame--target) second))
                (should-not line-blame--shown)
                (lb-gui-await (lambda () (eq (car line-blame--shown) second)))
                (should (eq (car line-blame--shown) second))
                (delete-window second)
                (redisplay t))
              (lb-gui-warp window (+ bcol prefix 1) 1)
              (lb-gui-settle 0.1)
              (should-not line-blame--shown)
              (push (list :tips-shown lb-gui-tips :shades shades) report))
            (push (list :git-prefix-cols prefix :base base :char-width cw) report))
          (lb-step "disable git") (line-blame-mode -1)
          (redisplay t)
          (should-not line-blame--poll-timer)
          (should-not line-blame--shown)
          (should (= (lb-gui-x 1) base))
          (should (equal margins (window-margins window)))
          ;; Editing hides blame; diff-hl then marks the change as usual.
          (line-blame-mode 1)
          (lb-gui-wait)
          (goto-char (point-max))
          (insert "added\n")
          (should-not line-blame-mode)
          (lb-step "save") (save-buffer)
          (diff-hl-update)
          (let ((deadline (+ (float-time) 10)))
            (while (and (not (cl-some (lambda (o) (overlay-get o 'diff-hl))
                                      (overlays-in 1 (point-max))))
                        (< (float-time) deadline))
              (accept-process-output nil 0.1)))
          (should (cl-some (lambda (o) (overlay-get o 'diff-hl)) (overlays-in 1 (point-max)))))
        ;; Real Arc mount: asynchronous fetch and placement after line numbers.
        (when (file-exists-p lb-arc-file)
          (lb-step "visit arc") (find-file lb-arc-file)
          (redisplay t)
          (let ((base (lb-gui-x (point-min))) (start (float-time)))
            (line-blame-mode 1)
            (push (list :arc-returned-after (- (float-time) start)) report)
            (lb-gui-wait)
            (should (= (length line-blame--overlays)
                       (count-lines (point-min) (point-max))))
            (should (= (lb-gui-x (point-min))
                       (+ base (* cw (string-width (overlay-get (car line-blame--overlays)
                                                                'line-prefix))))))
            (push (list :arc-sample (overlay-get (car (last line-blame--overlays)) 'line-prefix)
                        :arc-seconds (- (float-time) start))
                  report)
            ;; Arc details come from blame itself: shown after the delay, no fetch.
            (let ((tips lb-gui-tips))
              (lb-gui-warp (selected-window) (+ (/ base cw) 4) (point-min))
              (lb-gui-await
               (lambda () (eq (cadr line-blame--shown)
                               (get-char-property (point-min) 'line-prefix))))
              (should (eq (cadr line-blame--shown) (get-char-property (point-min) 'line-prefix)))
              (should (= lb-gui-tips (1+ tips)))
              (should (zerop (hash-table-count line-blame--fetching))))
            (line-blame-mode -1)
            (should-not line-blame--shown)
            (redisplay t)
            (should (= (lb-gui-x (point-min)) base))))
        (with-temp-file (expand-file-name "result" user-emacs-directory)
          (prin1 (cons 'passed (reverse report)) (current-buffer)))
        (kill-emacs 0))
    (error
     (with-temp-file (expand-file-name "result" user-emacs-directory)
       (prin1 (list 'failed err) (current-buffer)))
     (kill-emacs 1))))

(add-hook 'emacs-startup-hook (lambda () (run-with-timer 1 nil #'lb-gui-check)))
