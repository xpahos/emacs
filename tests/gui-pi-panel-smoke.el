;;; gui-pi-panel-smoke.el --- Real ACP and resizable panel check -*- lexical-binding: t; -*-
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "Test home required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "init.el" (or (getenv "EMACS_TEST_CONFIG")
                                     (expand-file-name ".." (file-name-directory load-file-name)))) nil t)
(require 'ert)

(defun my-test-pi-panel ()
  (condition-case err
      (let* ((root (expand-file-name "one/" user-emacs-directory))
             (other (expand-file-name "two/" user-emacs-directory))
             (test-home (expand-file-name "pi-home/" user-emacs-directory))
             (agent-shell-pi-environment
              (list (concat "HOME=" test-home)
                    (concat "PI_CODING_AGENT_DIR=" test-home "agent")
                    "ANTHROPIC_API_KEY=pi-panel-test-placeholder"))
             buffer width)
        (make-directory root t)
        (make-directory other t)
        (make-directory test-home t)
        (set-frame-size nil 160 45)
        (my-project-open root)
        (let ((source (selected-window)))
          (my-pi-toggle)
          (setq buffer (current-buffer))
          (should (derived-mode-p 'agent-shell-mode))
          (should (equal (file-truename default-directory) (file-truename root)))
          (should (eq (window-parameter nil 'window-side) 'right))
          (should-not tab-line-format)
          (should-not window-size-fixed)
          (let ((deadline (+ (float-time) 25)))
            (while (and (not (agent-shell-initialized-p :shell-buffer buffer))
                        (< (float-time) deadline))
              (accept-process-output nil 0.1)))
          (should (agent-shell-initialized-p :shell-buffer buffer))
          (should (agent-shell-session-id :shell-buffer buffer))
          (should (my-pi-history-get (agent-shell-session-id :shell-buffer buffer)))
          ;; Reloading must update a chat that still has the old header.
          (let ((agent-shell-header-style 'text))
            (agent-shell--update-header-and-mode-line))
          (should header-line-format)
          (load (symbol-file 'my-pi-setup-mode-line 'defun) nil t)
          (should (string-match-p "Chats" (format-mode-line header-line-format)))
          ;; Exercise the actual mode-line rendering and its mouse menus.
          (agent-shell--update-usage-from-notification
           :state (agent-shell--state) :acp-update '((used . 12000) (size . 200000)))
          (agent-shell--update-header-and-mode-line)
          (let ((line (format-mode-line mode-line-format)))
            (should (string-match-p "12k/200k" line))
            (should (string-match-p "(6%)" line))
            (should-not (string-match-p "%%" line))
            (dolist (getter '(agent-shell-get-model-name agent-shell-get-thought-level-name))
              (let* ((name (funcall getter (agent-shell--state)))
                     (start (and name (string-match (regexp-quote name) line)))
                     (map (and start (get-text-property start 'local-map line))))
                (should start)
                (should (keymapp (lookup-key map [mode-line mouse-1]))))))
          ;; Reload bypasses my-pi-start-chat but must keep history tracking.
          (let ((id (agent-shell-session-id)))
            (agent-shell-reload)
            (setq buffer (current-buffer))
            (let ((deadline (+ (float-time) 25)))
              (while (and (not (agent-shell-initialized-p :shell-buffer buffer))
                          (< (float-time) deadline))
                (accept-process-output nil 0.1)))
            (should (agent-shell-initialized-p :shell-buffer buffer))
            (should (equal id (agent-shell-session-id)))
            (should (equal my-pi-root (my-pi-history-root root)))
            (should (eq buffer (gethash id my-pi-sessions)))
            (should (seq-find (lambda (sub) (eq (map-elt sub :on-event) #'my-pi-on-event))
                              (map-elt (agent-shell--state) :event-subscriptions))))
          (setq width (window-total-width))
          (window-resize nil 8 t)
          (should (= (window-total-width) (+ width 8)))
          (window-resize nil -3 t)
          (setq width (window-total-width))
          (my-pi-toggle)
          (should (eq (selected-window) source))
          (should-not (get-buffer-window buffer))
          (should (agent-shell-initialized-p :shell-buffer buffer))
          (my-pi-toggle)
          (should (eq (current-buffer) buffer))
          (should (<= (abs (- width (window-total-width))) 1))
          (select-window source)
          (my-project-open other)
          (should-not (get-buffer-window buffer))
          (my-pi-toggle)
          (should-not (eq (current-buffer) buffer))
          (should (equal (file-truename default-directory) (file-truename other)))
          (my-project-open root)
          (my-pi-toggle)
          (should (eq (current-buffer) buffer)))
        (should-not (file-exists-p (expand-file-name ".agent-shell" root)))
        (should-not (file-exists-p (expand-file-name ".gitignore" root)))
        (when (fboundp 'my-test-history-extra) (my-test-history-extra root buffer))
        (with-temp-file (expand-file-name "passed" user-emacs-directory)
          (insert "Real pi-acp session, resizing, hide/show width, focus and project isolation passed. No model prompt sent.\n"))
        (dolist (shell (agent-shell-buffers))
          (with-current-buffer shell (agent-shell--shutdown)))
        (kill-emacs 0))
    (error
     (dolist (name (append '("*Warnings*" "*Messages*") (mapcar #'buffer-name (agent-shell-buffers))))
       (when-let* ((buffer (get-buffer name)))
         (with-temp-file (expand-file-name (concat (replace-regexp-in-string "[* ]" "_" name) ".log")
                                          user-emacs-directory)
           (insert-buffer-substring buffer))))
     (with-temp-file (expand-file-name "failure" user-emacs-directory)
       (prin1 (list err :selected-buffer (buffer-name (window-buffer (selected-window)))
                    :windows (mapcar (lambda (w) (list (buffer-name (window-buffer w))
                                                        (window-parameter w 'window-side)))
                                     (window-list)))
              (current-buffer)))
     (kill-emacs 1))))

(add-hook 'emacs-startup-hook
          (lambda () (run-with-timer 1 nil #'my-test-pi-panel)))
