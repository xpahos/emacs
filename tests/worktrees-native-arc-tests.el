(ert-deftest my-wt-native-action-matrix ()
  (dolist (case '((equal t nil checkout) (ahead t nil publish)
                  (ahead nil nil error) (behind t nil error) (diverged t nil error)
                  (unpublished t t publish) (equal t t bind)
                  (remote-missing t nil error)))
    (pcase-let ((`(,relation ,own ,unbound ,want) case))
      (let ((r (list :relation relation :owned-remote own :unbound unbound
                     :local "X" :remote "users/test/X" :login "test")))
        (if (eq want 'error) (should-error (my-wt-arc-creation-action r) :type 'user-error)
          (should (eq want (my-wt-arc-creation-action r))))))))

