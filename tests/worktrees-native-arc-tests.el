(ert-deftest my-wt-native-report-fetches-before-comparing ()
  (let* ((a (my-wt-test-sha ?a)) (b (my-wt-test-sha ?b))
         (source '(:copy_id "source" :vcs "arc" :vcs_root "/tmp/" :directory "/tmp/"))
         (branches (my-wt-test-branches (list "users/other/X" a t "cloudia/users/other/X")
                                       (list "cloudia/users/other/X" b nil nil)))
         calls report failure)
    (cl-letf (((symbol-function 'my-wt-run)
               (lambda (_dir _program args callback)
                 (push args calls)
                 (pcase (car args)
                   ("info" (funcall callback 0 "{\"repository\":\"cloudia\",\"user_login\":\"test\"}" ""))
                   ("branch" (funcall callback 0 branches ""))
                   ("status" (funcall callback 0 "{\"branch_info\":{},\"status\":{}}" ""))
                   ("fetch" (funcall callback 0 "" ""))
                   ("rev-parse" (funcall callback 0 b ""))
                   ("merge-base" (funcall callback 0 "{\"ahead\":1,\"behind\":2}" ""))
                   (_ (error "Unexpected %S" args))))))
      (my-wt-arc-ref-report source '(:branch "users/other/X")
                            (lambda (r e) (setq report r failure e))))
    (should-not failure)
    (should (eq (plist-get report :relation) 'diverged))
    (should-not (plist-get report :owned-remote))
    (should (equal (plist-get report :local) "users/other/X"))
    (should (equal (plist-get report :remote) "users/other/X"))
    (should (< (cl-position "fetch" (reverse calls) :key #'car :test #'equal)
               (cl-position "merge-base" (reverse calls) :key #'car :test #'equal)))))

(ert-deftest my-wt-native-network-error-never-means-unpublished ()
