                 (pcase (car args)
                   ("info" (funcall cb 0 "{\"repository\":\"cloudia\",\"user_login\":\"test\"}" ""))
                   ("branch" (funcall cb 0 (my-wt-test-branches (list "X" (my-wt-test-sha ?a) t nil)) ""))
                   ("status" (funcall cb 0 "{\"branch_info\":{},\"status\":{}}" ""))
                   ("fetch" (funcall cb 1 "" "network unavailable"))
                   (_ (error "Must stop: %S" args))))))
      (my-wt-arc-ref-report '(:vcs_root "/tmp/") '(:branch "X") (lambda (r e) (setq report r failure e))))
    (should failure)
    (should-not report)))

