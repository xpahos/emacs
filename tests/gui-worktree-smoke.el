;;; gui-worktree-smoke.el --- Working-copy picker and restart check -*- lexical-binding: t; -*-
;; Run twice with EMACS_TEST_PHASE=save, then restore, sharing a fresh
;; EMACS_TEST_HOME.  Only temporary repositories in that home are touched.
(setq user-emacs-directory
      (file-name-as-directory (file-truename (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME is required")))))
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)

(defvar my-test-wt-repo (expand-file-name "src/repo/" user-emacs-directory))
(defvar my-test-wt-root (expand-file-name "sub/" my-test-wt-repo))

(defun my-test-wt-wait (predicate what)
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05) (redisplay t))
    (unless (funcall predicate) (error "Timed out waiting for %s" what))))

(defun my-test-wt-git (&rest args)
  (let ((result (apply #'my-wt-call my-test-wt-repo "git" args)))
    (unless (zerop (car result)) (error "git %S: %s" args (cdr result)))
    (string-trim (cdr result))))

(defun my-test-wt-picker-labels ()
  "Labels of copy rows currently listed in the picker."
  (with-current-buffer (window-buffer (frame-root-window my-wt-picker-frame))
    (let (labels (pos (point-min)))
      (while (setq pos (next-button pos))
        (let ((label (button-label (button-at pos))))
          (unless (string-match-p "\\`\\(\\+ \\|Delete\\|Retry\\|Back\\'\\|New branch from here\\)" label) (push label labels))))
      (nreverse labels))))

(defun my-test-wt-type (text)
  (with-current-buffer (window-buffer (frame-root-window my-wt-picker-frame))
    (goto-char my-wt-picker-input-end)
    (delete-region my-wt-picker-input-start my-wt-picker-input-end)
    (insert text))
  (let ((deadline (+ (float-time) 1))) (while (< (float-time) deadline) (accept-process-output nil 0.05))))

(defun my-test-wt-shot (name)
  "Capture the real Emacs window as NAME.png in the test home, if macOS allows it."
  (redisplay t)
  (let ((id (frame-parameter (window-frame (treemacs-get-local-window)) 'window-id)))
    (when id
      (call-process "screencapture" nil nil nil "-x" "-o" "-l" id
                    (expand-file-name (concat name ".png") user-emacs-directory)))))

(defun my-test-wt-frame (branch)
  "The tree header is one framed row in the real window: BRANCH left, + right."
  (let* ((tree (treemacs-get-local-window)) (editor (selected-window)))
    (cl-assert tree)
    (with-current-buffer (window-buffer tree)
      (dolist (face '(header-line header-line-active header-line-inactive))
        (cl-assert (memq 'my-wt-header-frame (alist-get face face-remapping-alist))))
      (cl-assert (equal (face-attribute 'my-wt-header-frame :box) '(:line-width (-1 . -1) :color "#73726b"))))
    ;; Both selected and unselected trees render the header text.
    (dolist (window (list editor tree))
      (select-window window)
      (redisplay t)
      (let ((text (format-mode-line treemacs-user-header-line-format nil tree)))
        (cl-assert (string-prefix-p (concat " " (if (equal (plist-get (my-wt-tab-copy) :role) "original") "⌂ " "⧉ ") branch) text))
        (cl-assert (string-suffix-p " + " text))))
    (with-temp-file (expand-file-name "header.txt" user-emacs-directory)
      (insert (format "header-line %dpx, editor tab-line %dpx, tree width %d cols\n"
                      (window-header-line-height tree) (window-tab-line-height editor) (window-width tree))))
    ;; The frame draws inside the row; it must not make the header taller than the tab line.
    (cl-assert (= (window-header-line-height tree) (window-tab-line-height editor)))
    (select-window editor)))

(defun my-test-wt-save ()
  (make-directory (expand-file-name "sub" my-test-wt-repo) t)
  (my-test-wt-git "init" "-q" "-b" "main")
  (my-test-wt-git "config" "user.email" "t@example.com")
  (my-test-wt-git "config" "user.name" "Test")
  (my-test-wt-git "config" "commit.gpgsign" "false")   ; never needs the user's signing key
  (with-temp-file (expand-file-name "a.txt" my-test-wt-root) (insert "original\n"))
  (my-test-wt-git "add" ".")
  (my-test-wt-git "commit" "-q" "-m" "init")
  (set-frame-size nil 150 45)
  ;; The window system resizes asynchronously; centre against the settled size.
  (let ((last nil))
    (my-test-wt-wait (lambda () (prog1 (equal last (frame-pixel-height)) (setq last (frame-pixel-height))
                                  (sleep-for 0.2)))
                     "frame size"))
  (my-project-open my-test-wt-root)
  (find-file (expand-file-name "a.txt" my-test-wt-root))
  (my-test-wt-wait (lambda () (string-prefix-p " ⌂ main" (my-wt-header))) "branch header")
  (cl-assert (string-suffix-p " + " (my-wt-header)))
  (my-test-wt-frame "main")
  (cl-assert (null (agent-shell-buffers)))           ; no Pi panel is needed
  (let* ((parent (selected-frame)) (before (frame-pixel-height parent)) (picker (my-wt-picker-show)))
    (cl-assert (eq (frame-parameter picker 'parent-frame) parent))
    (cl-assert (frame-parameter picker 'drag-internal-border))
    (cl-assert (frame-parameter picker 'drag-with-header-line))
    (let ((position (frame-position picker)))
      (cl-assert (<= (abs (- (car position) (/ (- (frame-pixel-width parent) (frame-pixel-width picker)) 2))) 6))
      (unless (<= (abs (- (cdr position) (/ (- (frame-pixel-height parent) (frame-pixel-height picker)) 2))) 6)
        (error "Not centred: top %s, picker %s, parent %s (was %s), native %S inner %S"
               (cdr position) (frame-pixel-height picker) (frame-pixel-height parent) before
               (frame-native-height parent) (frame-inner-height parent))))
    (cl-assert (equal (my-test-wt-picker-labels) '("main")) nil
               "Unexpected copy rows: %S; content: %S" (my-test-wt-picker-labels)
               (with-current-buffer (window-buffer (frame-root-window picker)) (buffer-string)))
    (with-current-buffer (window-buffer (frame-root-window picker))
      (cl-assert (null my-wt-picker-input-start))
      (cl-assert (equal (button-label (button-at (point))) "main")))
    (set-frame-position picker 30 40)
    (my-wt-picker-set-size picker 500 300)
    (let ((size (cons (frame-pixel-width picker) (frame-pixel-height picker))))
      (my-wt-picker-close)
      (cl-assert (not (frame-live-p picker)))
      (setq picker (my-wt-picker-show))
      (cl-assert (equal (frame-position picker) '(30 . 40)))
      (cl-assert (equal size (cons (frame-pixel-width picker) (frame-pixel-height picker)))))
    (set-frame-position picker (frame-pixel-width parent) (frame-pixel-height parent))
    (my-wt-picker-constrain parent)
    (let ((position (frame-position picker)))
      (cl-assert (<= (+ (car position) (frame-pixel-width picker)) (frame-pixel-width parent)))
      (cl-assert (<= (+ (cdr position) (frame-pixel-height picker)) (frame-pixel-height parent))))
    ;; Search is only available when selecting a branch for a new copy.
    (with-current-buffer (window-buffer (frame-root-window picker)) (my-wt-picker-branch-mode))
    (my-test-wt-wait (lambda () (listp (buffer-local-value 'my-wt-picker-branches (window-buffer (frame-root-window picker))))) "branches")
    (cl-assert (null (my-test-wt-picker-labels)))
    (my-test-wt-type "MAI")
    (cl-assert (member "main" (my-test-wt-picker-labels)))
    (my-test-wt-type "a[")
    (cl-assert (null (my-test-wt-picker-labels)))
    (my-test-wt-type "mai")
    (cl-assert (member "main" (my-test-wt-picker-labels)))
    (execute-kbd-macro (kbd "C-g"))
    (cl-assert (not (frame-live-p my-wt-picker-frame))))
  (let* ((source (my-wt-tab-copy))
         (copy (my-wt-create source (list :branch "CLOUD-1-gui" :new t :start (my-wt-resolve-start source)))))
    (my-test-wt-wait (lambda () (equal (plist-get (my-wt-copy (plist-get copy :copy_id)) :state) "ready")) "copy")
    (my-wt-switch (my-wt-copy (plist-get copy :copy_id)))
    (find-file (expand-file-name "a.txt" (plist-get copy :directory)))
    (my-test-wt-wait (lambda () (string-prefix-p " ⧉ CLOUD-1-gui" (my-wt-header))) "copy header")
    (my-test-wt-frame "CLOUD-1-gui")
    (my-test-wt-shot "header-copy")
    ;; A long branch is truncated; + stays at the right edge after resizing the sidebar.
    (let ((long "CLOUD-2-a-very-long-branch-name-that-would-otherwise-push-the-plus-button-out-of-sight"))
      (puthash (plist-get copy :directory) (list :branch long :revision (make-string 40 ?a)) my-wt-branches)
      (let ((tree (treemacs-get-local-window)))
        (dolist (delta '(0 12 -8))
          (unless (zerop delta) (with-current-buffer (window-buffer tree) (let ((window-size-fixed nil)) (window-resize tree delta t))))
          (redisplay t)
          (let ((text (format-mode-line treemacs-user-header-line-format nil tree)))
            (cl-assert (string-suffix-p " + " text))
            (cl-assert (<= (string-width text) (window-width tree))))))
      (my-test-wt-shot "header-long"))
    (my-wt-refresh-branch (my-wt-copy (plist-get copy :copy_id)))
    (cl-assert (= (length (tab-bar-tabs)) 2))
    (with-temp-file (expand-file-name "copy-dir" user-emacs-directory) (prin1 (plist-get copy :directory) (current-buffer))))
  (tabspaces-save-session))

(defun my-test-wt-restore ()
  (let ((copy-dir (with-temp-buffer (insert-file-contents (expand-file-name "copy-dir" user-emacs-directory))
                                    (read (current-buffer)))))
    (cl-assert (= (length (tab-bar-tabs)) 2))
    (tab-bar-select-tab 2)
    (cl-assert (equal (alist-get 'my-project-root (tab-bar--current-tab)) copy-dir))
    (cl-assert (get-file-buffer (expand-file-name "a.txt" copy-dir)))
    (cl-assert (equal (mapcar #'treemacs-project->path (treemacs-workspace->projects (treemacs-current-workspace)))
                      (list (directory-file-name copy-dir))))
    (cl-assert (null (agent-shell-buffers)))           ; agents are not restarted
    (my-test-wt-wait (lambda () (string-prefix-p " ⧉ CLOUD-1-gui" (my-wt-header))) "restored header")
    (my-project-open my-test-wt-root)
    (cl-assert (= (length (tab-bar-tabs)) 2))
    (cl-assert (equal (alist-get 'my-project-root (tab-bar--current-tab)) my-test-wt-root))
    (cl-assert (get-file-buffer (expand-file-name "a.txt" my-test-wt-root)))
    (cl-assert (not (eq (get-file-buffer (expand-file-name "a.txt" my-test-wt-root))
                        (get-file-buffer (expand-file-name "a.txt" copy-dir)))))))

(defun my-test-wt-run ()
  (let ((phase (getenv "EMACS_TEST_PHASE")))
    (condition-case err
        (progn
          (pcase phase ("save" (my-test-wt-save)) ("restore" (my-test-wt-restore)) (_ (error "Unknown phase %s" phase)))
          (with-temp-file (expand-file-name (concat phase ".passed") user-emacs-directory)
            (insert (format "Working-copy GUI %s phase passed.\n" phase)))
          (kill-emacs 0))
      (error
       (with-temp-file (expand-file-name "failure.txt" user-emacs-directory)
         (insert phase ": ") (prin1 err (current-buffer)))
       (kill-emacs 1)))))

(add-hook 'emacs-startup-hook (lambda () (run-with-timer 1 nil #'my-test-wt-run)) 90)
