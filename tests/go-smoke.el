;;; go-smoke.el --- Real Eglot/gopls integration check -*- lexical-binding: t; -*-
(load (expand-file-name "projects-tests.el" (file-name-directory load-file-name)) nil t)
(let* ((root (file-name-as-directory (make-temp-file "emacs-go-smoke-" t)))
       (file (expand-file-name "main.go" root))
       (eglot-connect-timeout 15)
       (project--list nil))
  (unwind-protect
      (progn
        (with-temp-file (expand-file-name "go.mod" root)
          (insert "module example.test/demo\n\ngo 1.24\n"))
        (with-temp-file file
          (insert "package demo\n\nfunc answer() int { return 42 }\nfunc value() int { return answer() }\n"))
        (my-project-open root)
        (find-file file)
        (cl-assert (eq major-mode 'go-ts-mode))
        (cl-assert (null eglot-sync-connect))
        (run-hooks 'post-command-hook)
        (let ((deadline (+ (float-time) 15)))
          (while (and (not (eglot-managed-p)) (< (float-time) deadline))
            (accept-process-output nil 0.05)))
        (cl-assert (eglot-current-server))
        (goto-char (point-max))
        (search-backward "answer")
        (let ((definitions (xref-backend-definitions 'eglot "answer")))
          (cl-assert definitions)
          (cl-assert (= (xref-file-location-line (xref-item-location (car definitions))) 3)))
        (princ "Real gopls connected; Go definition resolved to line 3.\n"))
    (when-let* ((server (eglot-current-server))) (eglot-shutdown server))
    (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
    (delete-directory root t)))
