;;; gui-overview-smoke.el --- Exercise overview frames without user files -*- lexical-binding: t; -*-
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "Test home required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(require 'ert)
(require 'dom)

(defun my-overview-gui-check ()
  (condition-case err
      (let* ((parent (selected-frame))
             (source (selected-window))
             (margins (window-margins source))
             (file (expand-file-name "example.txt" user-emacs-directory)))
        (with-temp-file file
          (dotimes (i 200) (insert (format "Example line %d\n" (1+ i)))))
        (let ((default-directory user-emacs-directory))
          (should (zerop (call-process "git" nil nil nil "init" "--quiet")))
          (should (zerop (call-process "git" nil nil nil "add" "example.txt")))
          (should (zerop (call-process "git" nil nil nil
                                      "-c" "user.name=Overview Test"
                                      "-c" "user.email=overview@example.invalid"
                                      "-c" "commit.gpgsign=false"
                                      "-c" "core.hooksPath=/dev/null"
                                      "commit" "--quiet" "-m" "Fixture"))))
        (find-file file)
        (goto-char (point-min))
        (forward-line 19)
        (delete-region (point) (line-end-position))
        (insert "Changed line")
        (goto-char (point-min))
        (forward-line 79)
        (delete-region (point) (progn (forward-line 1) (point)))
        (goto-char (point-min))
        (forward-line 139)
        (dotimes (_ 5) (insert "Inserted line\n"))
        (goto-char (point-max))
        (insert "Inserted at EOF\n")
        (diff-hl-update)
        (let ((deadline (+ (float-time) 10)))
          (while (and (< (length (cdr (my-overview-data))) 4)
                      (< (float-time) deadline))
            (accept-process-output nil 0.05)))
        (should (equal (mapcar (lambda (mark) (cl-subseq mark 0 3))
                              (cdr (my-overview-data)))
                       '((20 20 change) (80 80 delete) (140 144 insert)
                         (205 205 insert))))
        (let* ((scrollbars (window-scroll-bars source))
               (error-pos (progn (goto-char 1) (forward-line 59) (point)))
               (diag (flymake-make-diagnostic (current-buffer) error-pos (1+ error-pos)
                                              :error "Example error"))
               (overlay (make-overlay error-pos (1+ error-pos))))
          (overlay-put overlay 'flymake-diagnostic diag)
          (dolist (entry '((100 . :warning) (120 . :note)))
            (goto-char (point-min))
            (forward-line (1- (car entry)))
            (overlay-put (make-overlay (point) (1+ (point))) 'flymake-diagnostic
                         (flymake-make-diagnostic (current-buffer) (point) (1+ (point))
                                                 (cdr entry) "Example diagnostic")))
          (my-overview-refresh)
          (redisplay t)
          (my-overview-refresh)
          (redisplay t)
          (should (eq (selected-frame) parent))
          (should (eq (selected-window) source))
          (should (= (length my-overview-views) 1))
          ;; Reloading project/UI settings must not put project tabs in the narrow stripe.
          (tab-bar-mode 1)
          (should (zerop (frame-parameter (my-overview-view-frame (car my-overview-views)) 'tab-bar-lines)))
          (let* ((view (car my-overview-views))
                 (frame (my-overview-view-frame view))
                 (height (frame-pixel-height frame))
                 (x (frame-parameter frame 'left))
                 (data (my-overview-data))
                 (y (my-overview-y 60 (car data) height))
                 (position (posn-at-x-y 3 (1+ y) (frame-root-window frame))))
            (let* ((image (with-current-buffer (my-overview-view-buffer view)
                            (get-text-property (point-min) 'display)))
                   (svg (with-temp-buffer
                          (insert (plist-get (cdr image) :data))
                          (libxml-parse-xml-region (point-min) (point-max))))
                   (rectangles (dom-by-tag svg 'rect)))
              (should (= (length (cdr data)) 7))
              (dolist (mark (cdr data))
                (let* ((type (nth 2 mark))
                       (lane (if (memq type '(insert change delete)) 9 1))
                       (top (my-overview-y (car mark) (car data) height))
                       (color (alist-get type my-overview-colors))
                       (hit (posn-at-x-y (+ lane 2) (1+ top)
                                        (frame-root-window frame))))
                  (should (seq-some
                           (lambda (rect)
                             (and (equal (dom-attr rect 'fill) color)
                                  (= (string-to-number (dom-attr rect 'x)) lane)
                                  (= (string-to-number (dom-attr rect 'y)) top)))
                           rectangles))
                  (should (posn-image hit))
                  (should (= (car (posn-object-x-y hit)) (+ lane 2)))
                  (my-overview-click (list 'mouse-1 hit))
                  (should (= (window-point source) (nth 3 mark))))))
            (with-temp-file (expand-file-name "geometry" user-emacs-directory)
              (prin1 (list :outer (window-pixel-edges source)
                           :inner (window-inside-pixel-edges source)
                           :scrollbars scrollbars :fringes (window-fringes source)
                           :child (list x (frame-parameter frame 'top)
                                        (frame-pixel-width frame) height)
                           :child-body (window-inside-pixel-edges (frame-root-window frame))
                           :child-fringes (window-fringes (frame-root-window frame))
                           :hscroll (window-hscroll (frame-root-window frame))
                           :image-position position) (current-buffer)))
            (should (>= x (nth 2 (window-inside-pixel-edges source))))
            (should (<= (+ x (frame-pixel-width frame))
                        (- (nth 2 (window-pixel-edges source)) 10)))
            (should (= (frame-pixel-width frame)
                       (+ my-overview-width (frame-char-width frame))))
            (should (= height (window-body-height source t)))
            (should (posn-object-x-y position))
            (my-overview-click (list 'mouse-1 position))
            (should (eq (selected-frame) parent))
            (should (= (window-point source) error-pos))
            (should (equal scrollbars (window-scroll-bars source))))
          (let ((second (split-window-right)))
            (my-overview-refresh)
            (redisplay t)
            (my-overview-refresh)
            (redisplay t)
            (should (= (length my-overview-views) 2))
            (dolist (view my-overview-views)
              (should (= (frame-pixel-height (my-overview-view-frame view))
                         (window-body-height (my-overview-view-window view) t))))
            (delete-window second)
            (my-overview-refresh)
            (should (= (length my-overview-views) 1)))
          (let ((state (window-state-get (frame-root-window parent) t)))
            (my-overview-mode -1)
            (window-state-put state (frame-root-window parent) 'safe)
            (setq source (selected-window))
            (my-overview-mode 1)
            (my-overview-refresh)
            (should (= (cdr (window-margins source))
                       (ceiling (+ my-overview-width
                                   (frame-char-width (my-overview-view-frame
                                                     (car my-overview-views))))
                                (frame-char-width parent)))))
          (my-overview-mode -1)
          (should-not my-overview-views)
          (should (equal margins (window-margins source)))
          (should-not (cl-find-if (lambda (f) (frame-parameter f 'my-overview-view))
                                 (frame-list)))
          (my-overview-mode 1)
          (my-overview-refresh)
          (should (= (length my-overview-views) 1))
          (switch-to-buffer (get-buffer-create "*overview-test-tools*"))
          (special-mode)
          (my-overview-refresh)
          (should-not my-overview-views)
          (should (equal margins (window-margins source))))
        (with-temp-file (expand-file-name "passed" user-emacs-directory)
          (insert "Real Git insert/change/delete markers, all diagnostic colors, clicks, geometry, split and cleanup passed.\n"))
        (kill-emacs 0))
    (error
     (with-temp-file (expand-file-name "failure" user-emacs-directory)
       (prin1 err (current-buffer)))
     (kill-emacs 1))))

(add-hook 'emacs-startup-hook
          (lambda () (run-with-timer 1 nil #'my-overview-gui-check)))
