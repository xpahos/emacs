;;; gui-disk-changes-pixel-scroll.el --- Pixel scrolling keeps comparison panes aligned -*- lexical-binding: t; -*-
;; Run: EMACS_TEST_HOME=$(mktemp -d) Emacs -Q -l tests/gui-disk-changes-pixel-scroll.el
(setq user-emacs-directory
      (file-name-as-directory (or (getenv "EMACS_TEST_HOME") (error "EMACS_TEST_HOME required"))))
(redisplay t)
(require 'eglot)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(require 'pixel-scroll)

(defvar my-test-log nil)

(defun my-test-settle ()
  (dotimes (_ 5) (redisplay t) (accept-process-output nil 0.05)))

(defun my-test-lines (from to)
  (mapconcat (lambda (n) (format "\tcommon(%d)\n" n)) (number-sequence from to) ""))

(defun my-test-y (window text)
  (with-current-buffer (window-buffer window)
    (save-excursion
      (goto-char (point-min))
      (re-search-forward (concat "^" (regexp-quote text) "$"))
      (cadr (pos-visible-in-window-p (line-beginning-position) window t)))))

(defun my-test-aligned (a b what)
  "Assert both panes share the aligned top and draw common lines at the same height."
  (let ((ta (my-disk-top a)) (tb (my-disk-top b)) (checked 0))
    (push (list what ta tb (window-vscroll a t) (window-vscroll b t)) my-test-log)
    (cl-assert (= ta tb) nil "%s: tops %d / %d" what ta tb)
    (dolist (n (number-sequence 1 120))
      (let ((ya (my-test-y a (format "\tcommon(%d)" n))) (yb (my-test-y b (format "\tcommon(%d)" n))))
        (when (and ya yb)
          (cl-incf checked)
          (cl-assert (= ya yb) nil "%s: common(%d) at %s / %s" what n ya yb))))
    (cl-assert (> checked 5) nil "%s: only %d common lines visible" what checked)
    ta))

(defun my-test-pixel (window delta)
  "Scroll WINDOW by DELTA pixels (positive: further into the file) as pixel-scroll does."
  (with-selected-window window
    (if (> delta 0)
        (pixel-scroll-precision-scroll-down delta)
      (pixel-scroll-precision-scroll-up (- delta))))
  (my-test-settle))

(defun my-test-goto (window text)
  (with-current-buffer (window-buffer window)
    (set-window-start window (save-excursion (goto-char (point-min))
                                             (re-search-forward (concat "^" (regexp-quote text) "$"))
                                             (line-beginning-position)))
    (set-window-vscroll window 0 t))
  (my-test-settle))

(defun my-test-run ()
  (let* ((root (expand-file-name "proj/" user-emacs-directory))
         (file (expand-file-name "fixture.go" root))
         (editor (concat "editor_only_top()\n" (my-test-lines 1 20) "\told_middle()\n" (my-test-lines 21 50)
                         "\teditor_only_a()\n\teditor_only_b()\n" (my-test-lines 51 120)))
         (disk (concat (my-test-lines 1 20) "\tnew_middle(1)\n\tnew_middle(2)\n\tnew_middle(3)\n"
                       (my-test-lines 21 50) (my-test-lines 51 65) "\tdisk_only()\n" (my-test-lines 66 120)))
         (h (frame-char-height)))
    (make-directory root t)
    (with-temp-file file (insert editor))
    (set-frame-size nil 200 50)
    (my-project-open root)
    (find-file file)
    (let ((editor-window (selected-window)))
      (ignore-errors (treemacs-select-window))
      (ignore-errors (my-shell-toggle))
      (ignore-errors (my-pi-toggle))
      (select-window editor-window))
    (let ((buffer (current-buffer)))
      (with-temp-file file (insert disk))
      (set-file-times file (time-add nil 5))
      (my-disk-check buffer)
      (my-test-settle)
      (my-disk-compare)
      (my-test-settle)
      (let* ((control (plist-get (buffer-local-value 'my-disk-compare buffer) :control))
             (a (buffer-local-value 'ediff-window-A control))
             (b (buffer-local-value 'ediff-window-B control))
             (snapshots (list (window-buffer a) (window-buffer b)))
             (focus (selected-window))
             top)
        (cl-assert (seq-find (lambda (w) (window-parameter w 'window-side)) (window-list nil 'nomini))
                   nil "side panels are not visible")
        ;; 1. A few pixels from the editor pane, inside one line: only the vscroll changes.
        (my-test-goto a "\tcommon(30)")
        (setq top (my-test-aligned a b "start"))
        (let ((start (window-start a)))
          (my-test-pixel a 5)
          (cl-assert (= (window-start a) start) nil "window-start moved for a 5px scroll")
          (cl-assert (= (window-vscroll a t) 5) nil "vscroll %d" (window-vscroll a t)))
        (cl-assert (= (my-test-aligned a b "editor +5") (+ top 5)))
        ;; 2. From the disk pane, both directions.
        (my-test-pixel b 4)
        (cl-assert (= (my-test-aligned a b "disk +4") (+ top 9)))
        (my-test-pixel b -7)
        (cl-assert (= (my-test-aligned a b "disk -7") (+ top 2)))
        (my-test-pixel a -2)
        (cl-assert (= (my-test-aligned a b "editor -2") top))
        ;; 3. Across a line boundary, from both panes and in both directions.
        (my-test-pixel a (+ h 3))
        (cl-assert (= (my-test-aligned a b "editor across line") (+ top h 3)))
        (my-test-pixel b (- (+ h 6)))
        (cl-assert (= (my-test-aligned a b "disk back across line") (- top 3)))
        ;; 4. Through padding rows: the editor pane pads two rows below old_middle().
        (my-test-goto b "\tnew_middle(1)")
        (setq top (my-test-aligned a b "before padding"))
        (dotimes (i 12)
          (my-test-pixel (if (cl-evenp i) a b) 5)
          (cl-assert (= (my-test-aligned a b (format "padding step %d" i)) (+ top (* 5 (1+ i))))))
        (dotimes (i 12)
          (my-test-pixel (if (cl-evenp i) b a) -5)
          (my-test-aligned a b (format "padding back %d" i)))
        (cl-assert (= (my-disk-top a) top))
        ;; 5. Focus never moved; the synchronization stays local to the snapshots.
        (cl-assert (eq focus (selected-window)) nil "focus moved to %S" (selected-window))
        (cl-assert (not (memq #'my-disk-sync (default-value 'pre-redisplay-functions))))
        (dolist (s snapshots)
          (cl-assert (memq #'my-disk-sync (buffer-local-value 'pre-redisplay-functions s))))
        ;; 6. Ordinary scrolling and navigation still align.
        (with-selected-window a (scroll-up 7))
        (my-test-settle)
        (my-test-aligned a b "scroll-up")
        (dotimes (_ 3) (mwheel-scroll (list 'wheel-down (posn-at-point (window-start b) b) 1)))
        (my-test-settle)
        (my-test-aligned a b "wheel")
        (with-current-buffer control (ediff-next-difference) (ediff-next-difference))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control))
        (my-test-aligned a b "next")
        (my-test-pixel b 6)
        (my-test-aligned a b "pixel after next")
        (with-current-buffer control (ediff-previous-difference))
        (my-test-settle)
        (setq a (buffer-local-value 'ediff-window-A control) b (buffer-local-value 'ediff-window-B control))
        (my-test-aligned a b "previous")
        ;; 7. Closing removes the mechanism and leaves user data alone.
        (with-current-buffer control (ediff-really-quit nil))
        (my-test-settle)
        (cl-assert (not (seq-some #'buffer-live-p snapshots)))
        (cl-assert (not (seq-some (lambda (buf) (memq #'my-disk-sync (buffer-local-value 'pre-redisplay-functions buf)))
                                  (buffer-list))))
        (cl-assert (not (memq #'my-disk-sync (default-value 'pre-redisplay-functions))))
        (cl-assert (eq (window-buffer (selected-window)) buffer))
        (cl-assert (equal editor (with-current-buffer buffer (buffer-string))))
        (cl-assert (equal disk (with-temp-buffer (insert-file-contents file) (buffer-string))))))))

(add-hook 'emacs-startup-hook
          (lambda ()
            (run-with-timer
             1 nil
             (lambda ()
               (let ((result (condition-case err (progn (my-test-run) "passed")
                               (error (format "failed: %S" err)))))
                 (with-temp-file (expand-file-name "result" user-emacs-directory)
                   (insert result "\n")
                   (pp (reverse my-test-log) (current-buffer)))
                 (kill-emacs (if (equal result "passed") 0 1)))))))
