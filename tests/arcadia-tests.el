;;; arcadia-tests.el --- Arc gutter integration checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'package)
(defconst my-arc-test-config-dir
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(setq user-emacs-directory (make-temp-file "emacs-arc-tests-" t)
      package-user-dir (expand-file-name "elpa" my-arc-test-config-dir))
(package-initialize)
(load (expand-file-name "arcadia.el" my-arc-test-config-dir) t t)

(ert-deftest my-arc-state-understands-staged-and-unstaged-changes ()
  (dolist (case '(("{}" . up-to-date)
                  ("{\"changed\":[{\"status\":\"modified\"}]}" . edited)
                  ("{\"staged\":[{\"status\":\"modified\"}]}" . edited)
                  ("{\"staged\":[{\"status\":\"new file\"}]}" . added)
                  ("{\"staged\":[{\"status\":\"renamed\"}]}" . added)
                  ("{\"staged\":[{\"status\":\"deleted\"}]}" . removed)
                  ("{\"unmerged\":[{}]}" . conflict)
                  ("{\"untracked\":[{}]}" . unregistered)
                  ("{\"ignored\":[{}]}" . ignored)))
    (cl-letf (((symbol-function 'vc-arc--output)
               (lambda (&rest _) (concat "{\"status\":" (car case) "}"))))
      (should (eq (vc-arc-state "/tmp/example.go") (cdr case))))))

(ert-deftest my-arc-state-survives-arc-failure ()
  (let ((debug-on-error nil) (inhibit-message t))
    (cl-letf (((symbol-function 'vc-arc--output)
               (lambda (&rest _) (error "Timed out waiting for: arc status"))))
      (should-not (vc-arc-state "/tmp/example.go")))))

(ert-deftest my-arc-head-change-is-visible-on-the-next-diff ()
  (let ((head "abc123"))
    (cl-letf (((symbol-function 'vc-arc-root) (lambda (_) "/tmp/arc root/"))
              ((symbol-function 'vc-arc--output)
               (lambda (&rest _) head)))
      (should (equal (diff-hl-working-revision "/tmp/arc root/a.go" 'Arc) "abc123"))
      (setq head "def456")
      (should (equal (diff-hl-working-revision "/tmp/arc root/a.go" 'Arc) "def456")))))

(ert-deftest my-arc-mode-line-shows-branch-and-updates-with-status ()
  (let ((file (make-temp-file "arc-branch-"))
        (branch "feature/example") (calls 0))
    (unwind-protect
        (cl-letf (((symbol-function 'vc-arc--output)
                   (lambda (_file &rest args)
                     (cl-incf calls)
                     (should (equal (car args) "status"))
                     (should (member "--branch" args))
                     (json-serialize
                      `(:status (:changed [(:path "file")])
                        :branch_info (:local (:name ,branch :commit (:id "abc123456789"))))))))
          (vc-file-setprop file 'vc-backend 'Arc)
          (dolist (case '(("feature/example" . "feature/example")
                          ("trunk" . "trunk") ("" . "detached@abc1234")))
            (setq branch (car case))
            (vc-state-refresh file 'Arc)
            (let ((before calls))
              (vc-mode-line file 'Arc)
              (should (equal (substring-no-properties vc-mode) (concat " " (cdr case))))
              (should (get-text-property 1 'help-echo vc-mode))
              (should (= calls before)))))
      (vc-file-clearprops file)
      (delete-file file))))

(ert-deftest my-git-mode-line-shows-only-the-branch ()
  (let* ((root (make-temp-file "git-branch-" t))
         (default-directory (file-name-as-directory root))
         (file (expand-file-name "file.txt" root)))
    (unwind-protect
        (progn
          (should (zerop (call-process "git" nil nil nil "init" "--quiet" "-b" "main")))
          (with-temp-file file (insert "text\n"))
          (should (zerop (call-process "git" nil nil nil "add" "file.txt")))
          (vc-mode-line file 'Git)
          (should (equal (substring-no-properties vc-mode) " main"))
          (should (get-text-property 1 'help-echo vc-mode))
          (should (get-text-property 1 'local-map vc-mode)))
      (vc-file-clearprops file)
      (delete-directory root t))))

(ert-deftest my-arc-status-failure-preserves-markers-and-retries ()
  (dolist (old-state '(nil up-to-date edited))
    (let ((file (make-temp-file "arc-state-" nil ".txt" "changed\n")))
      (unwind-protect
          (with-temp-buffer
            (insert "changed\n")
            (setq buffer-file-name file)
            (setq-local diff-hl-mode t)
            (set-buffer-modified-p nil)
            (vc-file-setprop file 'vc-backend 'Arc)
            (vc-file-setprop file 'vc-state old-state)
            (let ((overlay (make-overlay 1 2)) (failed t) (calls 0)
                  (debug-on-error nil) (inhibit-message t))
              (overlay-put overlay 'diff-hl t)
              (cl-letf (((symbol-function 'vc-arc--output)
                         (lambda (&rest _)
                           (cl-incf calls)
                           (if failed (error "status unavailable") "{\"status\":{}}"))))
                (should (eq (vc-state-refresh file 'Arc) old-state))
                (diff-hl-update)
                (should (overlay-buffer overlay))
                (setq failed nil calls 0)
                ;; No text edit is needed for the idle flydiff retry.
                (diff-hl-flydiff-update)
                (should (> calls 0))
                (should (eq (vc-file-getprop file 'vc-state) 'up-to-date))
                (should-not (overlay-buffer overlay)))))
        (vc-file-clearprops file)
        (delete-file file)))))

(ert-deftest my-arc-registration-failure-does-not-cache-unregistered ()
  (let ((file (make-temp-file "arc-registration-"))
        (vc-handled-backends '(Arc)) (failed t) (calls 0))
    (unwind-protect
        (cl-letf (((symbol-function 'vc-arc-root) (lambda (_) temporary-file-directory))
                  ((symbol-function 'vc-arc--output)
                   (lambda (&rest _)
                     (cl-incf calls)
                     (if failed (error "registration unavailable")
                       (file-name-nondirectory file)))))
          (should-not (vc-backend file))
          (should-not (eq (vc-file-getprop file 'vc-backend) 'none))
          (should-not (vc-backend file))
          (should (= calls 1))
          (setq failed nil)
          (vc-file-setprop file 'vc-arc-registration-retry-at 0)
          (should (eq (vc-backend file) 'Arc)))
      (vc-file-clearprops file)
      (delete-file file))))

(ert-deftest my-arc-registration-outage-does-not-break-open-or-save ()
  (let ((file (make-temp-file "arc-open-save-" nil ".txt" "original\n"))
        (vc-handled-backends '(Arc)) opened saved buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'vc-arc-root) (lambda (_) temporary-file-directory))
                  ((symbol-function 'vc-arc--output)
                   (lambda (&rest _) (error "registration unavailable"))))
          (let ((find-file-hook (append find-file-hook (list (lambda () (setq opened t))))))
            (setq buffer (find-file-noselect file)))
          (should opened)
          (with-current-buffer buffer
            (goto-char (point-max)) (insert "saved during outage\n")
            (let ((after-save-hook (append after-save-hook (list (lambda () (setq saved t))))))
              (save-buffer))
            (should saved)
            (should-not (buffer-modified-p)))
          (should-not (eq (vc-file-getprop (buffer-file-name buffer) 'vc-backend) 'none)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))
      (vc-file-clearprops file)
      (delete-file file))))

(ert-deftest my-arc-registration-allows-slow-successful-response ()
  (let* ((root (file-name-as-directory (make-temp-file "arc-slow-" t)))
         (default-directory root)
         (file (expand-file-name "sample.txt" root))
         (arcit-arc-executable (expand-file-name "fake-arc" root))
         (vc-handled-backends '(Arc)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".arc" root))
          (with-temp-file (expand-file-name ".arc/HEAD" root) (insert "test-head\n"))
          (with-temp-file file (insert "text\n"))
          (with-temp-file arcit-arc-executable
            (insert "#!/bin/sh\nsleep 2.5\nprintf 'sample.txt\\n'\n"))
          (set-file-modes arcit-arc-executable #o755)
          (should (eq (vc-backend file) 'Arc)))
      (vc-file-clearprops file)
      (delete-directory root t))))

(ert-deftest my-arc-diff-is-async-and-keeps-paths-as-arguments ()
  (let ((file "/tmp/arc root/a b.go") captured)
    (cl-letf (((symbol-function 'vc-arc-root) (lambda (_) "/tmp/arc root/"))
              ((symbol-function 'vc-do-command)
               (lambda (&rest args) (setq captured (cons default-directory args)))))
      (vc-arc-diff (list file) nil nil "*test-diff*" t)
      (should (equal (car captured) "/tmp/arc root/"))
      (should (eq (nth 2 captured) 'async))
      (should (equal (nth 4 captured) (list file)))
      (should (equal (last captured 2) '("HEAD" "--"))))))

(ert-deftest my-arc-root-excludes-remote-and-non-arc-files ()
  (should-not (vc-arc-root "/ssh:example:/src/file.go"))
  (should-not (vc-arc-root "/private/tmp/not-in-arc.go")))

(ert-deftest my-arc-detection-skips-user-settings-and-nested-git ()
  (let* ((root (file-name-as-directory (make-temp-file "arc-detection-" t)))
         (mount (expand-file-name "mount/" root))
         (git (expand-file-name "nested-git/" mount))
         (plain (expand-file-name "config.el" root))
         (file (expand-file-name "tracked.txt" git)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".arc" root))
          (make-directory (expand-file-name ".arc" mount) t)
          (with-temp-file (expand-file-name ".arc/HEAD" mount) (insert "test-head\n"))
          (make-directory git)
          (let ((default-directory git))
            (should (zerop (call-process "git" nil nil nil "init" "--quiet")))
            (with-temp-file file (insert "tracked\n"))
            (should (zerop (call-process "git" nil nil nil "add" "tracked.txt"))))
          (cl-letf (((symbol-function 'vc-arc--output)
                     (lambda (&rest _) (ert-fail "Arc must not run here"))))
            (should-not (vc-arc-root plain))
            (should-not (vc-backend plain))
            (should (equal (vc-arc-root (expand-file-name "file.txt" mount)) mount))
            (should-not (vc-arc-root file))
            (should (eq (vc-backend file) 'Git))
            ;; Recover an open buffer from the old false Arc classification.
            (vc-file-setprop file 'vc-backend 'Arc)
            (vc-file-setprop file 'vc-arc-registration-error "Not mounted")
            (vc-file-setprop file 'vc-arc-registration-retry-at (+ (float-time) 60))
            (should (vc-registered file))
            (should (eq (vc-backend file) 'Git))
            (should-not (vc-file-getprop file 'vc-arc-registration-error))
            ;; Git worktrees/submodules have a .git file instead of a directory.
            (delete-directory (expand-file-name ".git" git) t)
            (with-temp-file (expand-file-name ".git" git) (insert "gitdir: /elsewhere\n"))
            (should-not (vc-arc-root file))))
      (vc-file-clearprops plain)
      (vc-file-clearprops file)
      (delete-directory root t))))

(ert-deftest my-arc-reload-updates-an-already-loaded-backend ()
  (let ((original (symbol-function 'vc-arc-responsible-p)))
    (unwind-protect
        (progn
          (fmakunbound 'vc-arc-responsible-p)
          (load (expand-file-name "arcadia.el" my-arc-test-config-dir) nil t)
          (should (fboundp 'vc-arc-responsible-p)))
      (fset 'vc-arc-responsible-p original))))

(ert-deftest my-line-numbers-stay-out-of-directory-panels ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/example.txt")
    (text-mode)
    (my-code-gutter-setup)
    (should display-line-numbers-mode))
  (with-temp-buffer
    (special-mode)
    (my-code-gutter-setup)
    (should-not display-line-numbers-mode)))

(ert-deftest my-vcs-status-detects-arc-git-and-plain-contexts ()
  (let* ((root (file-name-as-directory (file-truename (make-temp-file "vcs-status-" t))))
         (arc-root (expand-file-name "arc/" root))
         (git-root (expand-file-name "arc/nested-git/" root))
         (plain-root (expand-file-name "plain/" root))
         (arcit--mount-path-alist '((nil . "/wrong-mount/")))
         (status-buffer (generate-new-buffer " *test-arc-status*")))
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".arc" arc-root) t)
          (with-temp-file (expand-file-name ".arc/HEAD" arc-root) (insert "test-head\n"))
          (make-directory git-root t)
          (make-directory plain-root t)
          (let ((default-directory git-root))
            (should (zerop (call-process "git" nil nil nil "init" "--quiet"))))
          (save-window-excursion
            (dolist (context (list arc-root git-root plain-root))
              ;; File buffers, Dired and Treemacs all provide a directory context.
              (dolist (mode '(text-mode dired-mode treemacs-mode))
                (with-temp-buffer
                  (setq major-mode mode default-directory context)
                  (when (eq mode 'text-mode)
                    (setq buffer-file-name (expand-file-name "untracked.txt" context)))
                  (let (called)
                    (cl-letf (((symbol-function 'vc-arc--output)
                               (lambda (&rest _) (ert-fail "Status detection must not run Arc")))
                              ((symbol-function 'arcit-status)
                               (lambda () (interactive)
                                 (setq called (list 'Arc (arcit-mount-path)))
                                 (switch-to-buffer status-buffer)))
                              ((symbol-function 'vc-dir)
                               (lambda (directory &optional backend)
                                 (setq called (list backend directory)))))
                      (if (equal context plain-root)
                          (progn
                            (should-error (call-interactively (key-binding (kbd "C-c v")))
                                          :type 'user-error)
                            (should-not called))
                        (call-interactively (key-binding (kbd "C-c v")))
                        (should (equal called (list (if (equal context arc-root) 'Arc 'Git)
                                                    context))))))))))
          (with-current-buffer status-buffer
            (should (local-variable-p 'arcit--mount-path-alist))
            (should (equal (arcit-mount-path) arc-root))))
      (kill-buffer status-buffer)
      (delete-directory root t))))
