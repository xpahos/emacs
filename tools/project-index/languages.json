{
  "version": 1,
  "languages": {
    "go": {"globs": ["*.go"], "query": "go.scm",
           "grammar": {"requirement": "tree-sitter-go==0.25.0", "module": "tree_sitter_go"}},
    "c": {"globs": ["*.c", "*.h"], "query": "c.scm",
          "grammar": {"requirement": "tree-sitter-c==0.24.2", "module": "tree_sitter_c"}},
    "cpp": {"globs": ["*.cc", "*.cpp", "*.cxx", "*.c++", "*.hh", "*.hpp", "*.hxx", "*.h++", "*.ipp", "*.tpp"],
            "query": "cpp.scm",
            "grammar": {"requirement": "tree-sitter-cpp==0.23.4", "module": "tree_sitter_cpp"}},
    "java": {"globs": ["*.java"], "query": "java.scm",
             "grammar": {"requirement": "tree-sitter-java==0.23.5", "module": "tree_sitter_java"}},
    "kotlin": {"globs": ["*.kt", "*.kts"], "query": "kotlin.scm",
               "grammar": {"requirement": "tree-sitter-kotlin==1.1.0", "module": "tree_sitter_kotlin"}},
    "proto": {"globs": ["*.proto"], "query": "proto.scm",
              "grammar": {"requirement": "tree-sitter-language-pack==0.13.0",
                          "file": "tree_sitter_language_pack/bindings/proto.abi3.so", "module": "proto"}},
    "rust": {"globs": ["*.rs"], "query": "rust.scm",
             "grammar": {"requirement": "tree-sitter-rust==0.24.2", "module": "tree_sitter_rust"}},
    "python": {"globs": ["*.py", "*.pyi"], "shebangs": ["python", "python3"], "query": "python.scm",
               "grammar": {"requirement": "tree-sitter-python==0.25.0", "module": "tree_sitter_python"}}
  }
}
