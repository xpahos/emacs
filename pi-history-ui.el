;;; pi-history-ui.el --- Project chat picker -*- lexical-binding: t; -*-
(require 'button)
(defvar my-pi-history-frame nil)
(defvar my-pi-history-timer nil)
(defvar my-pi-history-process nil)
(defvar-local my-pi-picker-root nil)
(defvar-local my-pi-picker-window nil)
(defvar-local my-pi-picker-query "")
(defvar-local my-pi-picker-input-start nil)
(defvar-local my-pi-picker-input-end nil)
(defface my-pi-search-field
  '((t (:background "#898880" :box (:line-width 1 :color "#898880"))))
  "Subtle outline around the chat search field."
  :group 'faces)
(defface my-pi-history-date
  '((t (:foreground "#642d3b")))
  "Dark burgundy dates in the chat picker."
  :group 'faces)
(defface my-pi-history-branch
  '((t (:foreground "#173568")))
  "Blue working-copy branch labels in the chat picker."
  :group 'faces)
(defvar-local my-pi-picker-generation 0)
(defvar-local my-pi-picker-results nil)
(defvar-local my-pi-picker-offset 0)
(defvar-local my-pi-picker-error nil)
(defvar-local my-pi-picker-matches (make-hash-table :test #'equal))
(defvar my-pi-history-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map text-mode-map)
    (define-key map (kbd "ESC") #'my-pi-history-close)
    (define-key map (kbd "C-g") #'my-pi-history-close)
    (define-key map (kbd "RET") #'my-pi-picker-enter)
    (define-key map (kbd "TAB") #'forward-button)
    (define-key map (kbd "<backtab>") #'backward-button)
    (define-key map (kbd "C-s") #'my-pi-picker-focus-search)
    (define-key map (kbd "<down>") #'forward-button)
    (define-key map (kbd "<up>") #'backward-button)
    map))
(define-key my-pi-history-mode-map [header-line down-mouse-1] #'mouse-drag-header-line)
(define-derived-mode my-pi-history-mode text-mode "Chats"
  (setq-local tab-line-format nil
              header-line-format '(" Chats · Drag to move") truncate-lines t
              cursor-type 'bar mode-line-format '(" Search chats · Enter Open · Esc Close"))
  (add-hook 'before-change-functions #'my-pi-picker-before-change nil t)
  (add-hook 'after-change-functions #'my-pi-picker-changed nil t))
(defun my-pi-picker-before-change (start end)
  (unless (and my-pi-picker-input-start my-pi-picker-input-end
               (>= start my-pi-picker-input-start) (<= end my-pi-picker-input-end))
    (user-error "Edit the search field; C-s returns to it")))

(defun my-pi-picker-save-geometry ()
  (when (frame-live-p my-pi-history-frame)
    (with-current-buffer (window-buffer (frame-root-window my-pi-history-frame))
      (let ((position (frame-position my-pi-history-frame)))
        (sqlite-execute (my-pi-history-open)
         "INSERT INTO projects(project_root,picker_width,picker_height,picker_left,picker_top) VALUES (?,?,?,?,?)
          ON CONFLICT(project_root) DO UPDATE SET picker_width=excluded.picker_width,picker_height=excluded.picker_height,
            picker_left=excluded.picker_left,picker_top=excluded.picker_top"
         (list my-pi-picker-root (frame-pixel-width my-pi-history-frame) (frame-pixel-height my-pi-history-frame)
               (car position) (cdr position)))))))
(add-hook 'kill-emacs-hook #'my-pi-picker-save-geometry)

(defun my-pi-history-close ()
  (interactive)
  (when (timerp my-pi-history-timer) (cancel-timer my-pi-history-timer))
  (my-pi-history-cancel my-pi-history-process)
  (when (frame-live-p my-pi-history-frame)
    (my-pi-picker-save-geometry)
    (let ((buffer (window-buffer (frame-root-window my-pi-history-frame))))
      (with-current-buffer buffer
        (let ((window my-pi-picker-window))
          (delete-frame my-pi-history-frame)
          (setq my-pi-history-frame nil)
          (when (window-live-p window) (select-frame-set-input-focus (window-frame window)) (select-window window)))))))
(defun my-pi-picker-focus-search () (interactive) (goto-char my-pi-picker-input-end))
(defun my-pi-picker-enter ()
  (interactive)
  (if (button-at (point)) (push-button)
    (goto-char my-pi-picker-input-end) (forward-button 1) (push-button)))
(defun my-pi-picker-changed (&rest _)
  (let ((query (buffer-substring-no-properties my-pi-picker-input-start my-pi-picker-input-end)))
    (unless (equal query my-pi-picker-query)
      (setq my-pi-picker-query query my-pi-picker-offset 0)
      (when (timerp my-pi-history-timer) (cancel-timer my-pi-history-timer))
      (my-pi-history-cancel my-pi-history-process)
      (cl-incf my-pi-picker-generation)
      (setq my-pi-history-timer (run-with-timer 0.2 nil #'my-pi-picker-fetch (current-buffer))))))
(defun my-pi-picker-fetch (buffer)
  (when (and (buffer-live-p buffer) (frame-live-p my-pi-history-frame))
    (with-current-buffer buffer
      (let ((generation (cl-incf my-pi-picker-generation)) (offset my-pi-picker-offset))
        (setq my-pi-history-process
          (my-pi-history-search my-pi-picker-root my-pi-picker-query
            (lambda (result)
              (when (and (buffer-live-p buffer) (frame-live-p my-pi-history-frame))
                (with-current-buffer buffer
                  (when (= generation my-pi-picker-generation)
                    (setq my-pi-picker-error (or (plist-get result :error) (car (plist-get result :warnings))))
                    (unless (plist-get result :error)
                      (setq my-pi-picker-results (if (> offset 0) (append my-pi-picker-results (plist-get result :chats))
                                                  (plist-get result :chats))))
                    (my-pi-picker-render))))) offset))))))

(defun my-pi-picker-group (chat)
  (cond ((plist-get chat :unread) "Unread")
        ((member (plist-get chat :turn_state) '("running" "needs-input")) "Running") (t "History")))
(defun my-pi-picker-status (chat)
  (let ((state (plist-get chat :turn_state)))
    (string-join (delq nil (list (when (plist-get chat :unread) "Unread")
      (pcase state ("running" "Running") ("needs-input" "Needs input") ("error" "Error")
             ("interrupted" "Interrupted") (_ nil))
      (when (= (or (plist-get chat :deleting) 0) 1) "Delete failed — retry"))) " · ")))
(defun my-pi-picker-copy-label (chat)
  "Name CHAT's working copy and distinguish its role, including the current copy."
  (if-let* (((fboundp 'my-wt-copy-at))
            (copy (my-wt-copy-at (plist-get chat :project_root))))
      (let ((original (equal (plist-get copy :role) "original")))
        (propertize (format "  [%s %s%s]" (if original "⌂" "⧉") (my-wt-label copy)
                            (if (equal (plist-get copy :state) "deleted") ", deleted" ""))
                    'face 'my-pi-history-branch
                    'help-echo (format "%s\n%s" (if original "Original" "Working copy")
                                       (plist-get copy :directory))))
    ""))
(defun my-pi-picker-open (id &optional message-id)
  (let ((root my-pi-picker-root))
    (my-pi-history-close)
    (my-pi-open-chat root id message-id)))
(defun my-pi-picker-highlight (text)
  (let ((start 0) (clean ""))
    (while (string-match "\1\\([^\2]*\\)\2" text start)
      (setq clean (concat clean (substring text start (match-beginning 0))
                          (propertize (match-string 1 text) 'face 'xref-match)) start (match-end 0)))
    (concat clean (substring text start))))
(defun my-pi-picker-render ()
  (let* ((inhibit-read-only t) (inhibit-modification-hooks t)
         (offset (and my-pi-picker-input-start my-pi-picker-input-end
                      (<= my-pi-picker-input-start (point) my-pi-picker-input-end)
                      (- (point) my-pi-picker-input-start)))
         (selected (get-text-property (point) 'pi-chat-id)) (query my-pi-picker-query) group)
    (erase-buffer)
    (insert (propertize "\n" 'line-height 0.4 'read-only t 'rear-nonsticky t))
    (let ((start (point)) input-start input-end)
      (insert (propertize " Search: " 'read-only t 'rear-nonsticky '(read-only)))
      (setq input-start (point))
      (insert query)
      (setq input-end (point))
      (insert (propertize " " 'display '(space :align-to (- right-fringe 1))
                          'read-only t 'rear-nonsticky t))
      (add-text-properties start (point) '(face my-pi-search-field))
      (insert (propertize "\n" 'line-height 1.25 'read-only t) "\n")
      (setq my-pi-picker-input-start (copy-marker input-start)
            my-pi-picker-input-end (copy-marker input-end t)))
    (when my-pi-picker-error (insert (propertize (concat my-pi-picker-error "\n\n") 'face 'error 'read-only t)))
    (dolist (chat my-pi-picker-results)
      (let* ((id (plist-get chat :id)) (matches (plist-get chat :matches))
             (match-index (or (gethash id my-pi-picker-matches) 0))
             (match (nth (mod match-index (max 1 (length matches))) matches))
             (start (point)) (next-group (if (string-blank-p query) (my-pi-picker-group chat) "Results")))
        (unless (equal group next-group)
          (setq group next-group)
          (insert (propertize "\n" 'line-height 0.6))
          (insert (propertize (concat "  " group "\n") 'face 'bold))
          (insert (propertize "\n" 'line-height 0.6)))
        (insert "  ")
        (insert-text-button (string-join
                             (split-string (or (plist-get chat :title) "New chat") "[[:space:]]+" t)
                             " ")
          'follow-link t 'face 'default 'action (lambda (_) (my-pi-picker-open id (plist-get match :message-id))))
        (insert "  ")
        (insert-text-button "×" 'follow-link t 'help-echo "Delete chat" 'face 'shadow
          'action (lambda (_) (my-pi-history-confirm-delete my-pi-picker-root (list id))))
        (insert "\n    " (propertize (my-pi-picker-status chat) 'face (if (plist-get chat :unread) 'success 'shadow))
                (my-pi-picker-copy-label chat)
                "  " (propertize (or (plist-get chat :last_reply_at) (plist-get chat :created_at) "")
                                  'face 'my-pi-history-date) "\n")
        (when match
          (insert "    " (my-pi-picker-highlight (replace-regexp-in-string "[\n\r]" " " (plist-get match :snippet))) "\n")
          (when (> (length matches) 1)
            (insert "    ")
            (insert-text-button (format "Match %d/%d · Next" (1+ (mod match-index (length matches))) (length matches))
             'follow-link t 'face 'shadow 'action
             (lambda (_) (puthash id (1+ match-index) my-pi-picker-matches) (my-pi-picker-render)))
            (insert "\n")))
        (insert "\n")
        (add-text-properties start (point) (list 'read-only t 'pi-chat-id id))))
    (unless my-pi-picker-results
      (insert (propertize (if (string-blank-p query) "No chats yet\n" "No matches\n") 'read-only t))
      (when (string-blank-p query)
        (insert-text-button "New chat" 'action (lambda (_) (let ((root my-pi-picker-root)) (my-pi-history-close) (my-pi-new-chat root))))))
    (when (and (not (string-blank-p query)) (>= (length my-pi-picker-results) (+ my-pi-picker-offset 50)))
      (insert-text-button "Load more" 'action (lambda (_) (cl-incf my-pi-picker-offset 50) (my-pi-picker-fetch (current-buffer)))))
    (cond (offset (goto-char (+ my-pi-picker-input-start (min offset (length query)))))
          (selected (goto-char (or (text-property-any (point-min) (point-max) 'pi-chat-id selected) (point-min))))
          (t (my-pi-picker-focus-search)))))

(defun my-pi-picker-set-size (frame width height)
  "Restore outer pixel dimensions without accumulating border and header sizes."
  (let ((frame-resize-pixelwise t))
    (set-frame-size frame
                    (- width (- (frame-pixel-width frame) (frame-text-width frame)))
                    (- height (- (frame-pixel-height frame) (frame-text-height frame))) t)))

(defun my-pi-picker-constrain (frame)
  "Keep the picker inside the editor, preserving its freely chosen position."
  (when (and (frame-live-p my-pi-history-frame)
             (or (eq frame my-pi-history-frame)
                 (eq frame (frame-parameter my-pi-history-frame 'parent-frame))))
    (setq frame my-pi-history-frame)
    (let* ((parent (frame-parent frame))
           (max-width (- (frame-pixel-width parent) 8))
           (max-height (- (frame-pixel-height parent) 8)))
      (when (or (> (frame-pixel-width frame) max-width) (> (frame-pixel-height frame) max-height))
        (my-pi-picker-set-size frame (min (frame-pixel-width frame) max-width) (min (frame-pixel-height frame) max-height)))
      (let* ((position (frame-position frame))
             (left (max 4 (min (car position) (- (frame-pixel-width parent) (frame-pixel-width frame) 4))))
             (top (max 4 (min (cdr position) (- (frame-pixel-height parent) (frame-pixel-height frame) 4)))))
        (unless (equal position (cons left top)) (set-frame-position frame left top))))))

(defun my-pi-history-show (root)
  (interactive (list (or my-pi-root (alist-get 'my-project-root (tab-bar--current-tab)) default-directory)))
  (when (frame-live-p my-pi-history-frame) (my-pi-history-close))
  (let* ((root (my-pi-history-root root))
         (window (cl-find-if (lambda (w) (and (window-parameter w 'my-pi-panel)
                            (equal root (buffer-local-value 'my-pi-root (window-buffer w))))) (window-list)))
         (buffer (get-buffer-create " *Pi chats*")))
    (unless window (user-error "Open the Pi panel first"))
    (unless (display-graphic-p) (user-error "Chat picker requires a graphical Emacs"))
    (with-current-buffer buffer
      (my-pi-history-mode)
      (setq my-pi-picker-root root my-pi-picker-window window my-pi-picker-query ""
            my-pi-picker-offset 0 my-pi-picker-error nil
            my-pi-picker-matches (make-hash-table :test #'equal)
            my-pi-picker-results (my-pi-history-list root))
      (my-pi-picker-render))
    (let* ((edges (window-inside-pixel-edges window))
           (parent (window-frame window))
           (saved (car (sqlite-select (my-pi-history-open) "SELECT picker_width,picker_height,picker_left,picker_top FROM projects WHERE project_root=?" (list root))))
           (width (min (or (car saved) 650) (- (frame-pixel-width parent) 8)))
           (height (min (or (cadr saved) 480) (- (frame-pixel-height parent) 8))))
      (setq my-pi-history-frame
        (make-frame `((parent-frame . ,(window-frame window)) (minibuffer . nil) (undecorated . t)
                      (visibility . nil) (no-accept-focus . nil) (no-other-frame . t)
                      (internal-border-width . 5) (drag-internal-border . t)
                      (drag-with-header-line . t)
                      (tab-bar-lines . 0) (tab-bar-lines-keep-state . t)
                      (menu-bar-lines . 0) (tool-bar-lines . 0) (vertical-scroll-bars . right)
                      (left . ,(or (nth 2 saved) (+ 4 (nth 0 edges))))
                      (top . ,(or (nth 3 saved) (+ 4 (nth 1 edges))))
                      (background-color . "#898880") (foreground-color . "#20211e"))))
      (set-window-buffer (frame-root-window my-pi-history-frame) buffer)
      (dolist (face '(header-line mode-line mode-line-inactive))
        (set-face-attribute face my-pi-history-frame :background "#898880" :foreground "#20211e" :box nil))
      (set-face-attribute 'internal-border my-pi-history-frame :background "#85847d")
      (redisplay t)
      (my-pi-picker-set-size my-pi-history-frame width height)
      (my-pi-picker-constrain my-pi-history-frame)
      (make-frame-visible my-pi-history-frame)
      (select-frame-set-input-focus my-pi-history-frame)
      (select-window (frame-root-window my-pi-history-frame))
      (my-pi-picker-focus-search)
      (my-pi-picker-fetch buffer))))
(add-hook 'window-size-change-functions #'my-pi-picker-constrain)

(defun my-pi-history-menu (root)
  (let ((choice (completing-read "Chats: " '("Search chats" "New chat" "Delete project history…") nil t)))
    (pcase choice
      ("Search chats" (my-pi-history-show root))
      ("New chat" (my-pi-new-chat root))
      (_ (my-pi-history-refresh root (lambda () (my-pi-history-confirm-delete root (mapcar (lambda (c) (plist-get c :id)) (my-pi-history-list root)) t)))))))
(defun my-pi-history-confirm-delete (root ids &optional all)
  (unless ids (user-error "No chats to delete"))
  (let* ((running (cl-count-if (lambda (id) (my-pi-live-p (gethash id my-pi-sessions))) ids))
         (prompt (if all
                     (format "Delete all %d chats in %s (%d active sessions will stop)? " (length ids) (file-name-nondirectory (directory-file-name root)) running)
                   (format "%s chat “%s”? " (if (> running 0) "Stop task and delete" "Delete")
                           (plist-get (my-pi-history-get (car ids)) :title)))))
    (when (yes-or-no-p prompt)
      (when (frame-live-p my-pi-history-frame) (my-pi-history-close))
      (my-pi-history-delete root ids))))
(provide 'my-pi-history-ui)

(defun my-pi-picker-status-changed ()
  (when (frame-live-p my-pi-history-frame)
    (with-current-buffer (window-buffer (frame-root-window my-pi-history-frame))
      (setq my-pi-picker-results
        (if (string-blank-p my-pi-picker-query) (my-pi-history-list my-pi-picker-root)
          (delq nil (mapcar (lambda (old)
            (when-let* ((chat (my-pi-history-get (plist-get old :id))))
              (plist-put chat :matches (plist-get old :matches)))) my-pi-picker-results))))
      (my-pi-picker-render))))
(add-hook 'my-pi-history-change-hook #'my-pi-picker-status-changed)
