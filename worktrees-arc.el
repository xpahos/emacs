;;; worktrees-arc.el --- Native Arc copies and publication checks -*- lexical-binding: t; -*-
;; Loaded by worktrees.el; the CLI is the authority for mounts and refs.

(defun my-wt-arc-remote-name (name tenant)
  (if (and name tenant (string-prefix-p (concat tenant "/") name))
      (substring name (1+ (length tenant))) name))

(defun my-wt-arc-user-ref-p (name)
  (and (stringp name) (string-match-p "\\`users/[^/[:space:]]+/[^[:space:]~^:?*\\]+\\'" name)
       (not (string-match-p "\\.\\.\\|//\\|/\\'\\|@{" name))))

(defun my-wt-arc-creation-action (report)
  (let ((local (plist-get report :local)) (remote (plist-get report :remote))
        (relation (plist-get report :relation)))
    (when (equal local "trunk") (user-error "Creating a copy from trunk is not supported; select a branch"))
    (unless (my-wt-arc-user-ref-p remote)
      (user-error "Only server branches users/<login>/<branch> are supported (not %s)" remote))
    (cond
     ((plist-get report :server-selection) 'checkout)
     ((not local) (user-error "Select an existing branch, not a detached HEAD"))
     ((eq relation 'equal) (if (plist-get report :unbound) 'bind 'checkout))
     ((and (memq relation '(ahead unpublished)) (plist-get report :owned-remote)
           (or (eq relation 'unpublished) (not (plist-get report :unbound)))) 'publish)
     (t (user-error "%s vs %s: %s (+%s/-%s). Resolve it, or explicitly select the server branch; no force-push was made"
                    local remote relation (or (plist-get report :ahead) "?") (or (plist-get report :behind) "?"))))))

(defun my-wt-arc-list (text)
  "Parse a branch list, rejecting unknown output instead of treating it as empty."
  (unless (string-prefix-p "[" (string-trim-left (my-wt-clean-error text)))
    (error "Invalid Arc branch list"))
  (let ((branches (my-wt-json text)))
    (dolist (b branches)
      (unless (and (stringp (plist-get b :name))
                   (my-wt-commit-id-p (plist-get (plist-get b :commit) :id)))
        (error "Invalid Arc branch entry")))
    branches))

(defun my-wt-arc-status (text)
  "Read structured changes and operation state, ignoring descriptive branch metadata."
  (let* ((value (my-wt-json text)) (branch (plist-get value :branch_info)))
    (unless (and (plist-member value :status) (plist-member value :branch_info))
      (error "Arc status/operation state is unknown"))
    (list :status (plist-get value :status)
          :operation (or (plist-get branch :sequencer) (plist-get branch :rebasing)
                         (plist-get branch :conflicts)))))

(defun my-wt-arc-fetch-step (root remote result)
  "Fetch REMOTE; RESULT receives t if present, nil only for a definite missing ref."
  (lambda (next)
    (my-wt-run root (my-wt-arc) (list "fetch" remote)
      (lambda (code out err)
        (condition-case failure
            (cond ((zerop code) (funcall result t) (funcall next))
                  ;; Arc fetch returns precisely this line for a missing exact ref.
                  ((and (= code 1) (string-empty-p (string-trim out))
                        (equal (string-trim (my-wt-clean-error err))
                               (format "error: can't fetch ref '%s'" remote)))
                   (funcall result nil) (funcall next))
                  (t (funcall next (format "Cannot fetch %s: %s" remote (my-wt-clean-error (concat out err))))))
          ((error quit) (funcall next (error-message-string failure))))))))

(defun my-wt-arc-ref-report (source spec callback)
  "Fetch the selected ref and deliver (REPORT ERROR), without push or checkout."
  (let* ((root (plist-get source :vcs_root)) (arc (my-wt-arc))
         (name (plist-get spec :branch)) report present)
    (my-wt-chain
     (list
      (my-wt-step root arc '("info" "--json")
        (lambda (out)
          (let ((info (my-wt-json out)))
            (unless (stringp (plist-get info :repository)) (error "Arc repository is unknown"))
            (setq report (list :source-id (plist-get source :copy_id) :source-root root
                               :tenant (plist-get info :repository) :login (plist-get info :user_login))) nil)))
      (my-wt-step root arc '("branch" "--list" "--all" "-vv" "--json")
        (lambda (out)
          (let* ((branches (my-wt-arc-list out))
                 (local (and (not (plist-get spec :remote))
                             (cl-find-if (lambda (b) (and (plist-get b :local) (equal (plist-get b :name) name))) branches)))
                 (tenant (plist-get report :tenant))
                 (login (plist-get report :login))
                 (remote (if (plist-get spec :remote) (my-wt-arc-remote-name name tenant)
                           (my-wt-arc-remote-name (plist-get local :remote) tenant))))
            (unless (or local (plist-get spec :remote)) (error "Local branch %s does not exist" name))
            (when (plist-get spec :remote)
              (setq local (cl-find-if (lambda (b) (and (plist-get b :local)
                                                       (equal (my-wt-arc-remote-name (plist-get b :remote) tenant) remote))) branches)))
            (unless remote
              (unless (and (stringp login) (string-match-p "\\`[[:alnum:]_.-]+\\'" login))
                (error "Arc login is unknown; cannot choose a publication target"))
              (setq remote (concat "users/" login "/" name))
              (setq report (plist-put report :unbound t)))
            (unless (or (plist-get spec :check-only) (my-wt-arc-user-ref-p remote))
              (error "Server namespace %s is not supported; use a local branch without that upstream" remote))
            (when (and (not (plist-get spec :check-only)) (equal name "trunk"))
              (error "Creating a copy from trunk is not supported"))
            (setq report (append report
                                 (list :local (plist-get local :name) :local-sha (plist-get (plist-get local :commit) :id)
                                       :remote remote :server-selection (plist-get spec :remote)
                                       :owned-remote (and login (string-prefix-p (concat "users/" login "/") remote))))) nil)))
      (my-wt-step root arc '("status" "--json" "--branch" "--no-ahead-behind" "--ignored" "--no-sync-status")
        (lambda (out)
          (let ((value (my-wt-arc-status out)))
            (setq report (plist-put report :dirty (plist-get value :status)))
            (when (or (plist-get value :operation) (file-exists-p (expand-file-name ".arc/bisect" root)))
              "Finish or abort the current Arc operation before creating a copy"))))
      (lambda (next)
        (funcall (my-wt-arc-fetch-step root (plist-get report :remote) (lambda (exists) (setq present exists))) next))
      (lambda (next)
        (if (not present)
            (progn (setq report (plist-put report :relation (if (plist-get report :unbound) 'unpublished 'remote-missing)))
                   (if (plist-get report :server-selection) (funcall next "Server branch does not exist") (funcall next)))
          (funcall
           (my-wt-step root arc (list "rev-parse" (concat (plist-get report :tenant) "/" (plist-get report :remote)))
             (lambda (out)
               (let ((sha (string-trim out)))
                 (unless (my-wt-commit-id-p sha) (error "Invalid remote commit"))
                 (setq report (plist-put report :remote-sha sha))) nil)) next)))
      (lambda (next)
        (cond ((not present) (funcall next))
              ((or (not (plist-get report :local)) (equal (plist-get report :local-sha) (plist-get report :remote-sha)))
               (setq report (append report '(:relation equal :ahead 0 :behind 0))) (funcall next))
              (t (funcall
                  (my-wt-step root arc (list "merge-base" "--json" (plist-get report :local-sha) (plist-get report :remote-sha))
                    (lambda (out)
                      (let* ((v (my-wt-json out)) (ahead (plist-get v :ahead)) (behind (plist-get v :behind)))
                        (unless (and (natnump ahead) (natnump behind)) (error "Arc comparison is unknown"))
                        (setq report (append report (list :ahead ahead :behind behind :relation
                                                         (cond ((and (> ahead 0) (> behind 0)) 'diverged)
                                                               ((> ahead 0) 'ahead) ((> behind 0) 'behind) (t 'equal)))))) nil)) next)))))
     (lambda (error) (funcall callback (unless error report) error)))))

(defun my-wt-arc-report-text (report)
  (format "%s → %s\nLocal: %s\nServer: %s\n%s (+%s/-%s)%s"
          (or (plist-get report :local) "Server checkout") (plist-get report :remote)
          (or (plist-get report :local-sha) "—") (or (plist-get report :remote-sha) "missing")
          (plist-get report :relation) (or (plist-get report :ahead) "?") (or (plist-get report :behind) "?")
          (if (plist-get report :dirty) "\nUncommitted files stay in the source copy." "")))

(provide 'worktrees-arc)

(defun my-wt-arc-prepare (source spec callback)
  (my-wt-arc-ref-report source spec
    (lambda (report error)
      (let (plan)
        (unless error
          (condition-case failure
              (setq plan (list :spec spec :report report :action (my-wt-arc-creation-action report)
                               :source-id (plist-get source :copy_id) :source-root (plist-get source :vcs_root)
                               :local (plist-get report :local) :remote (plist-get report :remote)
                               :sha (if (plist-get report :server-selection) (plist-get report :remote-sha)
                                      (plist-get report :local-sha))))
            ((error quit) (setq error (concat (my-wt-arc-report-text report) "\n" (error-message-string failure))))))
        (funcall callback plan error)))))

(defun my-wt-arc-start (source plan callback)
  "Revalidate the approved PLAN, publish if needed, then create. CALLBACK gets (COPY ERROR)."
  (let ((key (plist-get source :copy_id)))
    (when (gethash key my-wt-busy) (user-error "This source already has an operation running"))
    (puthash key t my-wt-busy)
    (my-wt-arc-prepare source (plist-get plan :spec)
      (lambda (fresh error)
        (cond
         ((or error (not (equal (plist-get fresh :report) (plist-get plan :report))))
          (remhash key my-wt-busy)
          (funcall callback nil (or error "Branch state changed; refresh the preview before continuing")))
         (t
          (let* ((root (plist-get source :vcs_root)) (arc (my-wt-arc))
                 (remote (plist-get plan :remote)) (local (plist-get plan :local))
                 (sha (plist-get plan :sha)) (action (plist-get plan :action))
                 (report (plist-get plan :report)))
            (my-wt-chain
             (append
              (when (eq action 'publish)
                (list (my-wt-step root arc (list "rev-parse" local)
                        (lambda (out) (unless (equal (string-trim out) sha) "Source branch changed before push")))
                      (my-wt-step root arc (list "push" (concat sha ":" remote)))))
              (list (my-wt-step root arc (list "fetch" remote))
                    (my-wt-step root arc (list "rev-parse" (concat (plist-get report :tenant) "/" remote))
                      (lambda (out) (unless (equal sha (string-trim out)) "Server branch changed; publication/checkout was not continued"))))
              (when (memq action '(publish bind))
                (list (my-wt-step root arc (list "branch" "--set-upstream-to" remote local)))))
             (lambda (failure)
               (remhash key my-wt-busy)
               (if failure (funcall callback nil failure)
                 (condition-case err
                     (my-wt-create source
                                   (list :branch remote :local remote :remote-ref remote :sha sha :arc-verified t)
                                   (lambda (copy) (funcall callback copy (plist-get copy :error))))
                   ((error quit) (funcall callback nil (error-message-string err))))))))))))))

(defun my-wt-arc-store-error (copy entries)
  "Reject an unexpected store or any layout that could erase another copy."
  (let* ((root (plist-get copy :vcs_root)) (mine (my-wt-mount-entry entries root))
         (store (plist-get mine :store)) (objects (plist-get mine :object-store)))
    (cond
     ((not mine) "Arc does not list this worktree")
     ((or (not store) (not objects)) "Arc store layout is unknown")
     ((not (equal (my-wt-dir store) (my-wt-dir (or (plist-get copy :arc_store) "/")))) "The worktree store differs from its recorded store")
     ((and (plist-get copy :arc_object_store)
           (not (equal (my-wt-dir objects) (my-wt-dir (plist-get copy :arc_object_store))))) "The worktree ObjectStore changed")
     ((and (plist-get copy :arc_repository)
           (not (equal (plist-get copy :arc_repository) (plist-get mine :tenant)))) "The worktree tenant changed")
     ((cl-some
       (lambda (entry)
         (and (not (equal (my-wt-dir root) (my-wt-dir (plist-get entry :mount))))
              (cl-some (lambda (path) (and path (string-prefix-p (my-wt-dir store) (my-wt-dir path))))
                       (list (plist-get entry :store) (plist-get entry :mount) (plist-get entry :object-store))))) entries)
      "Removing this store could erase another working copy or its ObjectStore"))))

(defun my-wt-arc-clean-step (root)
  (my-wt-step root (my-wt-arc) '("status" "--json" "--branch" "--no-ahead-behind" "--ignored" "--no-sync-status")
    (lambda (out)
      (let ((value (my-wt-arc-status out)))
        (when (or (file-exists-p (expand-file-name ".arc/bisect" root))
                  (cl-loop for (_key val) on value by #'cddr thereis val))
          "The copy has changed, untracked or ignored files, or an unfinished operation")))))

(defun my-wt-arc-steps (source copy plan)
  (let* ((root (directory-file-name (plist-get copy :vcs_root))) (arc (my-wt-arc))
         (base user-emacs-directory) (id (plist-get copy :copy_id))
         (remote (plist-get copy :arc_remote_ref)) (sha (plist-get plan :sha))
         (original (my-wt-original (plist-get copy :project_id))) entries new checkout-local)
    (list
     (lambda (next) (funcall next (unless (and (my-wt-arc-user-ref-p remote) (my-wt-commit-id-p sha))
                                  "This older copy has no verified server target; select its server branch again")))
     (my-wt-step base arc '("worktree" "list" "--json" "--no-status")
       (lambda (out) (setq entries (my-wt-json out))
         (unless (my-wt-mount-entry entries (plist-get source :vcs_root)) "Source mount is not registered")))
     (lambda (next)
       (let* ((orig (my-wt-mount-entry entries (plist-get original :vcs_root)))
              (tenant (plist-get orig :tenant)) (objects (plist-get orig :object-store))
              (mine (my-wt-mount-entry entries root)))
         (cond
          ((or (not tenant) (not objects)) (funcall next "Original tenant/ObjectStore is unknown"))
          (mine
           (let ((error (my-wt-arc-store-error copy entries)))
             (cond (error (funcall next error))
                   ((equal (plist-get mine :status) "mounted") (funcall next))
                   ((equal (plist-get mine :status) "unmounted") (funcall (my-wt-step base arc (list "mount" root "--allow-other")) next))
                   (t (funcall next "The existing mount is broken")))))
          (t (setq new t)
             (let ((store (or (plist-get copy :arc_store)
                              (expand-file-name (concat "arc-stores/" id) (my-wt-base)))))
               ;; Persist identity before add: interrupted add/list must remain recoverable.
               (my-wt-update id :arc_repository tenant :arc_store store :arc_object_store objects)
               (make-directory (file-name-directory store) t)
               (funcall (my-wt-step base arc (list "worktree" "add" root "--" "--repository" tenant
                                                  "--store" store "--object-store" objects "--allow-other")) next))))))
     (my-wt-step base arc '("worktree" "list" "--json" "--no-status")
       (lambda (out)
         (setq entries (my-wt-json out))
         (let ((mine (my-wt-mount-entry entries root)))
           (or (my-wt-arc-store-error (my-wt-copy id) entries)
               (unless (equal (plist-get mine :status) "mounted") "The copy is not mounted")))))
     (my-wt-arc-clean-step root)
     (my-wt-step root arc '("stash" "list") (lambda (out) (unless (string-empty-p (string-trim out)) "The copy has stashes")))
     (my-wt-step root arc '("info" "--json")
       (lambda (out)
         (let ((info (my-wt-json out)))
           (unless (or new
                       (and (equal (plist-get info :branch) remote) (equal (plist-get info :hash) sha))
                       (and (equal (plist-get info :branch) "trunk")
                            (my-wt-commit-id-p (plist-get info :remote_head))
                            (equal (plist-get info :hash) (plist-get info :remote_head))))
             "The existing copy has an unexpected HEAD; it was left unchanged"))))
     (my-wt-step root arc '("branch" "--list" "--all" "-vv" "--json")
       (lambda (out)
         (let ((existing (cl-find-if (lambda (b) (and (plist-get b :local) (equal (plist-get b :name) remote)))
                                      (my-wt-arc-list out))))
           (when existing
             (unless (and (equal (plist-get (plist-get existing :commit) :id) sha)
                          (equal (my-wt-arc-remote-name (plist-get existing :remote)
                                                       (plist-get (my-wt-mount-entry entries root) :tenant)) remote))
               (error "Existing tracking branch differs; it was left unchanged"))
             (setq checkout-local t))) nil))
     (my-wt-step root arc (list "fetch" remote))
     (lambda (next)
       (funcall (my-wt-step root arc (list "rev-parse" (concat (plist-get (my-wt-mount-entry entries root) :tenant) "/" remote))
                  (lambda (out) (unless (equal sha (string-trim out)) "Server branch changed; refresh the selection"))) next))
     (lambda (next)
       (funcall (my-wt-step root arc (list "checkout" (if checkout-local remote (concat (plist-get (my-wt-mount-entry entries root) :tenant) "/" remote)))) next))
     (my-wt-step root arc '("info" "--json")
       (lambda (out)
         (let ((info (my-wt-json out)))
           (unless (and (equal (plist-get info :branch) remote) (equal (plist-get info :remote) remote)
                        (equal (plist-get info :hash) sha))
             "Checkout did not produce the expected branch, upstream and SHA; the copy was kept"))))
     (lambda (next)
       (funcall next (unless (file-directory-p (plist-get copy :directory))
                       "The project directory does not exist on the selected branch"))))))

(defun my-wt-arc-tag-step (root)
  (my-wt-step root (my-wt-arc) '("tag" "--list")
    (lambda (out) (unless (string-empty-p (string-trim out))
                    "The copy has local tags; preserve/remove them explicitly before deleting its store"))))

(defun my-wt-arc-delete-report (copy callback)
  "Prove that every local branch and HEAD survives removal of COPY's store."
  (let* ((root (plist-get copy :vcs_root)) (arc (my-wt-arc))
         entries info locals reports blockers status stash)
    (my-wt-chain
     (list
      (my-wt-step user-emacs-directory arc '("worktree" "list" "--json" "--no-status")
        (lambda (out) (setq entries (my-wt-json out)) (my-wt-arc-store-error copy entries)))
      (my-wt-step root arc '("info" "--json")
        (lambda (out) (setq info (my-wt-json out))
          (unless (my-wt-commit-id-p (plist-get info :hash)) "Current HEAD is unknown")))
      (my-wt-step root arc '("status" "--json" "--branch" "--no-ahead-behind" "--ignored" "--no-sync-status")
        (lambda (out)
          (setq status (my-wt-arc-status out))
          (when (or (file-exists-p (expand-file-name ".arc/bisect" root))
                    (cl-loop for (_key val) on status by #'cddr thereis val))
            (push "Changed, untracked or ignored files, or an unfinished operation" blockers)) nil))
      (my-wt-step root arc '("stash" "list")
        (lambda (out) (setq stash (string-trim out)) (unless (string-empty-p stash) (push "Local stashes" blockers)) nil))
      (lambda (next)
        (funcall (my-wt-arc-tag-step root)
                 (lambda (&optional error) (when error (push error blockers)) (funcall next))))
      (my-wt-step root arc '("branch" "--list" "--all" "-vv" "--json")
        (lambda (out)
          (setq locals (cl-remove-if-not (lambda (b) (plist-get b :local)) (my-wt-arc-list out)))
          (unless (or (not (plist-get info :branch))
                      (cl-find (plist-get info :branch) locals :key (lambda (b) (plist-get b :name)) :test #'equal))
            "Current branch is absent from Arc's branch list")))
      (lambda (next)
        (my-wt-chain
         (mapcar
          (lambda (b)
            (lambda (advance)
              (my-wt-arc-ref-report copy (list :branch (plist-get b :name) :check-only t)
                (lambda (report error)
                  (cond (error (funcall advance error))
                        ((not (equal (plist-get report :local-sha) (plist-get (plist-get b :commit) :id)))
                         (funcall advance "Local branches changed during the check"))
                        (t (push report reports)
                           (unless (and (not (plist-get report :unbound))
                                        (memq (plist-get report :relation) '(equal behind)))
                             (push (format "%s: %s; local commits are not proven reachable from its current server branch"
                                           (plist-get b :name) (plist-get report :relation)) blockers))
                           (funcall advance))))))) locals) next))
      (lambda (next)
        (if (cl-find (plist-get info :hash) reports :key (lambda (r) (plist-get r :local-sha)) :test #'equal)
            (funcall next)
          (if (not (my-wt-arc-user-ref-p (plist-get copy :arc_remote_ref)))
              (progn (push "Detached HEAD has no known server branch" blockers) (funcall next))
            (my-wt-arc-ref-report copy (list :branch (plist-get copy :arc_remote_ref) :remote t)
              (lambda (report error)
                (if error (funcall next error)
                  (push report reports)
                  (funcall (my-wt-step root arc (list "merge-base" (plist-get info :hash) (plist-get report :remote-sha))
                             (lambda (out)
                               (unless (equal (plist-get info :hash) (string-trim out))
                                 (push "Detached HEAD is not reachable from the server branch" blockers)) nil)) next)))))))
      (my-wt-step root arc '("branch" "--list" "--all" "-vv" "--json")
        (lambda (out)
          (unless (equal locals (cl-remove-if-not (lambda (b) (plist-get b :local)) (my-wt-arc-list out)))
            "Local branches changed during the check"))))
     (lambda (error)
       (funcall callback
                (unless error
                  (list :snapshot (list (plist-get info :branch) (plist-get info :hash)
                                        (let ((entry (my-wt-mount-entry entries root)))
                                          (mapcar (lambda (key) (plist-get entry key))
                                                  '(:mount :store :object-store :tenant :status :pid)))
                                        (mapcar (lambda (b) (list (plist-get b :name) (plist-get (plist-get b :commit) :id)
                                                                 (plist-get b :remote))) locals)
                                        status stash
                                        ;; Remote tips may advance while the user reads the preview.
                                        ;; Each report separately proves reachability against fresh tips.
                                        (mapcar (lambda (r) (list (plist-get r :local) (plist-get r :local-sha)
                                                                 (plist-get r :remote))) reports))
                        :branches (nreverse reports) :blockers (nreverse blockers))) error)))))

(defun my-wt-arc-delete-steps (copy &optional expected)
  (let ((root (directory-file-name (plist-get copy :vcs_root))) snapshot)
    (list
     (lambda (next)
       (my-wt-arc-delete-report copy
         (lambda (report error)
           (setq snapshot (plist-get report :snapshot))
           (funcall next (or error
                            (when (plist-get report :blockers) (string-join (plist-get report :blockers) "; "))
                            (when (and expected (not (equal expected snapshot))) "State changed since confirmation; check again"))))))
     (my-wt-release-step copy)
     (lambda (next)
       (my-wt-arc-delete-report copy
         (lambda (report error)
           (funcall next (or error (car (my-wt-delete-blockers copy t))
                            (when (plist-get report :blockers) (string-join (plist-get report :blockers) "; "))
                            (unless (equal snapshot (plist-get report :snapshot)) "State changed during resource release; copy kept"))))))
     (my-wt-step user-emacs-directory (my-wt-arc) (list "worktree" "remove" root))
     (my-wt-step user-emacs-directory (my-wt-arc) '("worktree" "list" "--json" "--no-status")
       (lambda (out)
         (setq my-wt-arc-mounts-cache nil)
         (when (my-wt-mount-entry (my-wt-json out) root) "Arc still registers the removed copy; inspect it before retrying"))))))

(defun my-wt-arc-reconcile-deletion (copy)
  "Only a successful native registry read can confirm an interrupted removal."
  (let ((id (plist-get copy :copy_id)))
    (condition-case failure
        (pcase (my-wt-call user-emacs-directory (my-wt-arc) "worktree" "list" "--json" "--no-status")
          (`(0 . ,out)
           (unless (string-prefix-p "[" (string-trim-left (my-wt-clean-error out)))
             (error "Unknown registry response"))
           (let ((entry (my-wt-mount-entry (my-wt-json out) (plist-get copy :vcs_root))))
             (my-wt-update id :state (cond ((not entry) "deleted")
                                          ((and (equal (plist-get entry :status) "mounted")
                                                (equal (plist-get entry :store) (plist-get copy :arc_store))) "ready")
                                          (t "unavailable"))
                           :error (when entry "Deletion was interrupted; the registered copy was kept"))))
          (_ (error "Cannot read the native worktree registry")))
      (error (my-wt-update id :state "unavailable" :error (error-message-string failure))))))
