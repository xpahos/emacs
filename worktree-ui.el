;;; worktree-ui.el --- Floating working-copy picker -*- lexical-binding: t; -*-
;; A child frame with a copy list, branch search, header dragging and border resizing.
(require 'button)
(require 'cl-lib)

(defvar my-wt-picker-frame nil)
(defvar my-wt-picker-timer nil)
(defvar-local my-wt-picker-project nil)
(defvar-local my-wt-picker-window nil)
(defvar-local my-wt-picker-mode 'copies "Either `copies' or `branches'.")
(defvar-local my-wt-picker-query "")
(defvar-local my-wt-picker-input-start nil)
(defvar-local my-wt-picker-input-end nil)
(defvar-local my-wt-picker-branches nil)
(defvar-local my-wt-picker-generation 0)
(defvar-local my-wt-picker-error nil)
(defvar-local my-wt-picker-preview nil "Plist with :text :label :action for the current Arc operation.")
(defvar-local my-wt-picker-start nil "Source commit captured when branch selection began.")

(defface my-wt-search-field
  '((t (:background "#898880" :box (:line-width 1 :color "#898880"))))
  "Search field of the working-copy picker, matching the chat picker."
  :group 'faces)

(defvar my-wt-picker-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map text-mode-map)
    (define-key map [escape] #'my-wt-picker-close)
    (define-key map (kbd "ESC") #'my-wt-picker-close)
    (define-key map (kbd "C-g") #'my-wt-picker-close)
    (define-key map (kbd "RET") #'my-wt-picker-enter)
    (define-key map (kbd "TAB") #'forward-button)
    (define-key map (kbd "<backtab>") #'backward-button)
    (define-key map (kbd "<down>") #'forward-button)
    (define-key map (kbd "<up>") #'backward-button)
    (define-key map (kbd "C-s") #'my-wt-picker-focus-search)
    (define-key map [header-line down-mouse-1] #'mouse-drag-header-line)
    map))

(define-derived-mode my-wt-picker-mode text-mode "Copies"
  (setq-local tab-line-format nil truncate-lines t cursor-type 'bar
              header-line-format '(" Working copies · Drag to move")
              mode-line-format '(" Type to search · Enter Open · Esc Close"))
  (add-hook 'before-change-functions #'my-wt-picker-before-change nil t)
  (add-hook 'after-change-functions #'my-wt-picker-changed nil t))

(defun my-wt-picker-before-change (start end)
  (unless (and my-wt-picker-input-start (>= start my-wt-picker-input-start) (<= end my-wt-picker-input-end))
    (user-error (if (eq my-wt-picker-mode 'copies)
                    "Use Tab to select a copy; C-s searches branches"
                  "Edit the search field; C-s returns to it"))))

(defun my-wt-picker-changed (&rest _)
  (let ((query (buffer-substring-no-properties my-wt-picker-input-start my-wt-picker-input-end))
        (buffer (current-buffer)))
    (unless (equal query my-wt-picker-query)
      (setq my-wt-picker-query query)
      (when (timerp my-wt-picker-timer) (cancel-timer my-wt-picker-timer))
      ;; Typing bursts coalesce into one render.
      (setq my-wt-picker-timer
            (run-with-timer 0.08 nil (lambda () (when (buffer-live-p buffer)
                                                  (with-current-buffer buffer (my-wt-picker-render)))))))))

(defun my-wt-picker-focus-search ()
  (interactive)
  (if (eq my-wt-picker-mode 'branches) (goto-char my-wt-picker-input-end)
    (my-wt-picker-branch-mode)))
(defun my-wt-picker-enter ()
  (interactive)
  (if (button-at (point)) (push-button)
    (goto-char (or my-wt-picker-input-end (point-min)))
    (when (forward-button 1 nil nil t) (push-button))))

(defun my-wt-picker-source ()
  "The copy the picker was opened from: the tab's active copy."
  (my-wt-copy-at default-directory))

(defun my-wt-picker-button (label action &optional face help)
  (insert-text-button label 'follow-link t 'face (or face 'default) 'help-echo help
                      'action (lambda (_) (funcall action))))

(defun my-wt-picker-render ()
  (let* ((inhibit-read-only t) (inhibit-modification-hooks t)
         (offset (and my-wt-picker-input-start (<= my-wt-picker-input-start (point) my-wt-picker-input-end)
                      (- (point) my-wt-picker-input-start)))
         (query my-wt-picker-query))
    (erase-buffer)
    (setq my-wt-picker-input-start nil my-wt-picker-input-end nil
          mode-line-format (if (eq my-wt-picker-mode 'copies)
                               '(" Tab Select · Enter Open · C-s New copy · Esc Close")
                             '(" Type to search · Enter Open · Esc Close")))
    (insert (propertize "\n" 'line-height 0.4))
    (when (eq my-wt-picker-mode 'branches)
      (let ((start (point)) input-start input-end)
       (insert (propertize " Branch: " 'rear-nonsticky t))
       (setq input-start (point))
       (insert query)
       (setq input-end (point))
       (insert (propertize " " 'display '(space :align-to (- right-fringe 1)) 'rear-nonsticky t))
       (add-text-properties start (point) '(face my-wt-search-field))
       (insert (propertize "\n" 'line-height 1.25) "\n")
       (setq my-wt-picker-input-start (copy-marker input-start)
             my-wt-picker-input-end (copy-marker input-end t))))
    (when my-wt-picker-error (insert (propertize (concat "  " my-wt-picker-error "\n\n") 'face 'error)))
    (pcase my-wt-picker-mode
      ('copies (my-wt-picker-render-copies))
      ('preview (my-wt-picker-render-preview))
      (_ (my-wt-picker-render-branches query)))
    (if my-wt-picker-input-start
        (progn
          (put-text-property (point-min) my-wt-picker-input-start 'read-only t)
          (put-text-property my-wt-picker-input-end (point-max) 'read-only t)
          (goto-char (+ my-wt-picker-input-start (min (or offset (length query)) (length query)))))
      (put-text-property (point-min) (point-max) 'read-only t)
      (goto-char (point-min))
      (forward-button 1))))

(defun my-wt-picker-more (more)
  (when more (insert (propertize "  More matches — type more to narrow\n" 'face 'shadow))))

(defun my-wt-picker-render-copies ()
  (let* ((project my-wt-picker-project)
         (active (plist-get (my-wt-project project) :active))
         (copies (cl-remove-if (lambda (c) (equal (plist-get c :state) "deleted")) (my-wt-copies project))))
    (dolist (copy copies)
      (let* ((id (plist-get copy :copy_id)) (state (plist-get copy :state))
             (attention (my-wt-attention-text (my-wt-attention copy))))
        (insert (if (equal id active) "  ● " "    "))
        (my-wt-picker-button (my-wt-label copy) (lambda () (my-wt-picker-open copy))
                             (if (equal state "ready") 'default 'shadow) (plist-get copy :directory))
        (insert (propertize (concat "  " (string-join (delq nil (list (when (equal (plist-get copy :role) "original") "original")
                                                                     (unless (equal state "ready") state)
                                                                     (unless (string-empty-p attention) attention)))
                                                      " · "))
                            'face (if (string-empty-p attention) 'shadow 'warning)))
        (when (equal state "failed")
          (insert "  ") (my-wt-picker-button "Retry" (lambda () (my-wt-picker-retry copy)) 'link))
        (when (and (equal (plist-get copy :role) "copy") (equal (plist-get copy :owned) 1)
                   (member state '("ready" "failed" "unavailable")))
          (insert "  ") (my-wt-picker-button "Delete…" (lambda () (my-wt-picker-delete copy)) 'shadow "Delete this working copy"))
        (insert "\n")
        (when (plist-get copy :error)
          (insert (propertize (concat "      " (replace-regexp-in-string "\n" " " (plist-get copy :error)) "\n") 'face 'error)))))
    (insert "\n  ")
    (my-wt-picker-button "+ New working copy…" #'my-wt-picker-branch-mode 'link)
    (insert "\n")))

(defun my-wt-picker-render-branches (query)
  (let* ((source (my-wt-picker-source)) (start my-wt-picker-start)
         (found (and (listp my-wt-picker-branches) (my-wt-filter query my-wt-picker-branches #'car))))
    (insert (propertize (format "  From %s at %s\n\n" (my-wt-label source) (if start (substring start 0 (min 10 (length start))) "unknown"))
                        'face 'shadow))
    (cond ((eq my-wt-picker-branches 'loading) (insert (propertize "  Loading branches…\n" 'face 'shadow)))
          ((string-blank-p query) (insert (propertize "  Type to search branches\n" 'face 'shadow)))
          ((not (car found)) (insert (propertize "  No matching branches\n" 'face 'shadow))))
    (unless (eq my-wt-picker-branches 'loading)
      (dolist (branch (car found))
        (insert "  ")
        (my-wt-picker-button (car branch) (lambda () (my-wt-picker-create-existing branch)) 'default "Open this branch in a new copy")
        (insert "\n"))
      (my-wt-picker-more (cdr found)))
    (when (and (equal (plist-get source :vcs) "arc") (my-wt-arc-user-ref-p query))
      (insert "\n  ")
      (my-wt-picker-button (concat "Check server branch " query)
        (lambda () (my-wt-picker-create-existing (list query :remote t)))))
    (insert "\n  ")
    (my-wt-picker-button "Back" (lambda () (setq my-wt-picker-mode 'copies my-wt-picker-query "" my-wt-picker-error nil)
                                  (my-wt-picker-render)) 'shadow)
    (insert "\n")))

(defun my-wt-picker-branch-mode ()
  (let ((buffer (current-buffer)) (generation (cl-incf my-wt-picker-generation)))
    (setq my-wt-picker-mode 'branches my-wt-picker-query "" my-wt-picker-error nil my-wt-picker-branches 'loading
          my-wt-picker-start (ignore-errors (my-wt-resolve-start (my-wt-picker-source))))
    (my-wt-picker-render)
    (my-wt-branches (my-wt-picker-source)
      (lambda (result)
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            ;; A reopened selector or closed picker supersedes this listing.
            (when (and (= generation my-wt-picker-generation) (eq my-wt-picker-mode 'branches))
              (if (plist-get result :error)
                  (setq my-wt-picker-error (plist-get result :error) my-wt-picker-branches nil)
                (setq my-wt-picker-branches result))
              (my-wt-picker-render))))))))

(defun my-wt-picker-finish (copy)
  "Switch to a finished COPY unless the user has moved to another project."
  (when (and (equal (plist-get copy :state) "ready")
             (equal (plist-get (my-wt-tab-copy) :project_id) (plist-get copy :project_id)))
    (my-wt-switch copy)))

(defun my-wt-picker-create (spec)
  (let* ((source (my-wt-picker-source)) (result (my-wt-create source spec #'my-wt-picker-finish)))
    (if (plist-get result :occupied)
        (let ((copy (plist-get result :occupied)))
          (when (yes-or-no-p (format "%s is already checked out in working copy %s. Open it? "
                                     (plist-get spec :branch) (or (plist-get copy :tree_name) "original")))
            (my-wt-picker-close)
            (my-wt-switch copy)))
      (my-wt-picker-close)
      (message "Creating working copy %s…" (plist-get result :tree_name)))))

(defun my-wt-picker-create-existing (branch)
  (let* ((source (my-wt-picker-source))
         (spec (list :branch (car branch) :remote (plist-get (cdr branch) :remote)
                     :sha (plist-get (cdr branch) :sha))))
    (if (equal (plist-get source :vcs) "arc")
        (my-wt-picker-arc-create source spec)
      (my-wt-picker-create spec))))

(defun my-wt-picker-open (copy)
  (my-wt-picker-close)
  (my-wt-switch copy))

(defun my-wt-picker-retry (copy)
  (my-wt-picker-close)
  (my-wt-retry copy #'my-wt-picker-finish))

(defun my-wt-picker-delete (copy)
  (if-let* ((blockers (my-wt-delete-blockers copy)))
      (progn (setq my-wt-picker-error (string-join blockers "; ")) (my-wt-picker-render))
    (if (equal (plist-get copy :vcs) "arc")
        (my-wt-picker-arc-delete copy)
      (when (yes-or-no-p (format "Delete working copy %s (%s)? Its branch and chats are kept. "
                                (plist-get copy :tree_name) (my-wt-label copy)))
        (my-wt-picker-close)
        (my-wt-delete copy)))))

(defun my-wt-picker-render-preview ()
  (insert "  " (or (plist-get my-wt-picker-preview :text) "Checking server state…") "\n\n  ")
  (when-let* ((action (plist-get my-wt-picker-preview :action)))
    (my-wt-picker-button (plist-get my-wt-picker-preview :label)
      (lambda ()
        (setq my-wt-picker-preview '(:text "Working…"))
        (my-wt-picker-render)
        (funcall action)) 'default "Confirm this operation")
    (insert "\n\n  "))
  (my-wt-picker-button "Back"
    (lambda ()
      (cl-incf my-wt-picker-generation)
      (setq my-wt-picker-mode 'copies my-wt-picker-preview nil my-wt-picker-error nil)
      (my-wt-picker-render)) 'shadow))

(defun my-wt-picker-preview-update (buffer generation text &optional label action)
  (when (buffer-live-p buffer)
    (with-current-buffer buffer
      (when (and (= generation my-wt-picker-generation) (eq my-wt-picker-mode 'preview))
        (setq my-wt-picker-preview (list :text text :label label :action action))
        (my-wt-picker-render)))))

(defun my-wt-picker-arc-create (source spec)
  (let ((buffer (current-buffer)) (generation (cl-incf my-wt-picker-generation)))
    (setq my-wt-picker-mode 'preview my-wt-picker-preview nil my-wt-picker-error nil)
    (my-wt-picker-render)
    (my-wt-arc-prepare source spec
      (lambda (plan error)
        (my-wt-picker-preview-update buffer generation
          (or error (concat (my-wt-arc-report-text (plist-get plan :report))
                            "\n\nOnly committed files are copied."
                            (when (eq (plist-get plan :action) 'publish) "\nThis will publish the selected commit to the server.")))
          (unless error (if (eq (plist-get plan :action) 'publish) "Publish and create" "Create worktree"))
          (unless error
            (lambda ()
              (my-wt-arc-start source plan
                (lambda (copy failure)
                  (if failure
                      (progn (message "%s" failure) (my-wt-picker-preview-update buffer generation failure))
                    (when (and (buffer-live-p buffer)
                               (= generation (buffer-local-value 'my-wt-picker-generation buffer)))
                      (my-wt-picker-close) (my-wt-picker-finish copy))))))))))))

(defun my-wt-picker-arc-delete (copy)
  (let ((buffer (current-buffer)) (generation (cl-incf my-wt-picker-generation)))
    (setq my-wt-picker-mode 'preview my-wt-picker-preview nil my-wt-picker-error nil)
    (my-wt-picker-render)
    (my-wt-arc-delete-report copy
      (lambda (report error)
        (let ((blockers (plist-get report :blockers)))
          (my-wt-picker-preview-update buffer generation
            (or error (concat (mapconcat #'my-wt-arc-report-text (plist-get report :branches) "\n\n")
                              "\n\nLocal copy and local branches will be removed. Server branches and chats are kept."
                              (when blockers (concat "\n\nCannot delete: " (string-join blockers "; ")))))
            (unless (or error blockers) "Delete worktree")
            (unless (or error blockers)
              (lambda ()
                ;; Release project resources from the parent frame, not the child picker.
                (my-wt-picker-close)
                (my-wt-delete copy
                  (lambda (failure) (when failure (message "Worktree kept: %s" failure)))
                  (plist-get report :snapshot))))))))))

(defun my-wt-picker-save-geometry ()
  (when (frame-live-p my-wt-picker-frame)
    (let ((position (frame-position my-wt-picker-frame))
          (project (buffer-local-value 'my-wt-picker-project (window-buffer (frame-root-window my-wt-picker-frame)))))
      (my-wt-write
       (lambda (db)
         (sqlite-execute db "UPDATE logical_projects SET picker_width=?,picker_height=?,picker_left=?,picker_top=? WHERE project_id=?"
                         (list (frame-pixel-width my-wt-picker-frame) (frame-pixel-height my-wt-picker-frame)
                               (car position) (cdr position) project)))))))
(add-hook 'kill-emacs-hook #'my-wt-picker-save-geometry)

(defun my-wt-picker-close ()
  (interactive)
  (when (timerp my-wt-picker-timer) (cancel-timer my-wt-picker-timer))
  (when (frame-live-p my-wt-picker-frame)
    (my-wt-picker-save-geometry)
    (let* ((buffer (window-buffer (frame-root-window my-wt-picker-frame)))
           (window (buffer-local-value 'my-wt-picker-window buffer)))
      (with-current-buffer buffer (cl-incf my-wt-picker-generation))
      (delete-frame my-wt-picker-frame)
      (setq my-wt-picker-frame nil)
      (when (window-live-p window) (select-frame-set-input-focus (window-frame window)) (select-window window)))))

(defun my-wt-picker-set-size (frame width height)
  "Set FRAME's outer pixel size without accumulating borders and header lines."
  (let ((frame-resize-pixelwise t))
    (set-frame-size frame (- width (- (frame-pixel-width frame) (frame-text-width frame)))
                    (- height (- (frame-pixel-height frame) (frame-text-height frame))) t)))

(defun my-wt-picker-constrain (frame)
  "Keep the picker within its parent frame when either one changes size."
  (when (and (frame-live-p my-wt-picker-frame)
             (memq frame (list my-wt-picker-frame (frame-parent my-wt-picker-frame))))
    (let* ((picker my-wt-picker-frame) (parent (frame-parent picker))
           (max-width (- (frame-pixel-width parent) 8)) (max-height (- (frame-pixel-height parent) 8)))
      (when (or (> (frame-pixel-width picker) max-width) (> (frame-pixel-height picker) max-height))
        (my-wt-picker-set-size picker (min (frame-pixel-width picker) max-width) (min (frame-pixel-height picker) max-height)))
      (let* ((position (frame-position picker))
             (left (max 4 (min (car position) (- (frame-pixel-width parent) (frame-pixel-width picker) 4))))
             (top (max 4 (min (cdr position) (- (frame-pixel-height parent) (frame-pixel-height picker) 4)))))
        (unless (equal position (cons left top)) (set-frame-position picker left top))))))
(add-hook 'window-size-change-functions #'my-wt-picker-constrain)

(defun my-wt-picker-show ()
  "Open the working-copy picker for the current project; no Pi panel is needed."
  (interactive)
  (when (frame-live-p my-wt-picker-frame) (my-wt-picker-close))
  (unless (display-graphic-p) (user-error "The working-copy picker requires a graphical Emacs"))
  (let* ((copy (or (my-wt-tab-copy) (user-error "Open a project first")))
         (project (my-wt-project (plist-get copy :project_id)))
         (window (or (seq-find (lambda (w) (not (window-parameter w 'window-side))) (window-list)) (selected-window)))
         (parent (window-frame window))
         (buffer (get-buffer-create " *Working copies*"))
         (width (min (or (plist-get project :width) 560) (- (frame-pixel-width parent) 8)))
         (height (min (or (plist-get project :height) 420) (- (frame-pixel-height parent) 8))))
    (my-wt-reconcile (plist-get copy :project_id))
    (dolist (c (my-wt-copies (plist-get copy :project_id)))
      (unless (equal (plist-get c :state) "deleted") (my-wt-refresh-branch c)))
    (with-current-buffer buffer
      (my-wt-picker-mode)
      (setq default-directory (plist-get copy :directory)
            my-wt-picker-project (plist-get copy :project_id) my-wt-picker-window window
            my-wt-picker-mode 'copies my-wt-picker-query "" my-wt-picker-error nil my-wt-picker-branches nil)
      (my-wt-picker-render))
    (setq my-wt-picker-frame
          (make-frame `((parent-frame . ,parent) (minibuffer . nil) (undecorated . t)
                        (visibility . nil) (no-accept-focus . nil) (no-other-frame . t)
                        (internal-border-width . 5) (drag-internal-border . t) (drag-with-header-line . t)
                        (tab-bar-lines . 0) (tab-bar-lines-keep-state . t)
                        (menu-bar-lines . 0) (tool-bar-lines . 0) (vertical-scroll-bars . right)
                        (background-color . "#898880") (foreground-color . "#20211e"))))
    (set-window-buffer (frame-root-window my-wt-picker-frame) buffer)
    (dolist (face '(header-line mode-line mode-line-inactive))
      (set-face-attribute face my-wt-picker-frame :background "#898880" :foreground "#20211e" :box nil))
    (set-face-attribute 'internal-border my-wt-picker-frame :background "#85847d")
    (redisplay t)
    (my-wt-picker-set-size my-wt-picker-frame width height)
    ;; Position after sizing: resizing a child frame can move its top edge.
    ;; First use is centred over the editor; later uses restore the saved place.
    (set-frame-position my-wt-picker-frame
                        (or (plist-get project :left) (max 4 (/ (- (frame-pixel-width parent) (frame-pixel-width my-wt-picker-frame)) 2)))
                        (or (plist-get project :top) (max 4 (/ (- (frame-pixel-height parent) (frame-pixel-height my-wt-picker-frame)) 2))))
    (my-wt-picker-constrain my-wt-picker-frame)
    (make-frame-visible my-wt-picker-frame)
    (select-frame-set-input-focus my-wt-picker-frame)
    (select-window (frame-root-window my-wt-picker-frame))
    (goto-char (point-min))
    (forward-button 1)
    my-wt-picker-frame))

(defun my-wt-picker-refresh ()
  (when (frame-live-p my-wt-picker-frame)
    (with-current-buffer (window-buffer (frame-root-window my-wt-picker-frame))
      (when (eq my-wt-picker-mode 'copies) (my-wt-picker-render)))))
(add-hook 'my-wt-change-hook #'my-wt-picker-refresh)

(global-set-key (kbd "C-c w") #'my-wt-picker-show)
(provide 'my-worktree-ui)
